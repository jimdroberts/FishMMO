<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FishMMO.CMS.Server</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FishMMO-Auth\FishMMO-ServerAuth\FishMMO-ServerAuth.csproj" />
    <ProjectReference Include="..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
  </ItemGroup>

  <!-- Copy-and-rename config from FishMMO-Setup/ to output. -->
  <Target Name="CopyFishMMOConfig" AfterTargets="Build">
    <Copy SourceFiles="..\..\FishMMO-Setup\Development\appsettings.CMS.json"
          DestinationFiles="$(OutDir)appsettings.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\FishMMO-Setup\Production\appsettings.CMS.json"
          DestinationFiles="$(OutDir)appsettings.Production.json"
          SkipUnchangedFiles="true"
          Condition="Exists('..\..\FishMMO-Setup\Production\appsettings.CMS.json')" />
  </Target>

</Project>