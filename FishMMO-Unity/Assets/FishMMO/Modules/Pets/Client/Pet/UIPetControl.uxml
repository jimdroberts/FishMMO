<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="/Assets/FishMMO/Client/GUI/FishMMO-Theme.uss" />
    <Style src="UIPetControl.uss" />
    <ui:VisualElement name="pet-root" class="fish-panel pet-panel">

        <ui:VisualElement name="panel-header" class="fish-panel__header pet-header">
            <ui:VisualElement class="fish-panel__icon pet-header__icon" />
            <ui:Label name="pet-name" text="Pet" class="fish-panel__title pet-name" />
            <ui:Label name="pet-status" text="" class="fish-badge pet-status" />
        </ui:VisualElement>

        <ui:VisualElement name="pet-body" class="pet-body">
            <!-- One row per pet (name and health bar), built by UITKPetControl; clicking a row pins that pet. -->
            <ui:VisualElement name="pet-list" class="pet-list" />

            <ui:VisualElement name="pet-commands" class="pet-commands">
                <ui:Button name="pet-attack" text="Attack" class="fish-button pet-cmd" />
                <ui:Button name="pet-follow" text="Follow" class="fish-button pet-cmd" />
                <ui:Button name="pet-stay" text="Stay" class="fish-button pet-cmd" />
                <ui:Button name="pet-summon" text="Summon" class="fish-button pet-cmd" />
                <ui:Button name="pet-release" text="Release" class="fish-button fish-button--danger pet-cmd" />
                <ui:Button name="pet-priority" text="Priority" class="fish-button pet-cmd" />
            </ui:VisualElement>

            <ui:VisualElement name="pet-priority-panel" class="pet-priority">
                <ui:Label text="Attack priority" class="fish-label fish-label--secondary pet-priority__title" />
                <ui:VisualElement name="pet-priority-row-0" class="pet-priority__row">
                    <ui:Label name="pet-priority-label-0" text="" class="fish-label pet-priority__label" />
                    <ui:Button name="pet-priority-up-0" text="" class="fish-button fish-button--ghost pet-priority__up"><ui:Label text="&lt;" picking-mode="Ignore" class="pet-priority__glyph pet-priority__glyph--up" /></ui:Button>
                    <ui:Button name="pet-priority-down-0" text="" class="fish-button fish-button--ghost pet-priority__up"><ui:Label text="&lt;" picking-mode="Ignore" class="pet-priority__glyph pet-priority__glyph--down" /></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="pet-priority-row-1" class="pet-priority__row">
                    <ui:Label name="pet-priority-label-1" text="" class="fish-label pet-priority__label" />
                    <ui:Button name="pet-priority-up-1" text="" class="fish-button fish-button--ghost pet-priority__up"><ui:Label text="&lt;" picking-mode="Ignore" class="pet-priority__glyph pet-priority__glyph--up" /></ui:Button>
                    <ui:Button name="pet-priority-down-1" text="" class="fish-button fish-button--ghost pet-priority__up"><ui:Label text="&lt;" picking-mode="Ignore" class="pet-priority__glyph pet-priority__glyph--down" /></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="pet-priority-row-2" class="pet-priority__row">
                    <ui:Label name="pet-priority-label-2" text="" class="fish-label pet-priority__label" />
                    <ui:Button name="pet-priority-up-2" text="" class="fish-button fish-button--ghost pet-priority__up"><ui:Label text="&lt;" picking-mode="Ignore" class="pet-priority__glyph pet-priority__glyph--up" /></ui:Button>
                    <ui:Button name="pet-priority-down-2" text="" class="fish-button fish-button--ghost pet-priority__up"><ui:Label text="&lt;" picking-mode="Ignore" class="pet-priority__glyph pet-priority__glyph--down" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pet-stances" class="pet-commands pet-stances">
                <ui:Button name="pet-stance-passive" text="Passive" class="fish-button pet-cmd pet-stance pet-stance--passive" />
                <ui:Button name="pet-stance-defensive" text="Defensive" class="fish-button pet-cmd pet-stance pet-stance--defensive" />
                <ui:Button name="pet-stance-aggressive" text="Aggressive" class="fish-button pet-cmd pet-stance pet-stance--aggressive" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
