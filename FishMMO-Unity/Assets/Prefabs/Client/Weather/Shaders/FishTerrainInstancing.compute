// GPU culling for the instanced terrain trees and details (TerrainGpuRenderer, FishMMO.Client/World/Terrain).
//
// Per camera, three kernels in order:
//   FishClearCounts   zero every slot's counter
//   FishCull          one thread per instance of the CPU's visible-chunk work items: draw-distance cull,
//                     distance thinning (grass: a hashed share of the instances, by world position so
//                     the same plants stay, falling with distance and dither-faded at its edge),
//                     LOD pick with the cross-fade band (the same rule as TerrainTreeMath.SelectLodFaded),
//                     camera-frustum test (main view) and sun-swept frustum test within the shadow distance
//                     (shadow view); appends {index, lodFade} into the slot (model, level, view)
//   FishFinalize      writes each indirect command's instanceCount = min(count, capacity)
//
// Where the draws go through a BatchRendererGroup (TerrainGpuRenderer.Brg.cs), FishCull also writes each entry as DOTS
// instancing reads it (_FishVisiblePacked), and FishDotsInstances keeps the resident instances' DOTS matrices beside the
// rows (unity_ObjectToWorld / unity_WorldToObject, column-major float3x4) after every upload.
//
// And, before them when instances changed, FishCopyInstances: copies a freshly created upload buffer into
// _FishInstances on the GPU. The CPU never writes the instance buffer itself while it is in use: on
// OpenGL (NVIDIA) a SetBufferData into the multi-MB buffer the previous frames' culling still reads
// stalled the frame 50-90 ms waiting for the GPU, every few chunk builds.
//
// A slot never overflows: an append past the slot's capacity is discarded (the atomic's return value is
// checked), and the command's count is clamped to the capacity. Capacity per level and view = the
// prototype's resident instances: an instance appears at most once per level per view, even inside a
// fade band (where it is in two different levels).
//
// Portable to Vulkan, D3D11/12, Metal and WebGPU: no wave intrinsics; atomics only on a
// RWByteAddressBuffer and on groupshared counters (appends are counted per thread group); no readbacks.

#pragma kernel FishClearCounts
#pragma kernel FishCull
#pragma kernel FishFinalize
#pragma kernel FishCopyInstances
#pragma kernel FishArgsFence
#pragma kernel FishHiZCopy
#pragma kernel FishHiZReduce
#pragma kernel FishDotsInstances
#pragma use_dxc vulkan

struct FishInstance { float4 row0; float4 row1; float4 row2; };            // 48 bytes
struct FishVisible { uint index; float lodFade; };                          // 8 bytes
struct FishModel                                                            // 80 bytes
{
    float4 transitions;
    float4 fadeWidths;
    float3 localReference;
    float size;
    float3 sphereCentre;
    float sphereRadius;
    uint levelCount;
    uint slotBase;
    uint shadowMask;
    uint padding;
};
struct FishWork { uint start; uint count; uint model; uint padding; float drawDistance; float lodBias; float thinStart; float thinKeep; }; // 32 bytes

// The share of the thinning band an instance fades across (dithered, so a plant thins out and back in
// without popping as the camera moves).
#define FISH_THIN_BAND 0.08

StructuredBuffer<FishInstance> _FishInstances;
StructuredBuffer<FishModel> _FishModels;
StructuredBuffer<FishWork> _FishWork;
StructuredBuffer<uint2> _FishSlots;          // x base in _FishVisibleOut, y capacity
StructuredBuffer<uint> _FishArgSlots;        // the slot each indirect command draws
RWByteAddressBuffer _FishCounts;             // one uint per slot
RWStructuredBuffer<FishVisible> _FishVisibleOut;
RWByteAddressBuffer _FishArgs;               // IndirectDrawIndexedArgs, 5 uints per command
// The BatchRendererGroup's visible list (TerrainGpuRenderer.Brg.cs): every FishVisible entry again, at the same place, as one
// uint the way DOTS instancing reads it (UnityDOTSInstancing.hlsl SetupDOTSVisibleInstancingData) — the resident index in
// the low 24 bits, the LOD fade as a signed byte in the high 8 (FishPackFade). Written only while _FishPackedOn is 1;
// bound to a one-word buffer otherwise.
RWByteAddressBuffer _FishVisiblePacked;
uint _FishPackedOn;

float4 _FishCameraPosition;                  // xyz
float4 _FishPlanes[6];                       // xyz normal, w distance: inside when dot(n, p) + w >= 0
float4 _FishLight;                           // xyz the sun's direction of travel, w the shadow distance (0: no shadows)
float4 _FishLod;                             // x screen factor, y orthographic (0/1), z maximum LOD level
uint _FishSlotCount;
uint _FishWorkCount;
uint _FishArgCount;

float3 FishTransformPoint(FishInstance i, float3 p)
{
    float4 q = float4(p, 1.0);
    return float3(dot(i.row0, q), dot(i.row1, q), dot(i.row2, q));
}

bool FishSphereVisible(float3 c, float r)
{
    bool inside = true;
    [unroll] for (int k = 0; k < 6; k++)
    {
        inside = inside && dot(_FishPlanes[k].xyz, c) + _FishPlanes[k].w >= -r;
    }
    return inside;
}

// ── Occlusion (FishDepthPyramid): shared with the grass (FishHiZOcclusion.hlsl) ──
#include "FishHiZOcclusion.hlsl"

// The sphere swept along the light by length l: outside a plane only when both ends are.
bool FishSweptSphereVisible(float3 c, float r, float3 d, float l)
{
    bool inside = true;
    [unroll] for (int k = 0; k < 6; k++)
    {
        float d0 = dot(_FishPlanes[k].xyz, c) + _FishPlanes[k].w;
        float d1 = d0 + dot(_FishPlanes[k].xyz, d) * l;
        inside = inside && max(d0, d1) >= -r;
    }
    return inside;
}

int FishSelectLod(float rh, FishModel m, int maxLod)
{
    int count = (int)m.levelCount;
    int found = -1;
    [unroll] for (int i = 0; i < 4; i++)
    {
        if (found < 0 && i < count && rh >= m.transitions[i])
        {
            found = i;
        }
    }
    return found < 0 ? -1 : min(max(found, maxLod), count - 1);
}

// TerrainTreeMath.SelectLodFaded: the primary level (−1 culled) with its fade, and the partner (−1 none).
int FishSelectLodFaded(float rh, FishModel m, int maxLod, out float fade, out int partner, out float partnerFade)
{
    fade = 0.0;
    partner = -1;
    partnerFade = 0.0;
    int lod = FishSelectLod(rh, m, maxLod);
    int result = lod;
    if (lod >= 0)
    {
        float t = m.transitions[lod];
        float w = m.fadeWidths[lod];
        if (w > 0.0 && rh < t + w)
        {
            int next = lod + 1 < (int)m.levelCount ? lod + 1 : -1;
            float f = 1.0 - (rh - t) / w;
            if (f >= 1.0)
            {
                result = next;               // exactly at the transition: wholly the next level (or culled)
            }
            else if (f > 0.0)
            {
                fade = -f;
                if (next >= 0)
                {
                    partner = next;
                    partnerFade = f;
                }
            }
        }
    }
    return result;
}

uint FishHash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// How much of this instance distance thinning fades out: 0 kept whole, (0, 1) dithered, >= 1 culled.
// The share kept is 1 to thinStart, then falls linearly to thinKeep at the draw distance; an instance is
// kept while its hash (by world position: stable across chunk rebuilds) is under that share.
// One return: HLSLcc (glcore) warns "potentially uninitialized" on an early return from a value function.
float FishThinFade(FishWork w, float3 position, float d)
{
    float fade = 0.0;
    if (w.thinKeep < 1.0 && d > w.thinStart)
    {
        float t = saturate((d - w.thinStart) / max(1e-3, w.drawDistance - w.thinStart));
        float keep = lerp(1.0, w.thinKeep, t);
        float h = (float)(FishHash(asuint(position.x) ^ FishHash(asuint(position.z))) & 0xFFFFFFu) / 16777216.0;
        fade = saturate(1.0 - (keep - h) / FISH_THIN_BAND);   // 1 (culled) once h reaches keep
    }
    return fade;
}

/* Appends are counted per thread group: a work item is one model's run, so a group reaches at most that model's eight
 * slots (four levels, two views). Each thread takes its entries' places from the group's own counters, then one thread
 * per slot takes the group's whole run from the slot's counter with one atomic, where every entry took one before. The
 * counts are the same, so the draws are; only the order of entries within a slot differs (nothing reads it). */
#define FISH_GROUP_SLOTS 8
groupshared uint gsFishCount[FISH_GROUP_SLOTS];
groupshared uint gsFishBase[FISH_GROUP_SLOTS];

// The LOD fade as the signed byte DOTS instancing carries in a visible index's top 8 bits (its crossfade, read back as
// byte / 127). Not the nearest byte: the byte at the middle of the fade's step of FishLodFade.hlsl's 4x4 pattern, so the
// pattern keeps exactly the pixels the float would (a pixel at threshold k/16 is drawn while k/16 < |fade|, so only
// ceil(16 |fade|) matters, and a step is 7.9 bytes wide). +f and -f give opposite bytes, which still partition; 0 stays 0
// (fully drawn). TerrainGpuMath.PackLodFade is the same rule (its tests compare the two predicates over every fade).
uint FishPackFade(float fade)
{
    int q = 0;
    if (fade != 0.0)
    {
        float steps = ceil(16.0 * min(abs(fade), 1.0));
        q = (int)round((steps - 0.5) * (127.0 / 16.0));
        q = fade < 0.0 ? -q : q;
    }
    return ((uint)q & 0xFFu) << 24;
}

// Writes a visible entry at its place in a slot (dropped past the slot's capacity).
void FishStore(uint slot, uint at, uint index, float fade)
{
    uint2 s = _FishSlots[slot];
    if (at < s.y)
    {
        FishVisible v;
        v.index = index;
        v.lodFade = fade;
        _FishVisibleOut[s.x + at] = v;
        if (_FishPackedOn != 0)
        {
            _FishVisiblePacked.Store((s.x + at) * 4, (index & 0xFFFFFFu) | FishPackFade(fade));
        }
    }
}

[numthreads(64, 1, 1)]
void FishClearCounts(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _FishSlotCount)
    {
        _FishCounts.Store(id.x * 4, 0);
    }
}

/* One instance of a work item: which of its model's slots it enters (up to four entries: its level and its cross-fade
 * partner, in the camera's view and the shadows'), as local slots (level * 2 + view) in `slots` with their fades, `valid`
 * a bit per entry. Every output is set first, so each early return enters nothing. */
void FishCullInstance(uint3 group, uint3 thread, out uint index, out uint4 slots, out float4 fades, out uint valid)
{
    index = 0;
    slots = 0;
    fades = 0.0;
    valid = 0;
    uint item = group.x + group.y * 65535;
    if (item >= _FishWorkCount)
    {
        return;
    }
    FishWork work = _FishWork[item];
    if (thread.x >= work.count)
    {
        return;
    }
    index = work.start + thread.x;
    FishInstance inst = _FishInstances[index];
    FishModel m = _FishModels[work.model];

    float3 position = float3(inst.row0.w, inst.row1.w, inst.row2.w);
    float3 eye = _FishCameraPosition.xyz;
    float3 toEye = position - eye;
    if (dot(toEye, toEye) > work.drawDistance * work.drawDistance)
    {
        return;
    }
    float thin = FishThinFade(work, position, sqrt(dot(toEye, toEye)));
    if (thin >= 1.0)
    {
        return;
    }

    float sx = length(float3(inst.row0.x, inst.row1.x, inst.row2.x));
    float sy = length(float3(inst.row0.y, inst.row1.y, inst.row2.y));
    float sz = length(float3(inst.row0.z, inst.row1.z, inst.row2.z));
    float factor = _FishLod.x * work.lodBias;
    float worldSize = m.size * max(sx, sy);
    float rh = _FishLod.y > 0.5
        ? worldSize * factor
        : worldSize * factor / max(1e-4, distance(FishTransformPoint(inst, m.localReference), eye));

    float fade, partnerFade;
    int partner;
    int lod = FishSelectLodFaded(rh, m, (int)_FishLod.z, fade, partner, partnerFade);
    if (lod < 0)
    {
        return;
    }
    if (thin > 0.0 && partner < 0)
    {
        fade = -max(-fade, thin);   // a single fading-out level (grass): the stronger of the two fades
    }

    float3 centre = FishTransformPoint(inst, m.sphereCentre);
    float radius = m.sphereRadius * max(sx, max(sy, sz));
    if (FishSphereVisible(centre, radius) && !FishOccluded(centre, radius))
    {
        slots.x = (uint)lod * 2;
        fades.x = fade;
        valid |= 1u;
        if (partner >= 0)
        {
            slots.y = (uint)partner * 2;
            fades.y = partnerFade;
            valid |= 2u;
        }
    }

    float shadowDistance = _FishLight.w;
    uint casts = m.shadowMask & ((1u << (uint)lod) | (partner >= 0 ? (1u << (uint)partner) : 0u));
    if (shadowDistance > 0.0 && casts != 0 && distance(centre, eye) <= shadowDistance + radius)
    {
        float3 d = _FishLight.xyz;
        float down = max(-d.y, 0.1);
        float l = min(shadowDistance, 2.0 * radius / down);
        if (FishSweptSphereVisible(centre, radius, d, l))
        {
            if ((m.shadowMask & (1u << (uint)lod)) != 0)
            {
                slots.z = (uint)lod * 2 + 1;
                fades.z = fade;
                valid |= 4u;
            }
            if (partner >= 0 && (m.shadowMask & (1u << (uint)partner)) != 0)
            {
                slots.w = (uint)partner * 2 + 1;
                fades.w = partnerFade;
                valid |= 8u;
            }
        }
    }
}

[numthreads(64, 1, 1)]
void FishCull(uint3 group : SV_GroupID, uint3 thread : SV_GroupThreadID)
{
    if (thread.x < FISH_GROUP_SLOTS)
    {
        gsFishCount[thread.x] = 0;
    }
    GroupMemoryBarrierWithGroupSync();
    uint index;
    uint4 slots;
    float4 fades;
    uint valid;
    FishCullInstance(group, thread, index, slots, fades, valid);
    // This thread's places in the group's runs.
    uint4 at = 0;
    [unroll] for (int e = 0; e < 4; e++)
    {
        if ((valid & (1u << (uint)e)) != 0)
        {
            InterlockedAdd(gsFishCount[slots[e]], 1, at[e]);
        }
    }
    GroupMemoryBarrierWithGroupSync();
    // The group's runs in its model's slots: one atomic per slot it fills (the item is valid wherever a count is not 0).
    if (thread.x < FISH_GROUP_SLOTS)
    {
        uint n = gsFishCount[thread.x];
        uint first = 0;
        if (n > 0)
        {
            uint item = group.x + group.y * 65535;
            uint slotBase = _FishModels[_FishWork[item].model].slotBase;
            _FishCounts.InterlockedAdd((slotBase + thread.x) * 4, n, first);
        }
        gsFishBase[thread.x] = first;
    }
    GroupMemoryBarrierWithGroupSync();
    if (valid != 0)
    {
        uint item = group.x + group.y * 65535;
        uint slotBase = _FishModels[_FishWork[item].model].slotBase;
        [unroll] for (int k = 0; k < 4; k++)
        {
            if ((valid & (1u << (uint)k)) != 0)
            {
                FishStore(slotBase + slots[k], gsFishBase[slots[k]] + at[k], index, fades[k]);
            }
        }
    }
}

[numthreads(64, 1, 1)]
void FishFinalize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _FishArgCount)
    {
        return;
    }
    uint slot = _FishArgSlots[id.x];
    uint count = _FishCounts.Load(slot * 4);
    _FishArgs.Store((id.x * 5 + 1) * 4, min(count, _FishSlots[slot].y));
}

StructuredBuffer<FishInstance> _FishUpload;
RWStructuredBuffer<FishInstance> _FishInstancesOut;
uint _FishUploadSource;
uint _FishUploadDestination;
uint _FishUploadCount;

[numthreads(64, 1, 1)]
void FishCopyInstances(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _FishUploadCount)
    {
        _FishInstancesOut[_FishUploadDestination + id.x] = _FishUpload[_FishUploadSource + id.x];
    }
}

/* The BatchRendererGroup's instance data (TerrainGpuRenderer.Brg.cs, TerrainGpuMath.Dots*): each uploaded instance's
 * object-to-world matrix and its inverse as DOTS instancing loads them (UnityDOTSInstancing.hlsl
 * LoadDOTSInstancedData_float4x4_from_float3x4: twelve floats, column by column, the translation last), at the instance's
 * own index in two arrays of _FishDotsOut — unity_ObjectToWorld from _FishDotsObjectToWorld, unity_WorldToObject from
 * _FishDotsWorldToObject (bytes). Dispatched after FishCopyInstances with the same range, reading the same upload.
 * The inverse is FishIndirectInstancing.hlsl's (T·R·S, no shear), so both paths light an instance alike. */
RWByteAddressBuffer _FishDotsOut;
uint _FishDotsObjectToWorld;
uint _FishDotsWorldToObject;

void FishStoreDots(uint address, float4 row0, float4 row1, float4 row2)
{
    // Column j is (row0[j], row1[j], row2[j]); four columns of three, the translation (w) last.
    _FishDotsOut.Store4(address +  0, asuint(float4(row0.x, row1.x, row2.x, row0.y)));
    _FishDotsOut.Store4(address + 16, asuint(float4(row1.y, row2.y, row0.z, row1.z)));
    _FishDotsOut.Store4(address + 32, asuint(float4(row2.z, row0.w, row1.w, row2.w)));
}

[numthreads(64, 1, 1)]
void FishDotsInstances(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _FishUploadCount)
    {
        FishInstance i = _FishUpload[_FishUploadSource + id.x];
        uint at = (_FishUploadDestination + id.x) * 48;
        FishStoreDots(_FishDotsObjectToWorld + at, i.row0, i.row1, i.row2);
        // The inverse of T·R·S with orthogonal columns c: row k of inverse(R·S) is c_k / |c_k|², and its translation -that·t.
        float3 c0 = float3(i.row0.x, i.row1.x, i.row2.x);
        float3 c1 = float3(i.row0.y, i.row1.y, i.row2.y);
        float3 c2 = float3(i.row0.z, i.row1.z, i.row2.z);
        float3 i0 = c0 / dot(c0, c0);
        float3 i1 = c1 / dot(c1, c1);
        float3 i2 = c2 / dot(c2, c2);
        float3 t = float3(i.row0.w, i.row1.w, i.row2.w);
        FishStoreDots(_FishDotsWorldToObject + at, float4(i0, -dot(i0, t)), float4(i1, -dot(i1, t)), float4(i2, -dot(i2, t)));
    }
}

/* OpenGL: makes Unity issue GL_COMMAND_BARRIER_BIT before the indirect draws (the same fix as FishGrassBlades.compute
 * FishGrassArgsFence). Unity's GLES device marks a barrier pending only when a buffer is BOUND after a write
 * (GfxDeviceGLES::SetComputeBuffer); DrawBuffersIndirect never checks the args buffer's own write stamp. So
 * FishFinalize's args got their command barrier only every other frame, and the draws read them mid-write: the cliff
 * rocks flickered on OpenGL only. Binding the args here right after FishFinalize makes the barrier pending. */
ByteAddressBuffer _FishArgsFence;

[numthreads(1, 1, 1)]
void FishArgsFence(uint3 id : SV_DispatchThreadID)
{
    // Never true (instance counts are capped): only the bindings matter.
    if (_FishArgsFence.Load(4) == 0xFFFFFFFFu)
    {
        _FishCounts.Store(0, 0u);
    }
}


// ── The depth pyramid's levels (FishDepthPyramid) ─────────────────────
Texture2D<float> _FishHiZSource;       // the camera's depth texture (raw)
RWTexture2D<float> _FishHiZAtlas;      // the pyramid's atlas, read and written
float4 _FishHiZSourceSize;             // xy the depth texture's size
float4 _FishHiZZBuffer;                // the camera's _ZBufferParams
uint _FishHiZLevel;                    // the level a reduce writes

// Level 0: each texel the farthest linear eye depth of the two-by-two of pixels it covers.
[numthreads(8, 8, 1)]
void FishHiZCopy(uint3 id : SV_DispatchThreadID)
{
    int2 size = FishHiZBaseSize();
    if (any((int2)id.xy >= size))
    {
        return;
    }
    int2 source = int2(_FishHiZSourceSize.xy) - 1;
    float farthest = 0.0;
    [unroll] for (int k = 0; k < 4; k++)
    {
        int2 pixel = min(int2(id.xy) * 2 + int2(k & 1, k >> 1), source);
        float raw = _FishHiZSource.Load(int3(pixel, 0));
        farthest = max(farthest, 1.0 / (_FishHiZZBuffer.z * raw + _FishHiZZBuffer.w));
    }
    _FishHiZAtlas[id.xy] = farthest;
}

// Level l from level l − 1: the farthest of the two-by-two under each texel.
[numthreads(8, 8, 1)]
void FishHiZReduce(uint3 id : SV_DispatchThreadID)
{
    int level = (int)_FishHiZLevel;
    int2 size = FishHiZSize(level);
    if (any((int2)id.xy >= size))
    {
        return;
    }
    int2 below = FishHiZSize(level - 1);
    int2 from = FishHiZOrigin(level - 1);
    float farthest = 0.0;
    [unroll] for (int k = 0; k < 4; k++)
    {
        int2 texel = min(int2(id.xy) * 2 + int2(k & 1, k >> 1), below - 1);
        farthest = max(farthest, _FishHiZAtlas[from + texel]);
    }
    _FishHiZAtlas[FishHiZOrigin(level) + int2(id.xy)] = farthest;
}
