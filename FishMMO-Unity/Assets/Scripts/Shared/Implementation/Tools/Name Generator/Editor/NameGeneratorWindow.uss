/* Name Generator Stylesheet — palette and metrics mirror FishMMODashboard.uss */

/* ── Root ── */
.root {
    flex-grow: 1;
    flex-direction: column;
}

/* ── Toolbar ── */
.toolbar {
    flex-direction: row;
    height: 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 30, 30);
    background-color: rgb(56, 56, 56);
    align-items: center;
}

.toolbar-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(180, 210, 255);
    margin-left: 8px;
    margin-right: 12px;
    white-space: nowrap;
}

.toolbar-spacer {
    flex-grow: 1;
}

.toolbar-button {
    margin: 2px 4px;
    padding: 0 10px;
}

.toolbar-button--primary {
    color: rgb(180, 210, 255);
    -unity-font-style: bold;
}

/* ── Main Content ── */
.main-content {
    flex-grow: 1;
    flex-direction: row;
}

/* ── Panel Headers ── */
.panel-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(200, 220, 240);
    padding: 6px 8px 4px 8px;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

/* ── Category Panel (Left) ── */
.category-panel {
    width: 170px;
    min-width: 120px;
    background-color: rgb(42, 42, 42);
    border-right-width: 1px;
    border-right-color: rgb(30, 30, 30);
    flex-shrink: 0;
}

.category-scroll {
    flex-grow: 1;
}

.category-list {
    padding: 2px 0;
}

.category-item {
    padding: 5px 10px;
    margin: 1px 4px;
    border-radius: 3px;
    flex-direction: row;
    align-items: center;
    cursor: link;
}

.category-item:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.category-item--selected {
    background-color: rgba(50, 100, 180, 0.4);
    border-left-width: 3px;
    border-left-color: rgb(80, 140, 240);
}

.category-label {
    font-size: 12px;
    color: rgb(200, 200, 200);
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.category-count {
    font-size: 10px;
    color: rgb(130, 130, 130);
    margin-left: 4px;
    flex-shrink: 0;
}

/* ── Settings Panel (Middle) ── */
.settings-panel {
    width: 280px;
    min-width: 200px;
    background-color: rgb(46, 46, 46);
    border-right-width: 1px;
    border-right-color: rgb(30, 30, 30);
    flex-shrink: 0;
}

.settings-scroll {
    flex-grow: 1;
}

.settings-content {
    padding: 4px 6px 8px 6px;
}

.field-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(120, 140, 170);
    letter-spacing: 1px;
    -unity-text-transform: uppercase;
    margin-top: 8px;
    margin-bottom: 2px;
}

.field-note {
    font-size: 10px;
    color: rgb(130, 130, 130);
    white-space: normal;
    margin-top: 6px;
}

.field-row {
    flex-direction: row;
}

.field-col {
    flex-grow: 1;
    margin-right: 4px;
}

.settings-group {
    margin-top: 6px;
    padding: 4px 6px 6px 6px;
    background-color: rgb(55, 55, 55);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(40, 40, 40);
}

/* ── Searchable picker (race / biome) ── */
.ng-picker {
    margin-bottom: 2px;
}

.ng-picker__button {
    height: 20px;
    margin: 0;
    padding: 0 6px;
    background-color: rgb(60, 60, 60);
    color: rgb(200, 200, 200);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(35, 35, 35);
    -unity-text-align: middle-left;
    font-size: 11px;
}

.ng-picker__button:hover {
    background-color: rgb(68, 68, 68);
}

/* ── Results Panel (Right) ── */
.results-panel {
    flex-grow: 1;
    min-width: 260px;
    background-color: rgb(50, 50, 50);
}

.results-header-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.results-header-row .panel-header {
    flex-grow: 1;
    border-bottom-width: 0;
}

.results-action {
    height: 20px;
    margin: 2px 3px;
    padding: 0 8px;
    font-size: 11px;
    background-color: rgb(60, 60, 60);
    color: rgb(200, 200, 200);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(35, 35, 35);
}

.results-action:hover {
    background-color: rgb(70, 70, 70);
}

.results-action--danger:hover {
    background-color: rgb(120, 55, 60);
    color: rgb(240, 190, 190);
}

.results-scroll {
    flex-grow: 1;
}

.results-list {
    padding: 2px 0;
}

.results-count-label {
    font-size: 10px;
    color: rgb(120, 120, 120);
    padding: 3px 8px;
    background-color: rgb(42, 42, 42);
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
}

/* ── Result Rows ── */
.result-row {
    padding: 4px 10px;
    margin: 1px 4px;
    border-radius: 3px;
    flex-direction: row;
    align-items: center;
}

.result-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.result-row--alt {
    background-color: rgba(255, 255, 255, 0.025);
}

.result-index {
    font-size: 10px;
    color: rgb(120, 120, 120);
    width: 26px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    margin-right: 8px;
}

.result-name {
    font-size: 12px;
    color: rgb(210, 210, 210);
    -unity-font-style: bold;
    flex-shrink: 0;
}

.result-title {
    font-size: 11px;
    color: rgb(180, 210, 255);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-left: 2px;
}

.result-spacer {
    flex-grow: 1;
    min-width: 8px;
}

.result-meaning {
    font-size: 10px;
    color: rgb(140, 165, 195);
    margin-right: 6px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.result-tag {
    font-size: 9px;
    color: rgb(100, 140, 180);
    background-color: rgba(80, 120, 180, 0.15);
    border-radius: 3px;
    padding: 1px 5px;
    margin-left: 4px;
    flex-shrink: 0;
    white-space: nowrap;
}

.result-copy-button {
    width: 22px;
    height: 18px;
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 11px;
    background-color: rgb(60, 60, 60);
    color: rgb(170, 170, 170);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(35, 35, 35);
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.result-copy-button:hover {
    background-color: rgb(70, 70, 70);
    color: rgb(180, 210, 255);
}

/* ── Resizer ── */
.resizer {
    width: 4px;
    cursor: resize-horizontal;
    background-color: rgb(35, 35, 35);
    flex-shrink: 0;
}

.resizer:hover {
    background-color: rgb(80, 140, 240);
}

/* ── Status Bar ── */
.status-bar {
    height: 20px;
    font-size: 10px;
    color: rgb(140, 140, 140);
    padding: 2px 8px;
    background-color: rgb(40, 40, 40);
    border-top-width: 1px;
    border-top-color: rgb(30, 30, 30);
    -unity-text-align: middle-left;
}

/* ── Empty State ── */
.empty-state {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.empty-state-label {
    font-size: 12px;
    color: rgb(120, 120, 120);
    -unity-text-align: middle-center;
    white-space: normal;
}
