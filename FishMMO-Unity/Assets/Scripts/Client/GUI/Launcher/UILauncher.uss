/*
    UILauncher.uss
    Layout for the launcher screen. Colours come from FishMMO-Theme.uss.

    The news block classes at the bottom are applied by UITKHtmlContentRenderer to
    elements it builds at runtime, so they have no counterpart in UILauncher.uxml.
*/

/*
    The window is resizable, so nothing here may assume a size. Every band is either
    flex-shrink: 0 (chrome that must stay legible) or flex-grow: 1 (the news pane, which
    absorbs all the slack). The only fixed numbers are minimums.
*/
.launcher-screen {
    flex-grow: 1;
    padding: 0;
}

/*
    overflow: hidden so a band that cannot fit is clipped by the panel rather than spilling
    over its neighbours. Without it an over-tall child renders on top of the footer, which is
    how the settings list ended up appearing underneath the Play and Quit buttons.
*/
.launcher-panel {
    flex-grow: 1;
    flex-direction: column;
    border-radius: 0;
    border-width: 0;
    border-top-width: 2px;
    min-width: 480px;
    min-height: 360px;
    overflow: hidden;
}

/* ── Art hooks ──────────────────────────────────────────── */

/*
    Both of these are empty by design. Point them at art from USS alone — no C# involved:

        .launcher-backdrop { background-image: url("project://database/Assets/.../bg.png"); }
        .launcher-logo     { background-image: url("project://database/Assets/.../logo.png"); }

    The backdrop sits behind everything at position: absolute so it never participates in
    layout; giving it a size here would make the panel depend on the artwork's dimensions.
*/
.launcher-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.launcher-logo {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--brand-500);
    border-radius: 3px;
}

/*
    Hero art band. Collapsed until given a background-image, so the launcher looks
    deliberate rather than gap-toothed before any art exists:

        .launcher-hero { height: 180px; background-image: url("..."); }
*/
/*
    Brand banner across the top of the panel.

    The height here is only a starting value — UITKClientLauncher.AttachHeroAspect recomputes it
    from the resolved width every time the panel resizes, so the strip always matches the image's
    own proportions. That is what keeps the banner full-width, uncropped and unstretched at the
    same time; USS has no aspect-ratio property to express it directly.

    scale-to-fill rather than crop or fit, because with the height already correct there is
    nothing to crop away and nothing to letterbox.
*/
.launcher-hero {
    height: 96px;
    flex-shrink: 0;
    background-image: url("../../../../Sprites/FishMMOBanner.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-color: var(--abyss-400);
    border-bottom-width: 1px;
}

/* ── Header ─────────────────────────────────────────────── */

.launcher-header {
    height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    flex-shrink: 0;
}

/* Pushes the header buttons to the right edge without absolute positioning. */
.launcher-header-spacer {
    flex-grow: 1;
}

.launcher-header-btn {
    height: 24px;
    min-width: 76px;
    margin-right: 8px;
}

/* ── Settings ───────────────────────────────────────────── */

/*
    An overlay, not a band in the column. Settings is positioned absolutely across the bottom
    of .launcher-stage, so opening it covers the lower part of the news instead of shrinking the
    news pane, and the footer (the progress bar and Play) never moves or gets covered: the
    launcher can be mid-download while the player is reading this. As a flex item it took its
    height from the news on every toggle. The allocation spike on repeated clicks was a separate
    cost, from how the panel was closed; see .launcher-settings--closed below.

    Sized to its content and capped at the whole stage, banner included. The panel is always
    1200 units wide (the shared panel settings match width), so a wide or short window is a
    short panel, while the banner keeps its image's aspect ratio at about 377 units whatever the
    window. The overlay used to live in the news body alone, capped at 38% of it: 66 units at
    16:9 and one or two at 21:9, so the list was cut off at the resolutions most players run.
    Capped at the stage it covers the banner when it needs the room and scrolls only when the
    whole stage is shorter than the list. LauncherSettingsReachableTests pins this at every
    common window shape.
*/
.launcher-settings {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 100%;
    flex-direction: column;
    background-color: var(--abyss-700);
    border-top-color: var(--abyss-500);
    border-top-width: 1px;
}

/*
    Closed with visibility, not display. display: none takes the subtree out of the displayed
    hierarchy, and showing it again rebuilds the visuals of every element in it and re-meshes
    every label: measured at about 25 KB of allocations per open and close, which is what made
    repeated clicks on Settings spike memory. Hidden visibility keeps the overlay laid out and
    its visuals built, and simply does not draw it. Because it is absolute it takes no space
    from the news either way.

    Visibility is inherited and UI Toolkit only picks and focuses visible elements, so every
    control inside a closed panel ignores clicks and keyboard focus; clicks fall through to the
    news beneath. Nothing in the theme sets visibility explicitly, which would break that.
*/
.launcher-settings--closed {
    visibility: hidden;
}

.launcher-settings > #unity-content-viewport > #unity-content-container {
    padding: 10px 16px;
}

.launcher-settings-heading {
    margin-bottom: 6px;
    padding-bottom: 2px;
}

.launcher-setting {
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--abyss-100);
}

.launcher-setting > .unity-base-field__label {
    min-width: 180px;
    color: var(--abyss-200);
}

.launcher-settings-heading--spaced {
    margin-top: 10px;
}

.launcher-patchdir-row {
    flex-direction: row;
    align-items: center;
}

/* Takes the slack so the Browse button keeps a fixed width at any panel size. */
.launcher-patchdir-field {
    flex-grow: 1;
    margin-bottom: 0;
}

.launcher-browse-btn {
    height: 20px;
    min-width: 74px;
    margin-left: 6px;
    font-size: 10px;
}

.launcher-settings-note {
    font-size: 10px;
    color: var(--abyss-300);
    white-space: normal;
    margin-top: 4px;
}

/* Paths wrap rather than clip — a truncated path is useless for diagnosing anything. */
.launcher-path {
    white-space: normal;
    color: var(--abyss-200);
}

/* ── News pane ──────────────────────────────────────────── */

/*
    flex-grow claims the space between header and footer, and min-height:0 lets it
    shrink below its content size. Without the latter a flex child is floored at its
    content height, so a long news page pushes the footer — and therefore the Play
    button — off the bottom of the screen instead of scrolling.
*/
/*
    The body takes over what the news pane used to claim directly: the space between hero and
    footer, allowed to shrink below its content. It is also the containing block the settings
    overlay is positioned against, so the news inside it simply fills the body.
*/
/*
    The banner and the news pane, and the containing block for the settings overlay. overflow:
    hidden so a banner taller than a very short stage is clipped here instead of drawing over
    the footer.
*/
.launcher-stage {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    position: relative;
    overflow: hidden;
}

.launcher-body {
    flex-grow: 1;
    min-height: 0;
}

.launcher-news-scroll {
    flex-grow: 1;
    min-height: 0;
}

.launcher-news {
    flex-direction: column;
    padding: 12px 16px;
}

/* ── Footer ─────────────────────────────────────────────── */

.launcher-footer {
    flex-direction: column;
    padding: 10px 12px;
    flex-shrink: 0;
}

.launcher-status {
    font-size: 11px;
    color: var(--abyss-200);
    white-space: normal;
    -unity-text-align: middle-left;
    margin-bottom: 6px;
}

.launcher-progress {
    flex-direction: column;
    margin-bottom: 8px;
}

.launcher-progress-bar {
    height: 8px;
    width: 100%;
}

.launcher-progress-fill {
    height: 100%;
    width: 0;
}

.launcher-progress-text {
    font-size: 10px;
    color: var(--abyss-300);
    -unity-text-align: middle-right;
    margin-top: 4px;
}

/*
    A spacer between the two buttons rather than justify: space-between, so the row keeps working
    if a third button is ever added — space-between would spread all three evenly and put
    something new between Quit and Play.
*/
.launcher-buttons {
    flex-direction: row;
    align-items: center;
}

.launcher-buttons__spacer {
    flex-grow: 1;
}

.launcher-btn {
    height: 34px;
    min-width: 120px;
    font-size: 11px;
    flex-shrink: 0;
}

/* Quit is destructive but not dangerous — quiet, not red. */
.launcher-btn--quit {
    color: var(--abyss-200);
}

.launcher-btn--primary {
    color: var(--brand-400);
    border-color: var(--brand-border);
    background-color: var(--brand-lo);
}

.launcher-btn:disabled {
    opacity: 0.45;
}

/* ── News content (built at runtime) ────────────────────── */

.launcher-news__block {
    flex-direction: column;
    margin-bottom: 6px;
}

.launcher-news__text {
    font-size: 12px;
    color: var(--abyss-100);
    white-space: normal;
}

.launcher-news__h1 {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--abyss-100);
    white-space: normal;
    margin-top: 10px;
    margin-bottom: 4px;
}

.launcher-news__h2 {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--abyss-100);
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 4px;
}

.launcher-news__h3 {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--brand-300);
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 3px;
}

.launcher-news__list-item {
    flex-direction: row;
    margin-left: 8px;
    margin-bottom: 2px;
}

.launcher-news__bullet {
    font-size: 12px;
    color: var(--brand-500);
    margin-right: 6px;
}

.launcher-news__rule {
    height: 1px;
    background-color: var(--abyss-500);
    margin-top: 8px;
    margin-bottom: 8px;
}

/*
    Links are Labels rather than Buttons: a Button would inherit centred text and its own
    box model, which breaks them out of the surrounding flow of text.
*/
.launcher-news__link {
    font-size: 12px;
    color: var(--brand-500);
    white-space: normal;
}

.launcher-news__link:hover {
    color: var(--brand-400);
    -unity-font-style: bold;
}
