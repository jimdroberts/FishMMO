<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../FishMMO-Theme.uss" />
    <Style src="UILoadingScreen.uss" />
    <ui:VisualElement name="loading-root" class="loading-screen">

        <!-- Full-bleed art behind everything; the sprite is assigned from C#. -->
        <ui:VisualElement name="loading-image" class="loading-image" />

        <!-- The loading block sits together as one unit rather than pinned to the screen edge. -->
        <ui:VisualElement name="loading-panel" class="loading-panel">
            <ui:Label name="loading-status" class="loading-status" text="" />
            <ui:VisualElement name="loading-progress" class="fish-bar loading-progress">
                <ui:VisualElement name="loading-progress-fill" class="fish-bar__fill loading-progress__fill" />
                <ui:Label name="loading-progress-text" class="fish-bar__label loading-progress__text" text="" />
            </ui:VisualElement>
            <ui:Label name="loading-hint" class="fish-hint loading-hint" text="" />

            <!--
                The universal way out. Revealed from C# only once the overlay has held the screen
                longer than any honest transition takes; before that it is display: none and the
                loading screen looks exactly as it did. See UITKLoadingScreen.RevealEscapeHatch.
            -->
            <ui:VisualElement name="loading-actions" class="loading-actions">
                <ui:Label name="loading-stuck" class="loading-status loading-stuck" text="" />
                <ui:Button name="loading-return-btn" text="Return to Login" class="fish-button loading-return-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
