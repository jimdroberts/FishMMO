/*
    UILogin.uss
    Layout for the login screen. Colours come from FishMMO-Theme.uss.
*/

.login-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* The game's name above the panel, set from the project name in C#. */
.login-title {
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text-bright);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 28px;
}

/* The running version, pinned to the bottom left so a screenshot always says which build it came from. */
.login-version {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-size: 12px;
    color: var(--text-bright);
    opacity: 0.7;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.login-panel {
    width: 360px;
}

.login-header {
    height: 32px;
    padding-left: 8px;
    justify-content: center;
}

.login-body {
    flex-direction: column;
    padding: 12px;
}

.login-field-label {
    font-size: 12px;
    margin-bottom: 2px;
    margin-top: 6px;
}

.login-input {
    margin-bottom: 4px;
}

.login-handshake {
    font-size: 12px;
    -unity-text-align: middle-center;
    min-height: 16px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.login-buttons {
    flex-direction: row;
    margin-top: 4px;
}

.login-btn {
    flex-grow: 1;
    margin-right: 4px;
    height: 32px;
}
