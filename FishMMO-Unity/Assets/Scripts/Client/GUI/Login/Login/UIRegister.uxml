<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIRegister.uss" />
    <ui:VisualElement name="register-root" class="register-screen">
        <ui:VisualElement name="register-panel" class="fish-panel register-panel">
            <ui:VisualElement name="register-header" class="fish-panel__header register-header">
                <ui:Label text="CREATE ACCOUNT" class="fish-panel__title" />
            </ui:VisualElement>
            <ui:VisualElement name="register-body" class="register-body">
                <ui:Label text="Username" class="fish-label fish-label--caption register-field-label" />
                <ui:TextField name="register-username" class="fish-input register-input" />
                <ui:Label text="Email" class="fish-label fish-label--caption register-field-label" />
                <ui:TextField name="register-email" class="fish-input register-input" />
                <ui:Label text="Password" class="fish-label fish-label--caption register-field-label" />
                <ui:TextField name="register-password" password="true" class="fish-input register-input" />
                <!--
                    B4: the "Registration Key (optional)" field was removed. Nothing anywhere in
                    the client, the shared auth core or the login server has ever had a parameter
                    for it — SetLoginCredentials takes username, password, register, email and age
                    — so whatever the player typed was cleared by ClearAllFields and discarded. An
                    input that silently ignores what you put in it is worse than no input: on a
                    server that does gate registration behind a key, a player with a valid key
                    would enter it, be refused, and have no way to tell that the field was never
                    read. Re-add it here only together with the wire field that carries it.
                -->
                <ui:Label text="Confirm Age" class="fish-label fish-label--caption register-field-label" />
                <ui:DropdownField name="register-age" class="fish-dropdown register-dropdown" />
                <ui:Label name="register-status" text="" class="fish-label fish-label--muted register-status" />
                <ui:VisualElement name="register-buttons" class="register-buttons">
                    <ui:Button name="register-submit-btn" text="Register" class="fish-button register-btn fish-button--primary" />
                    <ui:Button name="register-quit-btn" text="Back" class="fish-button register-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
