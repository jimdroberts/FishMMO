<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIRegister.uss" />
    <ui:VisualElement name="register-root" class="register-screen">
        <ui:VisualElement name="register-panel" class="fish-panel register-panel">
            <ui:VisualElement name="register-header" class="fish-panel__header register-header">
                <ui:Label text="CREATE ACCOUNT" class="fish-panel__title" />
            </ui:VisualElement>
            <ui:VisualElement name="register-body" class="register-body">
                <ui:VisualElement name="register-columns" class="register-columns">
                    <ui:VisualElement name="register-column-account" class="register-column register-column--account">
                        <ui:Label text="Account" class="fish-label fish-label--accent register-section-caption" />
                        <ui:Label text="Username" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-username" class="fish-input register-input" />
                        <ui:Label text="Email" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-email" class="fish-input register-input" />
                        <ui:Label text="Password" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-password" password="true" class="fish-input register-input" />
                        <ui:Label text="Confirm Age" class="fish-label fish-label--caption register-field-label" />
                        <ui:DropdownField name="register-age" class="fish-dropdown register-dropdown" />
                        <!--
                            How the account proves its contact details. Email is on by default; SMS needs
                            the phone number in the optional column. The server decides which of these it
                            actually checks (VerifyEmail and VerifySms in LoginServer.cfg).
                        -->
                        <ui:Label text="Verify my account by" class="fish-label fish-label--caption register-field-label" />
                        <ui:Toggle name="register-verify-email" text="Email" value="true" class="fish-toggle register-toggle" />
                        <ui:Toggle name="register-verify-sms" text="SMS (needs a phone number)" class="fish-toggle register-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="register-column-optional" class="register-column">
                        <ui:Label text="Optional details" class="fish-label fish-label--accent register-section-caption" />
                        <ui:Label text="Phone number, with country code (e.g. +44)" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-phone" class="fish-input register-input" />
                        <ui:Label text="Country or region" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-country" class="fish-input register-input" />
                        <ui:Label text="Real name" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-realname" class="fish-input register-input" />
                        <ui:Label text="Address" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-address" class="fish-input register-input" />
                        <ui:Label text="Referred by (account name)" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-referral" class="fish-input register-input" />
                        <!--
                            The beta code. Required only while the server runs a closed test (BetaMode), and
                            carried to the server inside the encrypted registration profile. This is the
                            field the old unread Registration Key input should have been: it has a wire
                            field now, and a server that does not need a code still redeems one for later.
                        -->
                        <ui:Label text="Beta code (closed test only)" class="fish-label fish-label--caption register-field-label" />
                        <ui:TextField name="register-betacode" class="fish-input register-input" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="register-status" text="" class="fish-label fish-label--muted register-status" />
                <ui:VisualElement name="register-buttons" class="register-buttons">
                    <ui:Button name="register-submit-btn" text="Register" class="fish-button register-btn fish-button--primary" />
                    <ui:Button name="register-quit-btn" text="Back" class="fish-button register-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
