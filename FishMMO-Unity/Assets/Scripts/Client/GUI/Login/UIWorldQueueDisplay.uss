/*
    UIWorldQueueDisplay.uss
    Layout for the world server's scene-routing queue display. Colours come from
    FishMMO-Theme.uss.

    A dialog, not a toast: while this is up the player can do nothing else, and the one thing
    they need is to see that the wait is alive and moving. Three numbers in a well (where they
    are, how long it may take, how long they have waited), a bar for how much of the line ahead
    of them has cleared, and a single way out.

    Sized against the 1200-unit reference width. The panel is at most about 290 units tall, so it
    fits the 505-unit panel height a 21:9 window gets with room to spare.
*/

/*
    Dimmed full-screen ground, as the shared dialog does. The panel sits above the loading
    overlay (see UITKWorldQueueDisplay.Layer), and the dim is what separates it from the artwork.
*/
.world-queue-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--overlay-dim);
}

.world-queue-panel {
    width: 420px;
    flex-direction: column;
    flex-shrink: 0;
}

.world-queue-header {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

/*
    The lamp breathes while the wait is live: the panel toggles the dim modifier once a second
    and the transition does the rest. A screen that never changes reads as a hang, which is the
    whole problem this panel exists to solve.
*/
.world-queue-header__icon {
    width: 11px;
    height: 11px;
    margin-right: 9px;
    flex-shrink: 0;
    opacity: 1;
    transition: opacity 0.9s ease-in-out;
}

.world-queue-header__icon--dim {
    opacity: 0.35;
}

/* The wait ended without a place: the lamp stops breathing and turns amber. */
.world-queue-header__icon--ended {
    background-color: var(--warn);
    border-color: var(--warn);
    opacity: 1;
}

.world-queue-title {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.world-queue-body {
    flex-direction: column;
    padding: 14px 16px 12px 16px;
}

/*
    Every label here zeroes Unity's default box (padding 1,4,2,4 and margin 2,4,4,2), which
    would otherwise add eleven units to each line and push the stats well past its height.
*/
.world-queue-headline {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-left;
    margin: 0 0 4px 0;
    padding: 0;
}

.world-queue-detail {
    font-size: 11px;
    white-space: normal;
    -unity-text-align: upper-left;
    margin: 0 0 12px 0;
    padding: 0;
}

.world-queue-stats {
    flex-direction: row;
    padding: 8px 4px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.world-queue-stat {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: center;
}

.world-queue-stat__caption {
    -unity-text-align: middle-center;
    margin: 0 0 3px 0;
    padding: 0;
}

.world-queue-stat__value {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.world-queue-progress {
    height: 8px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.world-queue-progress__fill {
    height: 100%;
    width: 0;
}

.world-queue-note {
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.world-queue-footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
}

.world-queue-button {
    min-width: 110px;
    height: 26px;
    margin-left: 6px;
    flex-shrink: 0;
}

/* As on the shared dialog: the button Enter would press is visibly armed. */
.world-queue-button:focus {
    background-color: var(--brand-press);
    border-color: var(--brand-300);
}
