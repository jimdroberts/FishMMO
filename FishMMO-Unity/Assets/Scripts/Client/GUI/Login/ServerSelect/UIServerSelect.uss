/*
    UIServerSelect.uss
    Layout for the world server selection screen. Colours come from FishMMO-Theme.uss.
*/

.server-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.server-panel {
    width: 420px;
    height: 360px;
}

.server-header {
    height: 32px;
    padding-left: 8px;
    justify-content: center;
}

.server-scroll {
    flex-grow: 1;
    padding: 6px;
}

.server-list {
    flex-direction: column;
}

.server-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 8px;
    margin-bottom: 2px;
}

.server-row--selected {
    background-color: var(--teal-mid);
}

/*
    Same reason as the character rows: these labels are built in C# rather than declared in the
    UXML, so they never get the .fish-label class that carries text colour, and nothing in the
    theme colours a bare Label. Without an explicit colour they render near-black on a dark
    panel — the server list looks empty rather than mis-styled.
*/
.server-row__name {
    font-size: 13px;
    color: var(--abyss-100);
}

.server-row__status {
    font-size: 12px;
    /* --abyss-200 ("secondary text"), not --abyss-300 ("muted text"): against the
       .fish-panel background --abyss-300 measures 3.36:1, under the 4.5:1 needed for
       12px body text, while --abyss-200 measures 7.01:1. This line carries whether the
       world is actually joinable, so it has to be read, not merely noticed. */
    color: var(--abyss-200);
}

.server-buttons {
    flex-direction: row;
    padding: 4px 6px;
}

.server-btn {
    flex-grow: 1;
    margin-right: 4px;
    height: 32px;
}
