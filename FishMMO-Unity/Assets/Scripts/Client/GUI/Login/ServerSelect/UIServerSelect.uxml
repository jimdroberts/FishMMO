<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIServerSelect.uss" />
    <ui:VisualElement name="server-root" class="server-screen">
        <ui:VisualElement name="server-panel" class="fish-panel server-panel">
            <ui:VisualElement name="server-header" class="fish-panel__header server-header">
                <ui:Label text="SELECT A WORLD" class="fish-panel__title" />
            </ui:VisualElement>
            <ui:ScrollView name="server-scroll" class="fish-scroll server-scroll">
                <ui:VisualElement name="server-list" class="server-list" />
            </ui:ScrollView>
            <ui:VisualElement name="server-buttons" class="server-buttons">
                <ui:Button name="server-connect-btn" text="Connect" class="fish-tab server-btn server-btn--primary" />
                <ui:Button name="server-refresh-btn" text="Refresh" class="fish-tab server-btn" />
            </ui:VisualElement>
            <ui:VisualElement name="server-buttons-secondary" class="server-buttons">
                <ui:Button name="server-quit-login-btn" text="Back" class="fish-tab server-btn" />
                <ui:Button name="server-quit-btn" text="Quit" class="fish-tab server-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
