/*
    UILoadingScreen.uss
    Layout for the full-screen loading overlay. Colours come from FishMMO-Theme.uss.
*/

.loading-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.loading-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.loading-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10px;
    flex-direction: row;
}

.loading-progress__fill {
    width: 0;
    height: 100%;
}

/*
    Status line for waits the player cannot see the reason for — currently the reconnect
    backoff, which can hold the overlay for minutes while nothing visibly happens.
    Hidden (display: none) whenever the text is empty, so an ordinary scene load still
    shows only the image and the bar.
*/
.loading-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 18px;
    color: rgb(235, 235, 235);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.85);
}
