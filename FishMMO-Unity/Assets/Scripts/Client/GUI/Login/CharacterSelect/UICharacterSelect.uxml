<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UICharacterSelect.uss" />
    <ui:VisualElement name="character-root" class="character-screen">
        <ui:VisualElement name="character-panel" class="fish-panel character-panel">
            <ui:VisualElement name="character-header" class="fish-panel__header character-header">
                <ui:Label text="SELECT A CHARACTER" class="fish-panel__title" />
            </ui:VisualElement>
            <ui:ScrollView name="character-scroll" class="fish-scroll character-scroll">
                <ui:VisualElement name="character-list" class="character-list" />
            </ui:ScrollView>
            <ui:VisualElement name="character-buttons" class="character-buttons">
                <ui:Button name="character-connect-btn" text="Play" class="fish-tab character-btn character-btn--primary" />
                <ui:Button name="character-create-btn" text="Create" class="fish-tab character-btn" />
                <ui:Button name="character-delete-btn" text="Delete" class="fish-tab character-btn character-btn--danger" />
            </ui:VisualElement>
            <ui:VisualElement name="character-buttons-secondary" class="character-buttons">
                <ui:Button name="character-quit-login-btn" text="Back" class="fish-tab character-btn" />
                <ui:Button name="character-quit-btn" text="Quit" class="fish-tab character-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
