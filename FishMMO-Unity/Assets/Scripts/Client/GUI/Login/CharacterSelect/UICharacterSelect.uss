/*
    UICharacterSelect.uss
    Layout for the character selection screen. Colours come from FishMMO-Theme.uss.
*/

.character-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.character-panel {
    width: 420px;
    height: 360px;
}

.character-header {
    height: 32px;
    padding-left: 8px;
    justify-content: center;
}

.character-scroll {
    flex-grow: 1;
    padding: 6px;
}

.character-list {
    flex-direction: column;
}

.character-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 8px;
    margin-bottom: 2px;
}

.character-row--selected {
    background-color: var(--teal-mid);
}

/*
    Colour is set here because these two labels are built in C# by CreateCharacterRow, not
    declared in the UXML, so they never receive the .fish-label class that carries text colour
    everywhere else. Nothing in the theme colours a bare Label, so without this they render in
    UI Toolkit's default near-black — on this panel that is invisible rather than merely wrong,
    and the rows read as an empty list with no error anywhere to explain it.
*/
.character-row__name {
    font-size: 13px;
    color: var(--abyss-100);
}

.character-row__scene {
    font-size: 12px;
    color: var(--abyss-300);
}

.character-buttons {
    flex-direction: row;
    padding: 4px 6px;
}

.character-btn {
    flex-grow: 1;
    margin-right: 4px;
    height: 32px;
}

/*
    Status line under the list. Used only when there is something to say — a refused or failed
    character-list request — and collapsed from C# otherwise, so the ordinary case still shows
    just the list and the buttons.
*/
.character-status {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 2px;
}
