/*
    UISelector.uss
    Layout for the shared list-selection dialog. Colours come from
    FishMMO-Theme.uss.

    A scrolling list of choices with accept and cancel. Entries are generated
    at runtime and carry .fish-row, so selection and hover behave the same way
    they do in every other list in the game.
*/

.selector-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--overlay-dim);
}

.selector-panel {
    min-width: 340px;
    max-width: 480px;
    max-height: 70%;
    flex-direction: column;
    flex-shrink: 0;
}

.selector-header {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 12px;
    padding-right: 10px;
    flex-shrink: 0;
}

.selector-header__icon {
    width: 11px;
    height: 11px;
    margin-right: 9px;
    flex-shrink: 0;
}

.selector-count {
    min-width: 22px;
    height: 15px;
    padding-left: 5px;
    padding-right: 5px;
    flex-shrink: 0;
}

.selector-scroll {
    flex-grow: 1;
    min-height: 80px;
}

.selector-list {
    flex-direction: column;
}

/* One choice. .fish-row supplies hover and the leading accent rail. */
.selector-entry {
    height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.selector-empty {
    margin-top: 22px;
    margin-bottom: 22px;
}

.selector-buttons {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
}

.selector-action {
    min-width: 92px;
    height: 26px;
    margin-left: 6px;
    flex-shrink: 0;
}

/*
    Keyboard focus. The selector can be driven entirely from the keyboard — arrows to move,
    Enter to accept, Escape to cancel — and without a visible focus state there is no way to
    tell which option those keys are about to act on. Uses the same accent the selected row
    does so the two read as one highlight rather than two competing ones.
*/
.selector-entry:focus {
    background-color: var(--brand-hover);
    border-left-color: var(--brand-300);
}

.selector-action:focus {
    border-color: var(--brand-300);
}
