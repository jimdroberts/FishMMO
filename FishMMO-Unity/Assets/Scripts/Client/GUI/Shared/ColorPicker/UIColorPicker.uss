/*
    UIColorPicker.uss
    Layout for the HSV/RGBA color picker.
*/

.colorpicker-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--overlay-dim);
}

.colorpicker-panel {
    width: 360px;
    padding: 16px;
}

/*
    Matches .dialog-header. The negative margins pull the bar back out through the
    panel's own 16px padding so it sits flush against the frame the way an authored
    header does, rather than floating as an inset strip.
*/
.colorpicker-header {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
    margin-left: -16px;
    margin-right: -16px;
    margin-top: -16px;
    margin-bottom: 12px;
}

.colorpicker-header__icon {
    width: 11px;
    height: 11px;
    margin-right: 9px;
    flex-shrink: 0;
}

.colorpicker-top {
    flex-direction: row;
    margin-bottom: 12px;
}

.colorpicker-hsv {
    width: 192px;
    height: 192px;
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: var(--swatch-border);
}

.colorpicker-cursor {
    position: absolute;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--white);
    background-color: var(--clear);
}

.colorpicker-side {
    flex-grow: 1;
    margin-left: 12px;
}

.colorpicker-swatch {
    height: 48px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--swatch-border);
}

.colorpicker-hex {
    flex-shrink: 0;
}

.colorpicker-channel {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    min-height: 22px;
}

.colorpicker-channel-label {
    width: 16px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.colorpicker-channel-bg {
    flex-grow: 1;
    height: 16px;
    margin: 0 8px;
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: var(--swatch-border);
    justify-content: center;
}

.colorpicker-channel-slider {
    flex-grow: 1;
    margin: 0;
}

.colorpicker-channel-input {
    width: 52px;
    flex-shrink: 0;
}

.colorpicker-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.colorpicker-action {
    min-width: 96px;
}

/*
    Keyboard focus on the close action, so a picker reached by keyboard shows a way out.
*/
.colorpicker-action:focus {
    background-color: var(--brand-press);
    border-color: var(--brand-300);
}
