<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UITooltipView.uss" />
    <Style src="UITooltip.uss" />
    <ui:VisualElement name="tooltip-root" class="tooltip-root" picking-mode="Ignore">
        <!--
            The box holds rendered rows, not one label. UITKTooltipView fills it from the
            TooltipContent the hovered element supplied; see UITKTooltip.
        -->
        <ui:VisualElement name="tooltip-box" class="fish-tooltip tooltip-box" picking-mode="Ignore">
            <ui:VisualElement name="tooltip-content" class="tooltip-content" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
