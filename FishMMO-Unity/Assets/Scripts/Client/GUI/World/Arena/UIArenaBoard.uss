/*
    UIArenaBoard.uss
    Layout for the arena board. Colours come from FishMMO-Theme.uss. Sizes are written
    against the 1200x800 reference resolution declared by Assets/UI Toolkit/PanelSettings.asset.
*/

.arena-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.arena-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 440px;
    max-height: 82%;
    flex-direction: column;
    flex-shrink: 0;
}

/* ── Header ─────────────────────────────────────────────── */

.arena-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 10px;
    padding-right: 6px;
    flex-shrink: 0;
}

.arena-header__icon {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    flex-shrink: 0;
}

.arena-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.arena-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.arena-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}

.arena-close-btn {
    flex-shrink: 0;
}

/* ── Tabs (arenas and formats share the strip geometry) ─── */

.arena-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    flex-shrink: 0;
}

.arena-tab,
.arena-format-tab {
    margin-right: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.arena-tabs--single {
    display: none;
}

.arena-views {
    padding-top: 6px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--abyss-400);
}

.arena-view-tab {
    margin-right: 4px;
    flex-shrink: 0;
}

/* A ranked format tab carries a small mark, set inline as a suffix; this colours it. */
.arena-format-tab--ranked {
    border-color: var(--brand-500);
}

/* ── Profile strip ──────────────────────────────────────── */

.arena-profile {
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    flex-shrink: 0;
}

.arena-profile__text {
    white-space: normal;
    -unity-text-align: middle-left;
}

.arena-profile--locked {
    border-color: var(--danger-500);
}

.arena-hidden {
    display: none;
}

/* ── History and leaderboard lists ──────────────────────── */

.arena-list-scroll {
    flex-grow: 1;
    min-height: 120px;
    max-height: 360px;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 6px;
}

.arena-list-scroll--hidden {
    display: none;
}

.arena-list {
    flex-direction: column;
}

.arena-list__columns {
    flex-direction: row;
    align-items: center;
    height: 16px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--abyss-850);
    border-bottom-color: var(--abyss-400);
    border-bottom-width: 1px;
    flex-shrink: 0;
}

.arena-list__row {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    border-left-width: 3px;
    flex-shrink: 0;
}

.arena-list__row--mine {
    background-color: var(--brand-lo);
}

.arena-col--rank  { width: 28px; flex-shrink: 0; -unity-text-align: middle-center; }
.arena-col--name  { flex-grow: 1; overflow: hidden; }
.arena-col--num   { width: 46px; flex-shrink: 0; -unity-text-align: middle-center; }
.arena-col--wide  { width: 84px; flex-shrink: 0; -unity-text-align: middle-center; }

.arena-list__empty {
    margin-top: 14px;
    margin-bottom: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── About ──────────────────────────────────────────────── */

.arena-about {
    flex-direction: row;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-shrink: 0;
}

.arena-image {
    width: 96px;
    height: 96px;
    margin-right: 10px;
    flex-shrink: 0;
}

.arena-image__label {
    -unity-text-align: middle-center;
}

.arena-about__text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.arena-name {
    margin-bottom: 4px;
    flex-shrink: 0;
    white-space: normal;
}

.arena-mode {
    align-self: flex-start;
    margin-bottom: 6px;
}

.arena-description {
    white-space: normal;
    flex-grow: 1;
}

/* ── Rules and queue strips ─────────────────────────────── */

.arena-rules,
.arena-queue {
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    flex-shrink: 0;
}

.arena-rules__text,
.arena-queue__text {
    white-space: normal;
    -unity-text-align: middle-left;
}

.arena-rules--empty,
.arena-queue--hidden {
    display: none;
}

.arena-queue--matched {
    border-color: var(--brand-500);
    background-color: var(--brand-lo);
}

/* ── Footer ─────────────────────────────────────────────── */

.arena-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    padding-left: 10px;
    padding-right: 8px;
    flex-shrink: 0;
}

.arena-footer__hint {
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

.arena-footer__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.arena-action {
    height: 22px;
    margin-left: 4px;
    flex-shrink: 0;
}

.arena-action--wide {
    min-width: 96px;
}
