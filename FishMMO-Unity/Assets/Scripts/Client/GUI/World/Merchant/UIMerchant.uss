/*
    UIMerchant.uss
    Layout for the merchant panel. Colours come from FishMMO-Theme.uss.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.
*/
.merchant-panel {
    position: absolute;
    left: 50%; top: 50%; translate: -50% -50%;
    width: 320px;
    height: 400px;
}

.merchant-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 10px;
    padding-right: 8px;
    flex-shrink: 0;
}

.merchant-tabs {
    flex-direction: row;
    height: 28px;
    padding-left: 4px;
    padding-right: 4px;
}

.merchant-tab {
    flex-grow: 1;
    margin-right: 2px;
    font-size: 11px;
}

.merchant-scroll {
    flex-grow: 1;
    padding: 4px;
}

.merchant-list {
    flex-direction: column;
}

.merchant-entry {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 4px;
}

.merchant-entry:hover {
    background-color: var(--abyss-700);
}

.merchant-entry__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.merchant-entry__name {
    flex-grow: 1;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: var(--abyss-100);
}


/* ═══════════════════════════════════════════════════════════
   HEADER AND EMPTY STATE
   ═══════════════════════════════════════════════════════════ */

.merchant-header__icon {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    flex-shrink: 0;
}

.merchant-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    overflow: hidden;
}

.merchant-count {
    min-width: 24px;
    height: 16px;
    padding-left: 6px;
    padding-right: 6px;
    flex-shrink: 0;
}

/*
    Shown when the list behind it has nothing in it. A blank scroll area reads
    as a panel that failed to load; a sentence reads as a panel that loaded and
    found nothing.
*/
.merchant-empty {
    margin-top: 22px;
    margin-bottom: 22px;
}

/*
    A stacked title + subtitle needs its two line boxes pinned. Unity gives a
    Label a generous intrinsic height, so an unconstrained pair measures taller
    than the header that contains it — the subtitle then overflows into
    whatever sits below the header, which is exactly what it did.
*/
.merchant-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.merchant-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   ENTRY PRICE AND SELECTION
   ═══════════════════════════════════════════════════════════ */

/*
    The price sits at the trailing edge of a row rather than only in the tooltip, because the
    purchase flow now asks for a quantity and a player choosing one wants the unit price in
    front of them while they do it.
*/
.merchant-entry__price {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--gold);
}

/*
    Selection is a visible state because it is now load-bearing: the footer acts on the
    selected row, and a footer that says "Buy" with no indication of what would be bought is
    how a player buys the wrong thing.
*/
.merchant-entry--selected {
    background-color: var(--brand-mid);
    border-width: 1px;
    border-color: var(--brand-border);
}

/* ═══════════════════════════════════════════════════════════
   TRANSACTION FOOTER
   Quantity selector plus an explicit confirm. Hidden until a row is selected.
   ═══════════════════════════════════════════════════════════ */

.merchant-transaction {
    flex-direction: column;
    flex-shrink: 0;
    padding: 6px;
    border-top-width: 1px;
    border-top-color: var(--edge-light);
    background-color: var(--abyss-800);
}

.merchant-transaction__name {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    height: 16px;
    flex-shrink: 0;
    overflow: hidden;
}

.merchant-quantity-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    height: 24px;
    flex-shrink: 0;
}

.merchant-qty-btn {
    width: 26px;
    height: 22px;
    margin-right: 3px;
    font-size: 12px;
    flex-shrink: 0;
}

.merchant-qty-btn--max {
    width: 38px;
}

.merchant-qty-field {
    width: 54px;
    height: 22px;
    margin-right: 3px;
    flex-shrink: 0;
}

.merchant-transaction__total {
    flex-grow: 1;
    font-size: 12px;
    -unity-text-align: middle-right;
    color: var(--gold);
}

.merchant-transaction__actions {
    flex-direction: row;
    margin-top: 5px;
    flex-shrink: 0;
}

.merchant-transaction__confirm {
    flex-grow: 1;
    height: 24px;
    margin-right: 4px;
}

.merchant-transaction__cancel {
    width: 74px;
    height: 24px;
}

/*
    One status line, used for both the "waiting for the server" state and the result. It keeps
    its height when empty so the footer does not jump every time a sale completes.
*/
.merchant-status {
    margin-top: 4px;
    height: 13px;
    font-size: 10px;
    flex-shrink: 0;
    overflow: hidden;
}
