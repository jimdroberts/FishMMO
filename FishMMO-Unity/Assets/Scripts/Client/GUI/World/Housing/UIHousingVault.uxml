<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:fish="FishMMO.Client">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  UIHousingVault.uxml   —   FishMMO House Vault                ║
    ║                                                              ║
    ║  What stood on land its owner lost or gave up. Opened from    ║
    ║  the bank (a button that shows only when the vault holds      ║
    ║  something). Things come OUT only: retrieve (pay the fee,     ║
    ║  kits go to the bank) or give up. Nothing goes back in.       ║
    ║                                                              ║
    ║  Stylesheet load order (MUST be first-to-last):              ║
    ║    1. FishMMO-Theme.uss  — colors, fonts, transitions        ║
    ║    2. UIHousingVault.uss — sizes, flex, spacing              ║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIHousingVault.uss" />

    <ui:VisualElement name="panel-root" class="fish-panel vault-panel">

        <ui:VisualElement name="panel-header" class="fish-panel__header vault-header">
            <ui:Label name="header-title" class="fish-panel__title vault-header__title" text="HOUSE VAULT" />
            <ui:Button name="close-button" class="fish-close-btn" text="✕" />
        </ui:VisualElement>

        <ui:Label class="fish-label fish-label--secondary vault-intro"
                  text="What stood on land you lost or gave up. Retrieve it into your bank for the fee shown; the fee grows each day it waits." />

        <ui:ScrollView name="vault-list" class="fish-scroll vault-list"
                       vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" mode="Vertical" />
        <ui:Label name="vault-empty" class="fish-label fish-label--muted vault-empty" text="Your vault is empty." />

        <ui:VisualElement name="panel-footer" class="fish-panel__footer vault-footer">
            <ui:Label name="vault-message" class="fish-label fish-label--accent vault-message" text="" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
