/*
    UIAbilities.uss
    Layout for the abilities panel. Colours come from FishMMO-Theme.uss.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.
*/
.ability-panel {
    position: absolute;
    left: 50%; top: 50%; translate: -50% -50%;
    width: 360px;
    height: 420px;
}

.ability-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 10px;
    padding-right: 8px;
    flex-shrink: 0;
}

.ability-tabs {
    flex-direction: row;
    height: 28px;
    padding-left: 4px;
    padding-right: 4px;
}

.ability-tab {
    flex-grow: 1;
    margin-right: 2px;
    font-size: 11px;
}

.ability-scroll {
    flex-grow: 1;
    padding: 6px;
}

.ability-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.ability-slot {
    width: 48px;
    height: 48px;
    margin: 3px;
}

.ability-slot__icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ═══════════════════════════════════════════════════════════
   TEMPLATES AND EFFECTS
   Slots on the Templates and Effects tabs are not abilities and cannot go on the
   hotkey bar. They used to look identical to the ones that can (issue #247), so
   the difference is drawn: a dimmed icon, a muted border, and a corner badge that
   names what the slot holds.
   ═══════════════════════════════════════════════════════════ */

.ability-slot--template,
.ability-slot--effect {
    border-color: var(--abyss-500);
    border-top-color: var(--abyss-500);
    border-bottom-color: var(--abyss-500);
}

.ability-slot--template > .ability-slot__icon,
.ability-slot--effect > .ability-slot__icon {
    opacity: 0.7;
}

.ability-slot__badge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    font-size: 8px;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    color: var(--text-bright);
    background-color: var(--scrim-80);
}

.ability-slot--template > .ability-slot__badge {
    color: var(--gold);
}

.ability-slot--effect > .ability-slot__badge {
    color: var(--brand-300);
}

/*
    One line under the list. Keeps its height when empty so the panel does not
    jump between a hint and a refusal.
*/
.ability-status {
    height: 13px;
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 4px;
    font-size: 10px;
    flex-shrink: 0;
    overflow: hidden;
}

/* ═══════════════════════════════════════════════════════════
   HEADER AND EMPTY STATE
   ═══════════════════════════════════════════════════════════ */

.ability-header__icon {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    flex-shrink: 0;
}

.ability-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    overflow: hidden;
}

.ability-count {
    min-width: 24px;
    height: 16px;
    padding-left: 6px;
    padding-right: 6px;
    flex-shrink: 0;
}

/* Sizing only — .fish-close-btn carries the colours, border and hover. */
.ability-close-btn {
    margin-left: 8px;
}

/*
    Shown when the list behind it has nothing in it. A blank scroll area reads
    as a panel that failed to load; a sentence reads as a panel that loaded and
    found nothing.
*/
.ability-empty {
    margin-top: 22px;
    margin-bottom: 22px;
}

/*
    A stacked title + subtitle needs its two line boxes pinned. Unity gives a
    Label a generous intrinsic height, so an unconstrained pair measures taller
    than the header that contains it — the subtitle then overflows into
    whatever sits below the header, which is exactly what it did.
*/
.ability-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.ability-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}
