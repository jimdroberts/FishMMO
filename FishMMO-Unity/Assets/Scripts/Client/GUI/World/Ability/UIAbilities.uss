/*
    UIAbilities.uss
    Layout for the abilities panel. Colours come from FishMMO-Theme.uss.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.

    Wider and taller than the icon grid this replaced: the list carries a name and a line of
    stats per entry, and the details pane beside it renders the selected entry in full.
*/
.ability-panel {
    position: absolute;
    left: 50%; top: 50%; translate: -50% -50%;
    width: 660px;
    height: 480px;
}

.ability-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 10px;
    padding-right: 8px;
    flex-shrink: 0;
}

.ability-header__titles {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.ability-count {
    margin-right: 6px;
}

.ability-tabs {
    flex-direction: row;
    height: 28px;
    padding-left: 4px;
    padding-right: 4px;
    flex-shrink: 0;
}

.ability-tab {
    flex-grow: 1;
    margin-right: 2px;
    font-size: 12px;
}

.ability-toolbar {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 4px;
    flex-shrink: 0;
}

.ability-search__label {
    font-size: 10px;
    color: var(--abyss-300);
    margin-right: 4px;
}

.ability-search {
    width: 150px;
    margin-right: 10px;
}

.ability-listpane {
    width: 50%;
}

.ability-filters {
    flex-direction: row;
    flex-grow: 1;
}

.ability-filter {
    height: 20px;
    font-size: 10px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 4px;
    flex-grow: 0;
}

.ability-body {
    flex-direction: row;
    flex-grow: 1;
    padding: 6px;
}

.ability-listpane {
    width: 46%;
    flex-shrink: 0;
    margin-right: 6px;
}

.ability-scroll {
    flex-grow: 1;
}

.ability-list {
    flex-direction: column;
}

.ability-empty {
    margin-top: 12px;
}

/*
    One row per entry: icon, then name over a line of stats, then a badge saying what kind of
    entry it is. The icon grid this replaces could show nothing but the icon, so two entries
    that differed only in their numbers looked identical.
*/
.ability-entry {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 2px;
}

.ability-entry__icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-entry__text {
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
}

.ability-entry__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--abyss-100);
}

.ability-entry__meta {
    font-size: 10px;
    color: var(--abyss-300);
    overflow: hidden;
}

.ability-entry__badge {
    font-size: 8px;
    padding: 1px 5px;
    border-radius: 3px;
    flex-shrink: 0;
    color: var(--abyss-100);
    background-color: var(--brand-mid);
    -unity-text-align: middle-center;
}

.ability-entry__badge--craft   { background-color: rgba(216, 149, 42, 0.35); }
.ability-entry__badge--effect  { background-color: rgba(63, 201, 192, 0.30); }

/* A knowledge entry is not a usable ability, and the dimmed icon says so before anything is read. */
.ability-entry--knowledge .ability-entry__icon {
    opacity: 0.65;
}

.ability-details {
    flex-grow: 1;
    padding: 8px;
}

.ability-details__scroll {
    flex-grow: 1;
}

.ability-details__content {
    flex-direction: column;
}

.ability-details__empty {
    margin-top: 16px;
}

.ability-status {
    height: 16px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
    white-space: normal;
}
