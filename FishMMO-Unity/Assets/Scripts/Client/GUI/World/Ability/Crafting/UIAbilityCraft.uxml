<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../../FishMMO-Theme.uss" />
    <Style src="../../../Shared/Tooltip/UITooltipView.uss" />
    <Style src="UIAbilityCraft.uss" />
    <ui:VisualElement name="craft-root" class="craft-root" picking-mode="Ignore">
        <ui:VisualElement name="craft-panel" class="fish-panel craft-panel">
            <ui:VisualElement name="panel-header" class="fish-panel__header craft-header">
                <ui:VisualElement class="fish-panel__icon" />
                <ui:VisualElement class="craft-header__titles">
                    <ui:Label text="ABILITY CRAFTING" class="fish-panel__title" />
                    <ui:Label name="craft-subtitle" text="Choose a base ability, then configure it with effects." class="fish-panel__subtitle" />
                </ui:VisualElement>
                <ui:Button name="craft-close-btn" text="✕" class="fish-close-btn" />
            </ui:VisualElement>

            <ui:VisualElement name="craft-body" class="craft-body">
                <!-- The recipe: what is being combined. -->
                <ui:VisualElement name="craft-recipe" class="craft-recipe">
                    <ui:Label text="BASE ABILITY" class="fish-col-head craft-section" />
                    <ui:Button name="craft-main-entry" class="fish-row craft-main" />

                    <ui:Label name="craft-slots-head" text="EFFECTS" class="fish-col-head craft-section" />
                    <ui:ScrollView name="craft-slot-scroll" class="fish-scroll craft-slot-scroll">
                        <ui:VisualElement name="craft-event-list" class="craft-event-list" />
                    </ui:ScrollView>
                    <ui:Label name="craft-slots-empty" text="" class="fish-empty craft-slots-empty" />
                </ui:VisualElement>

                <!--
                    The preview: what the craft would produce. Rendered from the composed
                    AbilitySummary by UITKTooltipView, so every stat carries what the chosen
                    effects changed it by.
                -->
                <ui:VisualElement name="craft-preview" class="fish-well craft-preview">
                    <ui:Label text="RESULT" class="fish-col-head craft-section" />
                    <ui:ScrollView name="craft-preview-scroll" class="fish-scroll craft-preview__scroll">
                        <ui:VisualElement name="craft-description" class="craft-description" />
                    </ui:ScrollView>
                    <ui:Label name="craft-preview-empty" text="Pick a base ability to see what it would become." class="fish-empty craft-preview__empty" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="craft-footer" class="craft-footer">
                <ui:VisualElement class="craft-cost-row">
                    <ui:Label name="craft-cost" text="Cost: —" class="craft-cost" />
                    <ui:Label name="craft-balance" text="" class="craft-balance" />
                </ui:VisualElement>
                <ui:Label name="craft-status" text="" class="fish-hint craft-status" />
                <ui:Button name="craft-confirm-btn" text="Craft Ability" class="fish-button craft-confirm-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
