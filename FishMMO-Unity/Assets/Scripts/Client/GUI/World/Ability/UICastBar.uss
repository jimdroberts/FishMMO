/*
    UICastBar.uss
    Layout only — base colours come from FishMMO-Theme.uss (.fish-bar).
*/

.castbar-root {
    width: 100%;
    height: 22px;
    position: relative;
}

/* The fill represents remaining cast time; width is driven from C# as a percentage. */
.castbar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: 3px;
    background-color: rgb(90, 150, 235);
}

/* Centered cast label drawn on top of the fill. */
.castbar-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(232, 234, 238);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
