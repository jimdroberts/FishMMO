/*
    UICastBar.uss
    Layout only — base colours come from FishMMO-Theme.uss (.fish-bar).
*/

/*
    A fixed, centred strip rather than width: 100%. Each panel is its own UIDocument whose root
    fills the screen, so a percentage width here resolved against the viewport and the cast bar
    stretched edge to edge. 220px matches .res-bar so the cast bar and the resource bars below
    it line up as one HUD block, which is how the uGUI ones sat at 160px against their 160px.
*/
.castbar-root {
    width: 220px;
    height: 22px;
    position: relative;
    align-self: center;
}

/* The fill represents remaining cast time; width is driven from C# as a percentage. */
.castbar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: 3px;
    background-color: var(--cast);
}

/* Centered cast label drawn on top of the fill. */
.castbar-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--text-bright);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
