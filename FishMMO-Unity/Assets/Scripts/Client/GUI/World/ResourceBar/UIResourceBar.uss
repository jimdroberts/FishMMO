/*
    UIResourceBar.uss
    Layout only — colours come from FishMMO-Theme.uss (.fish-bar, .fish-bar__fill--*).
*/

/*
    Each bar lives in its own UIDocument, so the three cannot be laid out relative to one
    another by a shared container — every panel root fills the screen independently. Left
    unanchored they all resolved to the same full-width strip across the top and drew on top
    of each other, so only whichever panel sorted last was visible and the other two looked
    like they were missing entirely. Anchoring each one explicitly is what keeps them apart.
*/
.res-bar {
    position: absolute;
    left: 24px;
    width: 160px;
    height: 20px;
}

/*
    Top-left, not bottom-left. They were at bottom 96/68/40 with left:24 — which is inside the
    chat panel, authored at left:24 bottom:40 with a 420x280 body and an opaque .fish-panel
    background. All three bars were laid out correctly the whole time and drawn underneath it.
    Measured: the health bar resolved to 160x20 at (24, 652) on a 768-tall screen, squarely
    within chat's rectangle.

    The top-left corner is free, and is where a player looks for their own resources anyway.
*/
.res-bar--hp   { top: 24px; }
.res-bar--mp   { top: 52px; }
.res-bar--stam { top: 80px; }

/* The fill grows left-to-right; width is driven from C# as a percentage. */
.res-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: 3px;
}

/* Centered value label drawn on top of the fill. */
.res-bar__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--text-bright);
    text-shadow: 0 1px 2px var(--edge-dark);
}
