/*
    UIResourceBar.uss
    Layout only — colours come from FishMMO-Theme.uss (.fish-bar, .fish-bar__fill--*).
*/

.res-bar {
    width: 100%;
    height: 22px;
    position: relative;
}

/* The fill grows left-to-right; width is driven from C# as a percentage. */
.res-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: 3px;
}

/* Centered value label drawn on top of the fill. */
.res-bar__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(232, 234, 238);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
