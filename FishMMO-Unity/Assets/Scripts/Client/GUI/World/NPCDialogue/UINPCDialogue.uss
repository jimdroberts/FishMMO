/*
    UINPCDialogue.uss
    Layout for the NPC dialogue panel. Colours come from FishMMO-Theme.uss.

    Speech is set against a leading accent rail — the visual convention for a
    quotation — so the NPC's words are distinguishable from the player's reply
    options below without either needing a label saying which is which.
*/

/*
    Anchored explicitly, low on the screen. Each panel is its own UIDocument
    whose root fills the screen, so a root with a size but no position resolves
    to the top-left corner. Sitting it low keeps the NPC visible while talking.
*/
.dialogue-panel {
    position: absolute;
    left: 50%;
    bottom: 12%;
    translate: -50% 0;
    width: 520px;
    max-height: 46%;
    flex-direction: column;
    flex-shrink: 0;
}

.dialogue-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.dialogue-header__icon {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    flex-shrink: 0;
}

.dialogue-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

/* Sizing only — .fish-close-btn carries the colours, border and hover. */
.dialogue-close-btn {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    padding: 0;
    margin-left: 8px;
}


.dialogue-body {
    flex-direction: row;
    padding: 12px;
    flex-grow: 1;
    min-height: 70px;
}

.dialogue-rail {
    margin-right: 10px;
    flex-shrink: 0;
}

.dialogue-text-scroll {
    flex-grow: 1;
}

.dialogue-text {
    white-space: normal;
    -unity-text-align: upper-left;
    font-size: 12px;
}

.dialogue-footer {
    flex-direction: column;
    padding: 8px;
    flex-shrink: 0;
}

/*
    Reply options, generated at runtime. Stacked full-width and left-aligned so
    they read as a list of things to say rather than a row of controls.
*/
.dialogue-choices {
    flex-direction: column;
}

.dialogue-choice {
    height: 26px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

/* Speaker name and the role line beneath it. */
.dialogue-speaker {
    flex-grow: 1;
    overflow: hidden;
}

.dialogue-role {
    flex-shrink: 0;
}

/*
    A stacked title + subtitle needs its two line boxes pinned. Unity gives a
    Label a generous intrinsic height, so an unconstrained pair measures taller
    than the header that contains it — the subtitle then overflows into
    whatever sits below the header, which is exactly what it did.
*/
.dialogue-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.dialogue-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}
