<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UINPCDialogue.uss" />
    <ui:VisualElement name="dialogue-root" class="fish-panel dialogue-panel">

        <ui:VisualElement name="panel-header" class="fish-panel__header dialogue-header">
            <ui:VisualElement class="fish-panel__icon dialogue-header__icon" />
            <ui:VisualElement class="dialogue-header__titles">
                <ui:Label name="dialogue-speaker" text="Speaker" class="fish-panel__title dialogue-speaker" />
                <ui:Label name="dialogue-role" text="" class="fish-panel__subtitle dialogue-role" />
            </ui:VisualElement>
            <ui:Button name="close-button" class="fish-close-btn dialogue-close-btn" text="✕" />
        </ui:VisualElement>

        <ui:VisualElement name="dialogue-body" class="dialogue-body">
            <ui:VisualElement class="fish-rail dialogue-rail" />
            <ui:ScrollView name="dialogue-text-scroll" class="fish-scroll dialogue-text-scroll">
                <ui:Label name="dialogue-text" text="" class="fish-label fish-label--secondary dialogue-text" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="panel-footer" class="fish-panel__footer dialogue-footer">
            <ui:VisualElement name="dialogue-choices" class="dialogue-choices" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
