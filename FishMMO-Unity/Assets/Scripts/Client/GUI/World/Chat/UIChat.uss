/*
    UIChat.uss
    Layout for the chat panel. Colours come from FishMMO-Theme.uss.
*/

/*
    Anchored bottom-right. Each panel is its own UIDocument whose root fills the screen, so a
    panel with a size but no position resolves to the top-left corner rather than anywhere
    meaningful — which is where this sat.
*/
.chat-panel {
    position: absolute;
    left: 24px;
    bottom: 40px;
    width: 420px;
    height: 280px;
}

.chat-tabs-bar {
    flex-direction: row;
    height: 24px;
    padding-left: 4px;
    padding-right: 4px;
}

.chat-tabs {
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;
}

.chat-tab {
    margin-right: 2px;
    font-size: 11px;
    padding-left: 8px;
    padding-right: 8px;
}

.chat-add-tab {
    width: 24px;
    font-size: 14px;
}

.chat-scroll {
    flex-grow: 1;
    padding: 4px;
}

.chat-messages {
    flex-direction: column;
}

.chat-message {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 1px;
}

/*
    middle-left on both halves of a line. A row is as tall as its tallest label,
    and a flex row stretches the shorter one to match -- a Label draws its text at
    the TOP of that stretched box by default, which is what made every line sit
    high in its own space. The two labels also differ in height whenever one wraps
    and the other does not, so without this the sender and the message it belongs
    to do not sit on the same baseline.
*/
.chat-message__name {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-right: 2px;
}

.chat-message__text {
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
    flex-shrink: 1;
}

/*
    No fixed height. The row used to be pinned to 26px with the field given flex-grow, and under
    that constraint the TextField's inner text element resolved to 380x0 — correct colour, correct
    font size, no height, so nothing was drawn and every keystroke went in invisibly. The login
    fields differ only in this: they size to their own content and have always rendered normally.
    Letting the row do the same is the shape that is known to work, rather than another attempt to
    force the inner element to fill a box it will not fill.
*/
.chat-input-row {
    min-height: 26px;
    padding: 2px 4px;
    flex-shrink: 0;
    /* UITK defaults flex-direction to column, not row as CSS does. With a single child that was
       invisible; the moment the channel selector joined the field it stacked above it instead of
       sitting beside it. */
    flex-direction: row;
    align-items: center;
}

.chat-input {
    flex-grow: 1;
}

/*
    Channel selector sitting to the left of the input. It names the channel a plain line will be
    sent on, so it has to hold its width rather than be squeezed by the field beside it — the
    input carries flex-grow, and without flex-shrink: 0 here the label collapses as soon as the
    panel narrows.
*/
.chat-channel-selector {
    flex-shrink: 0;
    min-width: 54px;
    height: 20px;
    margin-right: 4px;
    padding: 0 6px;
    font-size: 10px;
}
