/*
    UIChatChannelPicker.uss
    Floating channel toggle / tab rename overlay.
*/

/*
    Transparent, full-viewport wrapper around the floating menu, so it must never be picked.
    picking-mode="Ignore" is set on it in the UXML (it is a UXML attribute, not a USS property).
    A pickable root here reports focus wherever the pointer is, which both kills the
    close-when-the-pointer-leaves behaviour driven off UITKControl.OnLoseFocus and swallows every
    click meant for the panels underneath. Children stay pickable; picking is not inherited.
*/
.channel-picker-root {
    flex-grow: 1;
}

.channel-picker-panel {
    position: absolute;
    min-width: 160px;
    padding: 8px;
}

.channel-name-input {
    margin-bottom: 6px;
}

.channel-list {
    flex-direction: column;
}

.channel-toggle {
    margin: 1px 0;
}
