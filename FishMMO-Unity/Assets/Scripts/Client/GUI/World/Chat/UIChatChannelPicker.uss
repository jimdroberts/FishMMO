/*
    UIChatChannelPicker.uss
    Floating channel toggle / tab rename overlay.
*/

/*
    Transparent, full-viewport wrapper around the floating menu, so it must never be picked.
    picking-mode="Ignore" is set on it in the UXML (it is a UXML attribute, not a USS property).
    A pickable root here reports focus wherever the pointer is, which both kills the
    close-when-the-pointer-leaves behaviour driven off UITKControl.OnLoseFocus and swallows every
    click meant for the panels underneath. Children stay pickable; picking is not inherited.
*/
.channel-picker-root {
    flex-grow: 1;
}

.channel-picker-panel {
    position: absolute;
    min-width: 160px;
    padding: 8px;
    /* The panel is placed at the click point, so without a ceiling a list this tall simply
       runs off the bottom of the screen. Cap it against the viewport and let the list scroll. */
    max-height: 90%;
}

.channel-name-input {
    margin-bottom: 6px;
}

.channel-list {
    flex-direction: column;
    /* UITK defaults flex-shrink to 0, so without these the ScrollView refuses to give up
       height and overflows the capped panel instead of scrolling inside it. */
    flex-shrink: 1;
    min-height: 0;
}

.channel-toggle {
    margin: 1px 0;
}

/*
    The channel names are this menu's actual content — the list of things being chosen — rather
    than captions for some other control, so they carry primary text weight instead of the
    --abyss-200 the theme gives a BaseField label by default.
*/
.channel-toggle > .unity-base-field__label {
    color: var(--abyss-100);
}
