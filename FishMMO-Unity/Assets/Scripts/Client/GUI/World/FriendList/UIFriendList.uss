/*
    UIFriendList.uss
    Layout for the friend list panel. Colours come from FishMMO-Theme.uss.
*/

.friend-panel {
    width: 240px;
    height: 320px;
}

.friend-header {
    height: 28px;
    padding-left: 8px;
    justify-content: center;
}

.friend-scroll {
    flex-grow: 1;
    padding: 4px;
}

.friend-list {
    flex-direction: column;
}

.friend-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 4px;
}

.friend-row:hover {
    background-color: rgb(28, 31, 34);
}

.friend-row__name {
    flex-grow: 1;
    font-size: 11px;
    -unity-text-align: middle-left;
    color: rgb(200, 205, 214);
}

.friend-row__status {
    width: 56px;
    font-size: 10px;
    -unity-text-align: middle-left;
    color: rgb(138, 147, 162);
}

.friend-row__status--online {
    color: rgb(46, 204, 113);
}

.friend-row__remove {
    width: 18px;
    height: 18px;
    font-size: 10px;
    padding: 0;
}

.friend-footer {
    flex-direction: row;
    height: 30px;
    padding: 4px;
}

.friend-action {
    flex-grow: 1;
    font-size: 10px;
}
