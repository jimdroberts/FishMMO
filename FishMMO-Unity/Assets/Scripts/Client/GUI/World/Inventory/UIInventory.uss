/*
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    UIInventory.uss
    Inventory Panel  —  Structure & Layout only
    Unity UIToolkit  (Unity 6.x LTS)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    PURPOSE
    ───────
    Sizing, spacing, flex directions and positioning for the
    inventory panel. NO colors or fonts here — those live in
    FishMMO-Theme.uss.

    LOAD ORDER in UXML (required):
        <ui:Style src="FishMMO-Theme.uss" />
        <ui:Style src="UIInventory.uss" />
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
*/


/* ═══════════════════════════════════════════════════════════
   PANEL ROOT
   ═══════════════════════════════════════════════════════════ */

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.
*/
.inv-panel {
    position: absolute;
    right: 2%; top: 46%; translate: 0 -50%;
    width: 280px;
    height: 320px;
    flex-direction: column;
    flex-shrink: 0;
}


/* ═══════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════ */

.inv-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.inv-header__left {
    flex-direction: row;
    align-items: center;
    flex: 1;
}

.inv-header__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
}

.inv-header__title {
    flex-shrink: 0;
}

.inv-close-btn {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    padding: 0;
}


/* ═══════════════════════════════════════════════════════════
   BODY : scrollable wrapping slot grid
   ═══════════════════════════════════════════════════════════ */

.inv-scroll {
    flex: 1;
    padding: 10px;
}

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}


/* ═══════════════════════════════════════════════════════════
   INVENTORY SLOT
   ═══════════════════════════════════════════════════════════ */

/*
    44px. The uGUI slot was 40 units; 52 here rendered close to twice that once the reference
    resolution is taken into account, and the panel size followed from it. 44 keeps item icons
    comfortably readable while bringing the grid back near its original footprint.
*/
.inv-slot {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    position: relative;
    margin: 3px;
    align-items: center;
    justify-content: center;
}

/* Icon fills the slot */
.inv-slot__icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
}

/* Stack count badge — bottom-right corner */
.inv-slot__amount {
    position: absolute;
    bottom: 2px;
    right: 2px;
    padding-left: 2px;
    padding-right: 2px;
}

/* Lock: full-slot overlay */
.inv-slot__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/*
    Waiting on the server, as opposed to locked by the container.
    Both mean "this slot is busy", so they share one overlay element and differ only in
    colour: a container lock is a refusal (danger tint, inherited from .fish-slot__lock),
    an in-flight request is just a wait. The override is a neutral scrim rather than a
    second danger tint so the player can tell a pending click from a rejected one.
*/
.inv-slot__lock--pending {
    background-color: var(--scrim-60);
    border-color: var(--brand-border);
    border-width: 1px;
}


/* ═══════════════════════════════════════════════════════════
   UTILITY
   ═══════════════════════════════════════════════════════════ */

.inv-hidden {
    display: none;
}


/* ═══════════════════════════════════════════════════════════
   HEADER TITLES
   ═══════════════════════════════════════════════════════════ */

.inv-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

/* ═══════════════════════════════════════════════════════════
   EMPTY STATE
   ═══════════════════════════════════════════════════════════ */

/*
    Shown in place of the grid when nothing is carried. A grid of empty slots
    already reads as "no items", but only once the player counts them — a
    sentence says it immediately, and distinguishes empty from not-yet-loaded.
*/
.inv-empty {
    margin-top: 20px;
    margin-bottom: 20px;
}

/* ═══════════════════════════════════════════════════════════
   FOOTER : capacity readout
   ═══════════════════════════════════════════════════════════ */

/*
    Used / free either side of a fill bar. The bar is the glanceable form of
    the same two numbers — a player who is nearly full sees it before reading
    either figure, which is the whole point of putting it between them.
*/
.inv-footer {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
}

.inv-footer__stat {
    width: 56px;
    flex-shrink: 0;
}

.inv-footer__stat--right {
    -unity-text-align: middle-right;
}

.inv-capacity {
    flex-grow: 1;
    height: 6px;
    margin-left: 8px;
    margin-right: 8px;
}

.inv-capacity__fill {
    height: 100%;
    width: 0;
}

/* Slot-usage line under the title. */
.inv-header__subtitle {
    flex-shrink: 0;
}

/*
    A stacked title + subtitle needs its two line boxes pinned. Unity gives a
    Label a generous intrinsic height, so an unconstrained pair measures taller
    than the header that contains it — the subtitle then overflows into
    whatever sits below the header, which is exactly what it did.
*/
.inv-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.inv-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}
