/*
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    UIInventory.uss
    Inventory Panel  —  Structure & Layout only
    Unity UIToolkit  (Unity 6.x LTS)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    PURPOSE
    ───────
    Sizing, spacing, flex directions and positioning for the
    inventory panel. NO colors or fonts here — those live in
    FishMMO-Theme.uss.

    LOAD ORDER in UXML (required):
        <ui:Style src="FishMMO-Theme.uss" />
        <ui:Style src="UIInventory.uss" />
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
*/

/* ═══════════════════════════════════════════════════════════
   PANEL ROOT
   ═══════════════════════════════════════════════════════════ */

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.
*/
.inv-panel {
    position: absolute;
    right: 2%; top: 46%; translate: 0 -50%;
    width: 280px;
    height: 320px;
    flex-direction: column;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════ */

.inv-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.inv-header__left {
    flex-direction: row;
    align-items: center;
    flex: 1;
}

.inv-header__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
}

.inv-header__title {
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   BODY : scrollable wrapping slot grid
   ═══════════════════════════════════════════════════════════ */

.inv-scroll {
    flex: 1;
    padding: 10px;
}

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}

/* ═══════════════════════════════════════════════════════════
   INVENTORY SLOT
   ═══════════════════════════════════════════════════════════ */

/*
    44px. The uGUI slot was 40 units; 52 here rendered close to twice that once the reference
    resolution is taken into account, and the panel size followed from it. 44 keeps item icons
    comfortably readable while bringing the grid back near its original footprint.
*/
.inv-slot {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    position: relative;
    margin: 3px;
    align-items: center;
    justify-content: center;
}

/* Icon fills the slot */
.inv-slot__icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
}

/* Stack count badge — bottom-right corner */
.inv-slot__amount {
    position: absolute;
    bottom: 2px;
    right: 2px;
    padding-left: 2px;
    padding-right: 2px;
}

/* Lock: full-slot overlay */
.inv-slot__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/*
    Waiting on the server, as opposed to locked by the container.
    Both mean "this slot is busy", so they share one overlay element and differ only in
    colour: a container lock is a refusal (danger tint, inherited from .fish-slot__lock),
    an in-flight request is just a wait. The override is a neutral scrim rather than a
    second danger tint so the player can tell a pending click from a rejected one.
*/
.inv-slot__lock--pending {
    background-color: var(--scrim-60);
    border-color: var(--brand-border);
    border-width: 1px;
}

/* ═══════════════════════════════════════════════════════════
   UTILITY
   ═══════════════════════════════════════════════════════════ */

.inv-hidden {
    display: none;
}

/* ═══════════════════════════════════════════════════════════
   HEADER TITLES
   ═══════════════════════════════════════════════════════════ */

.inv-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

/* ═══════════════════════════════════════════════════════════
   FOOTER : capacity readout
   ═══════════════════════════════════════════════════════════ */

/*
    One readout, so the row is a single item. It was built as used / bar / free
    and the two counts and the bar have all moved to the header, where the
    capacity they describe actually belongs.
*/
.inv-footer {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
}

/*
    The character's currency, drawn as the same chip the equipment panel uses for
    HP / MP / STM so the two panels read alike. The name and value are filled in
    from the attribute template configured on the panel.
*/
.inv-currency {
    flex-direction: row;
    align-items: center;
}

/* Currency is gold everywhere else it appears; it should be gold here too. */
.inv-currency__dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: var(--gold);
}

/* Same spacing as .eq-chip__label, so the two panels' chips line up when read together. */
.inv-currency__name {
    margin-right: 3px;
}

/* The one departure from the equipment chip: currency is gold wherever else it is drawn. */
.inv-currency__value {
    color: var(--gold);
}

/* ═══════════════════════════════════════════════════════════
   HEADER : capacity bar
   ═══════════════════════════════════════════════════════════ */

/*
    Sits under the title where the plain count used to be, and is drawn the way
    the resource bars are: track from the theme, fill driven from C# as a
    percentage, count centred over both.

    The height is pinned because the header gives it a fixed 44px to live in —
    the title's 15px line plus this is what that header has to carry, and a bar
    that measured itself would take its height from the label inside it.
*/
.inv-capacity {
    height: 12px;
    width: 100%;
    margin-top: 2px;
    flex-shrink: 0;
}

/* Grows left-to-right; width is set from C#. */
.inv-capacity__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-radius: 2px;
}

/*
    The count, centred on the bar rather than beside it. Colour, weight and the text shadow come
    from .fish-bar__label in the theme, the same way the target and pet frames do it; only the
    fill and the size override are here.
*/
.inv-capacity__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 9px;
}

/*
    A stacked title + bar needs the title's line box pinned. Unity gives a Label
    a generous intrinsic height, so an unconstrained pair measures taller than
    the header that contains it and overflows into whatever sits below.
*/
.inv-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}
