/*
    UIReportPlayer.uss
    Layout for the report-a-player form. Colours come from FishMMO-Theme.uss.
*/

/*
    A dimmed full-screen ground, as the shared dialogs use. The form asks the player to stop and
    write something; a window the world keeps moving behind reads as one they can ignore.
*/
.report-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--overlay-dim);
}

.report-panel {
    width: 420px;
    flex-direction: column;
    flex-shrink: 0;
}

.report-header {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 12px;
    padding-right: 8px;
    flex-shrink: 0;
}

.report-header__icon {
    width: 11px;
    height: 11px;
    margin-right: 9px;
    flex-shrink: 0;
}

/* The name is player-chosen and can be long; it gives way before the close button does. */
.report-title {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.report-close-btn {
    margin-left: 10px;
}

.report-body {
    flex-direction: column;
    padding-top: 14px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
}

/*
    The default theme pads every Label; these captions sit directly over their controls and the
    padding would float them halfway between two rows.
*/
.report-caption {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 3px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.report-reason {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.report-caption-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.report-counter {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 3px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: lower-right;
}

/*
    A text area, sized rather than sized-to-content: it scrolls what does not fit. The theme's
    single-line inputs centre their text vertically, which in a box this tall would park the
    first line in the middle; the description starts at the top and wraps.

    No compact class. That class trims the inner padding a pinned single-line field cannot
    afford; a 130px box has room for it, and TextInputHeightTests exempts text areas for the same
    reason.
*/
.report-description {
    height: 130px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    white-space: normal;
}

.report-description > #unity-text-input {
    -unity-text-align: upper-left;
}

.report-description > #unity-text-input .unity-text-element {
    white-space: normal;
}

.report-hint {
    white-space: normal;
    margin-left: 0;
    margin-right: 0;
    margin-top: 8px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 10px;
}

/* Reserves its line so a refusal appearing does not push the buttons down under the cursor. */
.report-status {
    white-space: normal;
    min-height: 16px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.report-buttons {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
}

.report-button {
    min-width: 92px;
    height: 26px;
    margin-left: 6px;
    flex-shrink: 0;
}
