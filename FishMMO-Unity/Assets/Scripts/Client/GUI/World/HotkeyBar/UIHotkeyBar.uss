/*
    UIHotkeyBar.uss
    Layout for the hotkey bar. Colours/borders for the slot come from FishMMO-Theme.uss
    (slots reuse the .fish-slot look where useful; cooldown/label are bar-specific).
*/

/*
    Fills the panel and pushes the strip to the bottom edge. Without flex-grow the root
    collapses to the height of its contents, and a zero-height element sits at the top of
    the screen — which is where the bar was appearing. justify-content places it along the
    vertical axis, so flex-end is what puts it at the bottom rather than centred.

    Being full-viewport is also why it must never be picked. picking-mode="Ignore" is set on it
    in the UXML (it is a UXML attribute, not a USS property). Without that, this root is the
    topmost pickable element over the whole screen for every HUD panel at the same sorting order,
    and UITKControl.HasFocus — which asks the panel what is under the cursor — answers true
    everywhere. Everything gated on UIManager.ControlHasFocus() then stops: world/target clicks,
    the Interact action, hotkey ability activation and dropping a dragged item into the world.
    Children stay pickable; picking is not inherited.
*/
.hotkey-bar {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 24px;
    background-color: var(--clear);
}

/* Horizontal strip of hotkey slots. */
.hotkey-list {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

/* A single hotkey slot. */
.hotkey-slot {
    width: 48px;
    height: 48px;
    margin-right: 3px;
    border-width: 1px;
    border-color: var(--abyss-500);
    border-radius: 6px;
    background-color: var(--abyss-700);
    overflow: hidden;
}

.hotkey-slot:hover {
    border-color: var(--brand-500);
}

/* Assigned item / ability icon. */
.hotkey-slot__icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

/* Cooldown sweep overlay (darkens from the top, height driven from C#). */
.hotkey-slot__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background-color: var(--scrim-65);
}

/* Key-map label in the lower-right corner. */
.hotkey-slot__label {
    position: absolute;
    right: 2px;
    bottom: 1px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    color: var(--abyss-100);
    text-shadow: 0 1px 1px var(--edge-dark);
}
