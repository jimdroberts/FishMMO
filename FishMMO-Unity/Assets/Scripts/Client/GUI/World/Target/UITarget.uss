/*
    UITarget.uss
    Layout for the target frame. Colours come from FishMMO-Theme.uss; the buff
    icons reuse the .buff-group classes from UIBuffContainer.uss.

    Level, name and faction on one line above a health bar. Level leads because
    it is the first thing that decides whether a fight is worth taking; faction
    trails because it is a qualifier on the name, not on the threat.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the
    screen, so a root with a size but no position resolves to the top-left
    corner. Top-centre, matching the uGUI target frame.
*/
.target-panel {
    position: absolute;
    left: 50%;
    top: 6%;
    translate: -50% 0;
    width: 260px;
    flex-direction: column;
    flex-shrink: 0;
    padding: 7px;
}

.target-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
    flex-shrink: 0;
}

.target-level {
    min-width: 22px;
    height: 15px;
    padding-left: 4px;
    padding-right: 4px;
    margin-right: 7px;
    flex-shrink: 0;
}

/*
    Colour is written inline from C# — it carries the target's faction standing,
    which is a per-target fact the stylesheet cannot know.
*/
.target-name {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-shadow: 0 1px 2px var(--edge-dark);
}

.target-faction {
    height: 15px;
    padding-left: 5px;
    padding-right: 5px;
    margin-left: 7px;
    flex-shrink: 0;
}

.target-health {
    height: 15px;
    position: relative;
    flex-shrink: 0;
}

.target-health-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.target-health-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 9px;
}

/*
    Buff icons the target is carrying, generated at runtime from the SERVER-filtered observed
    list. Two strips, buffs above debuffs, so a long debuff bar cannot push a defensive cooldown
    off the row the player is watching. Both reuse .buff-group from UIBuffContainer.uss.
*/
.target-buff-list {
    margin-top: 5px;
    flex-shrink: 0;
}

.target-debuff-list {
    margin-top: 2px;
}
