<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="../Buff/UIBuffContainer.uss" />
    <Style src="UITarget.uss" />
    <ui:VisualElement name="target-root" class="target-panel">

        <ui:VisualElement name="target-card-pinned" class="fish-panel target-card target-card--pinned">
            <ui:VisualElement name="target-top" class="target-top">
                <ui:Label name="target-pin-badge" text="PINNED" class="fish-badge fish-badge--accent target-pin-badge" />
                <ui:Label name="target-level" text="" class="fish-badge target-level" />
                <ui:Label name="target-name" text="Target" class="target-name" />
                <ui:Label name="target-faction" text="" class="fish-badge target-faction" />
            </ui:VisualElement>

            <ui:VisualElement name="target-health" class="fish-bar target-health">
                <ui:VisualElement name="target-health-fill" class="fish-bar__fill fish-bar__fill--hp target-health-fill" />
                <ui:Label name="target-health-text" text="" class="fish-bar__label target-health-text" />
            </ui:VisualElement>

            <ui:VisualElement name="target-buff-list" class="buff-list target-buff-list" />
            <ui:VisualElement name="target-debuff-list" class="buff-list target-buff-list target-debuff-list" />
        </ui:VisualElement>

        <ui:VisualElement name="target-card-hover" class="fish-panel target-card">
            <ui:VisualElement name="target-top" class="target-top">
                <ui:Label name="target-level" text="" class="fish-badge target-level" />
                <ui:Label name="target-name" text="Target" class="target-name" />
                <ui:Label name="target-faction" text="" class="fish-badge target-faction" />
            </ui:VisualElement>

            <ui:VisualElement name="target-health" class="fish-bar target-health">
                <ui:VisualElement name="target-health-fill" class="fish-bar__fill fish-bar__fill--hp target-health-fill" />
                <ui:Label name="target-health-text" text="" class="fish-bar__label target-health-text" />
            </ui:VisualElement>

            <ui:VisualElement name="target-buff-list" class="buff-list target-buff-list" />
            <ui:VisualElement name="target-debuff-list" class="buff-list target-buff-list target-debuff-list" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
