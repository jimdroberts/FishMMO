<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIMenu.uss" />
    <ui:VisualElement name="menu-root" class="menu-root">
        <ui:VisualElement name="menu-panel" class="fish-panel fish-panel--alert menu-panel">

            <ui:VisualElement name="panel-header" class="fish-panel__header menu-header">
                <ui:VisualElement class="fish-panel__icon menu-header__icon" />
                <ui:Label text="GAME MENU" class="fish-panel__title" />
            </ui:VisualElement>

            <ui:VisualElement name="menu-body" class="menu-body">
                <ui:Button name="menu-close-btn" text="Resume" class="fish-button fish-button--primary menu-action" />
                <ui:Button name="menu-options-btn" text="Options" class="fish-button menu-action" />
                <ui:Button name="menu-channels-btn" text="Channels" class="fish-button menu-action" />
                <ui:VisualElement class="fish-divider menu-sep" />
                <ui:Button name="menu-quit-to-login-btn" text="Quit to Login" class="fish-button menu-action" />
                <ui:Button name="menu-quit-btn" text="Quit to Desktop" class="fish-button fish-button--danger menu-action" />
            </ui:VisualElement>

            <ui:VisualElement name="panel-footer" class="fish-panel__footer menu-footer">
                <ui:Label name="menu-hint" text="Esc closes this menu" class="fish-hint menu-hint" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
