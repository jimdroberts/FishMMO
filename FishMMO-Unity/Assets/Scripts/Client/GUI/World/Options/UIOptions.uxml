<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIOptions.uss" />
    <ui:VisualElement name="options-root" class="options-root">
        <ui:VisualElement name="options-panel" class="fish-panel options-panel">
            <ui:VisualElement name="panel-header" class="fish-panel__header options-header">
                <ui:VisualElement class="fish-panel__icon options-header__icon" />
                <ui:Label text="OPTIONS" class="fish-panel__title" />
            </ui:VisualElement>

            <!--
                One page per tab. Only the active page is displayed; UITKOptions owns which that
                is. Pages exist in the tree whether or not they are shown, so every control is
                resolved once in OnStarting rather than being rebuilt whenever a tab is selected.
            -->
            <ui:VisualElement name="options-tabs" class="options-tabs">
                <ui:Button name="options-tab-display" text="Display" class="fish-tab options-tab" />
                <ui:Button name="options-tab-audio" text="Audio" class="fish-tab options-tab" />
                <ui:Button name="options-tab-gameplay" text="Gameplay" class="fish-tab options-tab" />
                <ui:Button name="options-tab-controls" text="Key Bindings" class="fish-tab options-tab" />
                <ui:Button name="options-tab-interface" text="UI" class="fish-tab options-tab" />
            </ui:VisualElement>

            <!-- ══ Display ═══════════════════════════════════════ -->
            <!--
                Display settings are staged, not applied on change. A bad mode can leave the
                player unable to see the control that would undo it, so nothing here takes
                effect until Apply, and Apply arms a countdown that puts it back.
            -->
            <ui:ScrollView name="options-page-display" class="fish-scroll options-scroll">
                <ui:Label text="SCREEN" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Resolution" class="fish-label options-row-label" />
                    <ui:DropdownField name="resolution-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Refresh Rate" class="fish-label options-row-label" />
                    <ui:DropdownField name="refreshrate-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Fullscreen" class="fish-label options-row-label" />
                    <ui:DropdownField name="fullscreen-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Label name="options-screen-status" text="" class="fish-hint options-screen-status" />
                    <ui:Button name="options-screen-keep-btn" text="Keep"
                               class="fish-button fish-button--primary options-screen-btn" />
                    <ui:Button name="options-screen-revert-btn" text="Revert"
                               class="fish-button options-screen-btn" />
                    <ui:Button name="options-screen-apply-btn" text="Apply"
                               class="fish-button fish-button--primary options-screen-btn" />
                </ui:VisualElement>

                <ui:Label text="GRAPHICS" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Quality" class="fish-label options-row-label" />
                    <ui:DropdownField name="quality-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Texture Filtering" class="fish-label options-row-label" />
                    <ui:DropdownField name="anisotropic-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Antialiasing" class="fish-label options-row-label" />
                    <ui:DropdownField name="antialiasing-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Brightness" class="fish-label options-row-label" />
                    <ui:Slider name="brightness-slider" low-value="0" high-value="1" class="options-row-field" />
                    <ui:Label name="brightness-value" text="100%" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Look Sensitivity" class="fish-label options-row-label" />
                    <ui:Slider name="look-sensitivity-slider" low-value="0.1" high-value="1" class="options-row-field" />
                    <ui:Label name="look-sensitivity-value" text="0.50" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Frame Rate Limit" class="fish-label options-row-label" />
                    <ui:DropdownField name="framerate-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="VSync" class="fish-label options-row-label" />
                    <ui:Toggle name="vsync-toggle" class="fish-toggle options-row-field" />
                </ui:VisualElement>
                <ui:Label name="options-graphics-hint" text="" class="fish-hint options-hint" />
            </ui:ScrollView>

            <!-- ══ Audio ═════════════════════════════════════════ -->
            <!-- Rows are built by UITKOptions from the AudioChannel enum. -->
            <ui:ScrollView name="options-page-audio" class="fish-scroll options-scroll">
                <ui:Label text="VOLUME" class="fish-attr-category options-section" />
                <ui:VisualElement name="options-audio-list" class="options-list" />
                <ui:Label text="BEHAVIOUR" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Mute When Unfocused" class="fish-label options-row-label" />
                    <ui:Toggle name="audio-mute-unfocused-toggle" class="fish-toggle options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="options-reset-audio-btn" text="Reset Audio"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>
            </ui:ScrollView>

            <!-- ══ Gameplay ══════════════════════════════════════ -->
            <!-- Rows are built by UITKOptions from its GameplayToggles table. -->
            <ui:ScrollView name="options-page-gameplay" class="fish-scroll options-scroll">
                <ui:Label text="GAMEPLAY" class="fish-attr-category options-section" />
                <ui:VisualElement name="options-gameplay-list" class="options-list" />

                <!--
                    Crosshair. Colour is deliberately NOT here: it is a themed colour, edited in
                    the UI tab's colour list, and a second control for the same value would give
                    the player two places to set one colour and no rule about which wins.
                -->
                <ui:Label text="CROSSHAIR" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Show Crosshair" class="fish-label options-row-label" />
                    <ui:Toggle name="crosshair-enabled-toggle" class="fish-toggle options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Style" class="fish-label options-row-label" />
                    <ui:DropdownField name="crosshair-style-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Size" class="fish-label options-row-label" />
                    <ui:Slider name="crosshair-size-slider" low-value="4" high-value="32" class="options-row-field" />
                    <ui:Label name="crosshair-size-value" text="8 px" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Opacity" class="fish-label options-row-label" />
                    <ui:Slider name="crosshair-opacity-slider" low-value="0.1" high-value="1" class="options-row-field" />
                    <ui:Label name="crosshair-opacity-value" text="100%" class="fish-hint options-row-value" />
                </ui:VisualElement>

                <!--
                    World labels: the nameplates, guild lines and floating damage and healing
                    numbers projected onto the world. The last two rows are performance controls
                    as much as taste ones — this is the client's hottest UI loop, and both bound
                    how much of it runs.
                -->
                <ui:Label text="WORLD LABELS" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Label Size" class="fish-label options-row-label" />
                    <ui:Slider name="worldlabel-scale-slider" low-value="0.5" high-value="2" class="options-row-field" />
                    <ui:Label name="worldlabel-scale-value" text="1.00x" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Label Opacity" class="fish-label options-row-label" />
                    <ui:Slider name="worldlabel-opacity-slider" low-value="0.2" high-value="1" class="options-row-field" />
                    <ui:Label name="worldlabel-opacity-value" text="100%" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Draw Distance" class="fish-label options-row-label" />
                    <ui:Slider name="worldlabel-distance-slider" low-value="10" high-value="200" class="options-row-field" />
                    <ui:Label name="worldlabel-distance-value" text="80 m" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Maximum On Screen" class="fish-label options-row-label" />
                    <ui:Slider name="worldlabel-max-slider" low-value="16" high-value="256" class="options-row-field" />
                    <ui:Label name="worldlabel-max-value" text="64" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Hide Behind Geometry" class="fish-label options-row-label" />
                    <ui:Toggle name="worldlabel-occlude-toggle" class="fish-toggle options-row-field" />
                </ui:VisualElement>
                <ui:Label text="Hiding labels behind geometry costs a physics ray per visible label, every frame."
                          class="fish-hint options-hint" />
            </ui:ScrollView>

            <!-- ══ Key Bindings ══════════════════════════════════ -->
            <!-- Rows are built by UITKOptions from the PlayerControls asset. -->
            <!--
                The status line and Reset All Keys sit OUTSIDE the scroller. The list is forty-odd
                rows tall, so anything inside it is off-screen for most of the page — and the two
                things that must never be off-screen are the message explaining why a rebind was
                refused, and the control that undoes a set of bindings the player has broken.
            -->
            <ui:VisualElement name="options-page-controls" class="options-page">
                <ui:VisualElement class="options-row options-row--action options-controls-bar">
                    <ui:Label name="options-controls-status" text="" class="fish-hint options-controls-status" />
                    <ui:Button name="options-reset-controls-btn" text="Reset All Keys"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>
                <ui:Label text="Click a binding, then press the key you want.  Escape cancels  ·  Backspace clears a binding  ·  each key can only be used once."
                          class="fish-hint options-hint options-controls-hint" />
                <ui:ScrollView class="fish-scroll options-scroll">
                    <ui:VisualElement name="options-controls-list" class="options-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- ══ UI ════════════════════════════════════════════ -->
            <!--
                Window layout, theme colours, and the shareable profile that carries both. The
                layout reset is the only way back from an arrangement the player cannot fix by
                dragging — a panel left on a monitor that is no longer attached, most obviously.
            -->
            <ui:ScrollView name="options-page-interface" class="fish-scroll options-scroll">
                <ui:Label text="LAYOUT" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Interface Scale" class="fish-label options-row-label" />
                    <ui:Slider name="ui-scale-slider" low-value="0.75" high-value="1.5" class="options-row-field" />
                    <ui:Label name="ui-scale-value" text="100%" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Window Snap Grid" class="fish-label options-row-label" />
                    <ui:Slider name="ui-snap-slider" low-value="0" high-value="32" class="options-row-field" />
                    <ui:Label name="ui-snap-value" text="8 px" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="options-reset-layout-btn" text="Reset Window Positions"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>

                <ui:Label text="COLOURS" class="fish-attr-category options-section" />
                <ui:VisualElement name="options-color-list" class="options-list" />
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="options-reset-colors-btn" text="Reset All Colours"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>

                <ui:Label text="UI PROFILE" class="fish-attr-category options-section" />
                <ui:Label text="Saves this layout, scale and colour scheme to a file of its own, separate from Configuration.cfg, so it can be shared."
                          class="fish-hint options-hint" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Saved Profiles" class="fish-label options-row-label" />
                    <ui:DropdownField name="ui-profile-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="ui-profile-load-btn" text="Load" class="fish-button options-profile-btn" />
                    <ui:Button name="ui-profile-delete-btn" text="Delete" class="fish-button options-profile-btn" />
                    <ui:Button name="ui-profile-save-btn" text="Save As…"
                               class="fish-button fish-button--primary options-profile-btn" />
                </ui:VisualElement>
                <ui:Label name="ui-profile-status" text="" class="fish-hint options-profile-status" />
                <ui:Label name="ui-profile-path" text="" class="fish-hint options-profile-path" />
            </ui:ScrollView>

            <ui:VisualElement name="options-footer" class="fish-panel__footer options-footer">
                <ui:Button name="options-close-btn" text="Close" class="fish-button options-action" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
