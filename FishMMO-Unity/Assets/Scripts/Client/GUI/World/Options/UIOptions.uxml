<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIOptions.uss" />
    <ui:VisualElement name="options-root" class="options-root">
        <ui:VisualElement name="options-panel" class="fish-panel options-panel">
            <ui:VisualElement name="panel-header" class="fish-panel__header options-header">
                <ui:VisualElement class="fish-panel__icon options-header__icon" />
                <ui:Label text="OPTIONS" class="fish-panel__title" />
            </ui:VisualElement>

            <ui:ScrollView name="options-scroll" class="fish-scroll options-scroll">

                <!-- ── Screen ───────────────────────────────────── -->
                <!--
                    Display settings are staged, not applied on change. A bad mode can leave the
                    player unable to see the control that would undo it, so nothing here takes
                    effect until Apply, and Apply arms a countdown that puts it back.
                -->
                <ui:Label text="SCREEN" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Resolution" class="fish-label options-row-label" />
                    <ui:DropdownField name="resolution-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Refresh Rate" class="fish-label options-row-label" />
                    <ui:DropdownField name="refreshrate-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Fullscreen" class="fish-label options-row-label" />
                    <ui:DropdownField name="fullscreen-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Brightness" class="fish-label options-row-label" />
                    <ui:Slider name="brightness-slider" low-value="0" high-value="1" class="options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="Frame Rate Limit" class="fish-label options-row-label" />
                    <ui:DropdownField name="framerate-dropdown" class="fish-dropdown options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row">
                    <ui:Label text="VSync" class="fish-label options-row-label" />
                    <ui:Toggle name="vsync-toggle" class="fish-toggle options-row-field" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Label name="options-screen-status" text="" class="fish-hint options-screen-status" />
                    <ui:Button name="options-screen-keep-btn" text="Keep"
                               class="fish-button fish-button--primary options-screen-btn" />
                    <ui:Button name="options-screen-revert-btn" text="Revert"
                               class="fish-button options-screen-btn" />
                    <ui:Button name="options-screen-apply-btn" text="Apply"
                               class="fish-button fish-button--primary options-screen-btn" />
                </ui:VisualElement>

                <!-- ── Controls ─────────────────────────────────── -->
                <!-- Rows are built by UITKOptions from the PlayerControls asset. -->
                <ui:Label text="CONTROLS" class="fish-attr-category options-section" />
                <ui:VisualElement name="options-controls-list" class="options-list" />
                <ui:Label name="options-controls-status" text="" class="fish-hint options-controls-status" />
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="options-reset-controls-btn" text="Reset All Keys"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>

                <!-- ── Interface ────────────────────────────────── -->
                <!--
                    Window layout. The snap grid rounds a dragged panel onto a lattice so two
                    windows placed side by side actually line up; Reset returns every panel to the
                    position its stylesheet gives it, which is the only way back from a panel left
                    on a monitor that is no longer attached.
                -->
                <ui:Label text="INTERFACE" class="fish-attr-category options-section" />
                <ui:VisualElement class="options-row">
                    <ui:Label text="Window Snap Grid" class="fish-label options-row-label" />
                    <ui:Slider name="ui-snap-slider" low-value="0" high-value="32" class="options-row-field" />
                    <ui:Label name="ui-snap-value" text="8 px" class="fish-hint options-row-value" />
                </ui:VisualElement>
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="options-reset-layout-btn" text="Reset Window Positions"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>

                <!-- ── Gameplay ─────────────────────────────────── -->
                <!-- Rows are built by UITKOptions from its GameplayToggles table. -->
                <ui:Label text="GAMEPLAY" class="fish-attr-category options-section" />
                <ui:VisualElement name="options-gameplay-list" class="options-list" />

                <!-- ── Colours ──────────────────────────────────── -->
                <!-- Rows are built by UITKOptions from UITKTheme.ColorNames. -->
                <ui:Label text="COLOURS" class="fish-attr-category options-section" />
                <ui:VisualElement name="options-color-list" class="options-list" />
                <ui:VisualElement class="options-row options-row--action">
                    <ui:Button name="options-reset-colors-btn" text="Reset All Colours"
                               class="fish-button options-reset-btn" />
                </ui:VisualElement>

            </ui:ScrollView>

            <ui:VisualElement name="options-footer" class="fish-panel__footer options-footer">
                <ui:Button name="options-close-btn" text="Close" class="fish-button options-action" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
