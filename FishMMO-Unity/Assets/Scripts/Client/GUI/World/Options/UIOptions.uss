/*
    UIOptions.uss
    Layout for the settings panel.
*/

.options-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--overlay-dim);
}

.options-panel {
    min-width: 480px;
    max-width: 600px;
    /*
        Both bounds, not just the maximum. Each tab holds a different amount of content — Gameplay
        is five rows, Key Bindings is forty — and a panel sized to its content resizes under the
        player's hand every time they change tab, moving the tab strip they are clicking on. A
        minimum height keeps the chrome still.
    */
    min-height: 60%;
    max-height: 85%;
    padding: 16px;
}

.options-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.options-scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.options-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 4px 0;
    min-height: 28px;
}

.options-row-label {
    flex-shrink: 0;
    width: 140px;
}

.options-row-field {
    flex-grow: 1;
    margin-left: 12px;
}

/*
    Read-out beside a slider that has no numeric field of its own. Fixed width and right-aligned so
    the slider does not resize as the number goes from "Off" to "32 px" under the player's hand.
*/
.options-row-value {
    flex-shrink: 0;
    width: 48px;
    margin-left: 8px;
    -unity-text-align: middle-right;
}

.options-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.options-action {
    min-width: 96px;
}

/* ═══════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════ */

.options-header {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.options-header__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   SECTIONS
   Screen / Gameplay / Colours.
   ═══════════════════════════════════════════════════════════ */

.options-section {
    margin-top: 14px;
    margin-bottom: 4px;
    padding-bottom: 3px;
    flex-shrink: 0;
}

/*
    Container for the rows UITKOptions generates. It has no size of its own — the rows drive
    the height — but flex-shrink: 0 stops the ScrollView compressing the list instead of
    scrolling it once the three sections together exceed the panel's max height.
*/
.options-list {
    flex-direction: column;
    flex-shrink: 0;
}

.options-row--action {
    justify-content: flex-end;
}

.options-reset-btn {
    height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   COLOUR SWATCHES
   ═══════════════════════════════════════════════════════════ */

/*
    The swatch previews the colour a row controls. Its background is written inline by
    UITKOptions when an override exists; when none does the --unset modifier below supplies
    the appearance instead, so "no choice made" is visibly different from "chose white".
*/
.options-swatch {
    width: 34px;
    height: 18px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--abyss-400);
    margin-right: 8px;
    flex-shrink: 0;
}

.options-swatch--unset {
    background-color: var(--abyss-700);
    border-color: var(--abyss-500);
}

.options-swatch-btn {
    width: 74px;
    height: 22px;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   SCREEN SECTION — staged apply
   Apply arms an auto-revert countdown; Keep disarms it. See UITKOptions.
   ═══════════════════════════════════════════════════════════ */

.options-screen-status {
    flex-grow: 1;
    font-size: 10px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.options-screen-btn {
    height: 24px;
    min-width: 68px;
    margin-left: 4px;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   CONTROLS SECTION
   ═══════════════════════════════════════════════════════════ */

/*
    The binding button is the control itself: pressing it starts listening, and its own label
    becomes the prompt. That keeps a row to two controls instead of three and makes it obvious
    which binding is being captured, because only one row can ever be in the listening state.
*/
.options-bind-btn {
    width: 130px;
    height: 22px;
    font-size: 11px;
    flex-shrink: 0;
}

.options-bind-btn--listening {
    background-color: var(--brand-mid);
    border-color: var(--brand-border);
    color: var(--text-bright);
}

/*
    A binding that collides with another action. Left applied until the conflict is resolved, so
    scrolling away and back does not lose the warning.
*/
.options-bind-btn--conflict {
    background-color: var(--danger-tint);
    border-color: var(--danger-border);
}

.options-bind-reset {
    width: 26px;
    height: 22px;
    margin-left: 4px;
    font-size: 11px;
    flex-shrink: 0;
}

/*
    Takes the free space in its row so the Reset All Keys button beside it stays hard right, and
    wraps rather than overflowing — a conflict message names two bindings and a key and is easily
    longer than the panel is wide.
*/
.options-controls-status {
    flex-grow: 1;
    margin-right: 8px;
    min-height: 13px;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-left;
}

/*
    A tab page that is not itself the scroller. Used where part of the page has to stay put while
    the rest scrolls. min-height: 0 is required: a flex child defaults to min-height: auto, which
    refuses to shrink below its content and would let a forty-row list push the panel past its
    max-height instead of scrolling inside it.
*/
.options-page {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

/*
    The standing explanation of how the tab works, kept separate from the status line so an
    outcome message never displaces it. Both sit outside the scroller, above forty rows of
    bindings.
*/
.options-controls-hint {
    flex-shrink: 0;
    margin-top: 0;
}

.options-controls-bar {
    flex-shrink: 0;
    margin-bottom: 4px;
}

/* ═══════════════════════════════════════════════════════════
   TABS
   One page per tab, only the active one displayed. The strip
   uses the shared .fish-tab appearance so the settings panel
   looks like every other tabbed window in the client.
   ═══════════════════════════════════════════════════════════ */

.options-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 8px;
}

/*
    Equal shares of the strip rather than text-sized buttons. "UI" and "Key Bindings" differ by a
    factor of five in width, and a strip of proportionally sized tabs makes the short one an
    awkward target and moves every tab whenever a label is edited.
*/
.options-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 28px;
    font-size: 11px;
}

/*
    A hidden page keeps its place in the tree so its controls stay resolved; display: none removes
    it from layout entirely, which is what makes the panel size to the visible page alone.
*/
.options-page--hidden {
    display: none;
}

/* ═══════════════════════════════════════════════════════════
   HINTS
   ═══════════════════════════════════════════════════════════ */

/*
    Explanatory text under a section. white-space: normal because the default in UI Toolkit is
    nowrap, which turns a sentence into a single line that overflows the panel.
*/
.options-hint {
    font-size: 10px;
    margin-top: 2px;
    margin-bottom: 6px;
    white-space: normal;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   AUDIO
   ═══════════════════════════════════════════════════════════ */

/*
    Wider than .options-row-value: an audio read-out shows a percentage up to "100%", and the
    label must not resize the slider as the player drags through the hundreds.
*/
.options-audio-value {
    flex-shrink: 0;
    width: 44px;
    margin-left: 8px;
    -unity-text-align: middle-right;
}

/* ═══════════════════════════════════════════════════════════
   UI PROFILES
   ═══════════════════════════════════════════════════════════ */

.options-profile-btn {
    height: 24px;
    min-width: 76px;
    margin-left: 4px;
    flex-shrink: 0;
}

.options-profile-status {
    font-size: 10px;
    min-height: 13px;
    margin-top: 4px;
    white-space: normal;
    flex-shrink: 0;
}

/*
    The folder the profiles live in, shown so a player can find the file to send somebody. Small,
    dim and selectable-looking rather than presented as a control.
*/
.options-profile-path {
    font-size: 9px;
    opacity: 0.6;
    margin-top: 2px;
    white-space: normal;
    flex-shrink: 0;
}
