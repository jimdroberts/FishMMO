/*
    UIOptions.uss
    Layout for the settings panel.
*/

.options-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.options-panel {
    min-width: 420px;
    max-width: 560px;
    max-height: 80%;
    padding: 16px;
}

.options-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.options-scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.options-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 4px 0;
    min-height: 28px;
}

.options-row-label {
    flex-shrink: 0;
    width: 140px;
}

.options-row-field {
    flex-grow: 1;
    margin-left: 12px;
}

.options-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.options-action {
    min-width: 96px;
}
