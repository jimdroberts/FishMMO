<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIPetControl.uss" />
    <ui:VisualElement name="pet-root" class="fish-panel pet-panel">
        <ui:Label name="pet-name" text="Pet" class="pet-name" />
        <ui:VisualElement name="pet-health" class="fish-bar pet-health">
            <ui:VisualElement name="pet-health-fill" class="fish-bar__fill--hp pet-health-fill" />
        </ui:VisualElement>
        <ui:VisualElement name="pet-commands" class="pet-commands">
            <ui:Button name="pet-follow" text="Follow" class="fish-close-btn pet-cmd" />
            <ui:Button name="pet-stay" text="Stay" class="fish-close-btn pet-cmd" />
            <ui:Button name="pet-summon" text="Summon" class="fish-close-btn pet-cmd" />
            <ui:Button name="pet-release" text="Release" class="fish-close-btn pet-cmd" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
