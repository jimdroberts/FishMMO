/*
    UIPetControl.uss
    Layout for the pet control panel. Colours come from FishMMO-Theme.uss.

    A nameplate with a health bar and four commands. Release is destructive
    and sits last, away from Follow and Stay, which are the two a player hits
    mid-fight without looking.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the
    screen, so a root with a size but no position resolves to the top-left
    corner. Lower-left, matching where the uGUI pet frame sat.
*/
.pet-panel {
    position: absolute;
    left: 2%;
    bottom: 16%;
    width: 210px;
    flex-direction: column;
    flex-shrink: 0;
}

.pet-header {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 9px;
    padding-right: 7px;
    flex-shrink: 0;
}

.pet-header__icon {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    flex-shrink: 0;
}

.pet-name {
    flex-grow: 1;
    font-size: 11px;
    letter-spacing: 1px;
    overflow: hidden;
}

.pet-status {
    height: 14px;
    padding-left: 5px;
    padding-right: 5px;
    flex-shrink: 0;
}

.pet-body {
    flex-direction: column;
    padding: 8px;
}

/* Health track. The fill and the numeric overlay both sit inside it. */
.pet-health {
    height: 14px;
    position: relative;
    flex-shrink: 0;
}

.pet-health-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.pet-health-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 9px;
}

/*
    Two by two rather than a single row: four buttons across 210px leaves each
    one too narrow for its label, and a wrapped grid keeps the hit targets big
    enough to use without aiming.
*/
.pet-commands {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 8px;
}

.pet-cmd {
    width: 46%;
    height: 22px;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-shrink: 0;
}

/*
    Stances are a three-way radio, not four independent commands, so they get their
    own row of thirds and a persistent "this is the current one" highlight.
*/
.pet-stances {
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding-top: 4px;
}

.pet-stance {
    width: 31%;
    font-size: 10px;
}

.pet-stance--active {
    background-color: rgba(120, 190, 255, 0.28);
    border-color: rgba(150, 210, 255, 0.85);
}

/*
    Attack priority: three rows the player reorders with a move-up arrow, opened by the
    Priority command. Layout only; every colour comes from the theme classes on the elements.
*/
.pet-priority {
    margin-top: 6px;
    padding-top: 4px;
}

.pet-priority__title {
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.pet-priority__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
}

.pet-priority__label {
    font-size: 10px;
    flex-grow: 1;
}

.pet-priority__up {
    width: 24px;
    height: 18px;
    font-size: 9px;
    flex-shrink: 0;
}
