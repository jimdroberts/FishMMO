<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:fish="FishMMO.Client">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  UIBank.uxml   —   FishMMO Bank Panel                         ║
    ║                                                              ║
    ║  Stylesheet load order (MUST be first-to-last):              ║
    ║    1. FishMMO-Theme.uss  — colors, fonts, transitions        ║
    ║    2. UIBank.uss         — sizes, flex, spacing              ║
    ║                                                              ║
    ║  Class naming convention:                                    ║
    ║    fish-*   Visual theme class  (FishMMO-Theme.uss)          ║
    ║    bank-*   Layout class        (UIBank.uss)                 ║
    ║                                                              ║
    ║  Slot elements are created at runtime by UITKBank.cs and     ║
    ║  appended to #slot-grid.                                     ║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIBank.uss" />

    <ui:VisualElement name="panel-root" class="fish-panel bank-panel">

        <!-- ── HEADER ──────────────────────────────────────── -->
        <ui:VisualElement name="panel-header" class="fish-panel__header bank-header">

            <ui:VisualElement name="header-left" class="bank-header__left">
                <ui:VisualElement name="header-icon" class="fish-panel__icon bank-header__icon" />
                <ui:VisualElement name="header-titles" class="bank-header__titles">
                    <ui:Label name="header-title"
                              class="fish-panel__title bank-header__title"
                              text="BANK" />

                    <!--
                        Capacity, drawn as a resource bar — track, fill, and the count
                        centred over them. This replaces a bare "0 / 32 slots" line here
                        plus a second count either side of a second bar in the footer:
                        three statements of one fact. The bar and its fill keep the
                        names the panel resolves them by, so only the markup moved.
                    -->
                    <ui:VisualElement name="bank-capacity-track" class="fish-bar bank-capacity">
                        <ui:VisualElement name="bank-capacity-fill" class="fish-bar__fill bank-capacity__fill" />
                        <ui:Label name="header-subtitle"
                                  class="fish-bar__label bank-capacity__label"
                                  text="0 / 0" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="close-button" class="fish-close-btn" text="✕" />

        </ui:VisualElement>

        <!-- ── BODY : scrollable slot grid ──────────────────── -->
        <ui:ScrollView name="bank-scroll"
                       class="fish-scroll bank-scroll"
                       vertical-scroller-visibility="Auto"
                       horizontal-scroller-visibility="Hidden"
                       mode="Vertical">

            <!-- Slots injected at runtime by UITKBank.CreateSlot():
                     Slot root   →  fish-slot bank-slot
                     Icon        →  fish-slot__icon bank-slot__icon
                     Amount      →  fish-slot__amount bank-slot__amount
                     Lock        →  fish-slot__lock bank-slot__lock
            -->
            <ui:VisualElement name="slot-grid" class="bank-grid" />

        </ui:ScrollView>

        <!-- ── FOOTER : currency ────────────────────────────── -->
        <!--
            The footer used to restate the capacity readout as two more counts either
            side of a second bar. It shows the character's currency instead, drawn as
            the same chip the equipment panel uses for its HP / MP / STM readouts: a
            coloured dot, a name, and the value.

            The name and value labels are filled in by UITKItemGridPanel from the
            attribute template named by its CurrencyTemplateID. With no template
            configured the whole chip is hidden rather than left showing a placeholder.
        -->
        <ui:VisualElement name="panel-footer" class="fish-panel__footer bank-footer">
            <ui:VisualElement name="bank-currency-chip" class="bank-currency">
                <ui:VisualElement class="fish-chip__dot bank-currency__dot" />
                <ui:Label name="bank-currency-name"
                          class="fish-chip__label bank-currency__name"
                          text="Currency" />
                <ui:Label name="bank-currency-value"
                          class="fish-chip__value bank-currency__value"
                          text="0" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
