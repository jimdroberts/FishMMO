/*
    UIFactions.uss
    Layout for the factions / reputation panel. Colours come from FishMMO-Theme.uss.
    Standing colours are applied inline from C#.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.
*/
.faction-panel {
    position: absolute;
    left: 50%; top: 50%; translate: -50% -50%;
    width: 360px;
    height: 420px;
}

.faction-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 10px;
    padding-right: 8px;
    flex-shrink: 0;
}

.faction-scroll {
    flex-grow: 1;
    padding: 6px;
}

/*
    The list has no height of its own — the sections and their rows drive it — but flex-shrink: 0
    keeps it at that height once the three sections together exceed the ~364px scroll viewport.
    Without it Yoga compresses the rows to fit instead of engaging the scroller, and the rows
    lose their text rather than overflowing. Same fix, same reason, as .options-list.
*/
.faction-list {
    flex-direction: column;
    flex-shrink: 0;
}

/*
    A section is a header plus the container its rows are filed into. Hidden outright while it
    holds no rows (see faction-section--empty) so an opened panel with only allies does not
    show two headings over nothing.

    Hidden rather than removed from the hierarchy: UITKFactions resolves these by name once,
    and a section that had left the tree could not be resolved again when a row arrived for it.
*/
.faction-section {
    flex-direction: column;
    flex-shrink: 0;
}

.faction-section--empty {
    display: none;
}

/*
    Sized by its own line box — do NOT pin a height here. .fish-attr-category carries the
    colours, the letter-spacing and the bottom rule.
*/
.faction-section__header {
    margin-top: 10px;
    margin-bottom: 5px;
    padding-bottom: 3px;
    flex-shrink: 0;
}

.faction-section__rows {
    flex-direction: column;
}

.faction-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: var(--abyss-800);
    transition: background-color 0.08s ease;
}

/*
    Hover is written here rather than borrowed from .fish-row:hover or .fish-attr-row:hover.
    Those two are declared in the theme sheet, which loads first, and .faction-row sets its own
    background-color at equal specificity — so the theme's hover rule is out-ordered and loses
    silently. The row would simply never light up.
*/
.faction-row:hover {
    background-color: var(--abyss-700);
}

.faction-row__icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.faction-row__column {
    flex-grow: 1;
    flex-direction: column;
}

/*
    The caret and the name sit on one line, so they need a row of their own: .faction-row__column
    is a flex COLUMN, so a caret added straight to it would take a line above the name.
*/
.faction-row__nameline {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/*
    A fixed width, so the names of rows that are open and shut still line up. Marked flex-shrink: 0
    because a fixed width is the first thing Yoga gives up when a row is short of space.
*/
.faction-row__caret {
    width: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.faction-row__name {
    font-size: 13px;
    -unity-font-style: bold;
}

.faction-row__desc {
    white-space: normal;
    font-size: 10px;
    color: var(--abyss-200);
    margin-bottom: 4px;
}

/* Applied to a row's description while that row is folded shut, and to every row by default. */
.faction-row__desc--collapsed {
    display: none;
}

/*
    Centres the value label as a normal flex child so it sizes to its text. The fill stays
    absolute underneath it, so the bar still fills left-to-right behind the number.
*/
.faction-row__bar {
    height: 14px;
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.faction-row__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-radius: 3px;
}

/*
    Outlined rather than tinted, because this label has no single background to contrast
    against. It spans the whole bar (left:0 right:0) while the fill behind it covers only the
    standing's share, so at any standing part of the text sits on the coloured fill and part on
    the dark empty track. White measured against each: 1.37:1 on the positive green, 1.72:1 on
    the neutral sky blue, 4.00:1 on the negative red — all under the 4.5:1 needed — and 18.8:1
    on the track. Darkening the text would simply invert which half is unreadable, and tinting
    it per standing cannot fix a label that crosses two backgrounds at once.

    Two attempts at fixing this by styling the text itself — recolouring, then outlining — both
    failed, because no treatment of a glyph survives 1.37:1. The label now carries its own dark
    background instead, sized to the number rather than stretched across the bar, so the fill
    colour behind it stops mattering entirely: white on this scrim measures 4.6:1 over the
    brightest bar and better over every other. The bar keeps its full colour either side of it.
*/
.faction-row__value {
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--white);
    background-color: rgba(0, 0, 0, 0.75);
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 2px;
}

/* ═══════════════════════════════════════════════════════════
   HEADER AND EMPTY STATE
   ═══════════════════════════════════════════════════════════ */

.faction-header__icon {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    flex-shrink: 0;
}

.faction-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    overflow: hidden;
}

.faction-count {
    min-width: 24px;
    height: 16px;
    padding-left: 6px;
    padding-right: 6px;
    flex-shrink: 0;
}

/* Sizing only — .fish-close-btn carries the colours, border and hover. */
.faction-close-btn {
    margin-left: 8px;
}

/*
    Shown when the list behind it has nothing in it. A blank scroll area reads
    as a panel that failed to load; a sentence reads as a panel that loaded and
    found nothing.
*/
.faction-empty {
    margin-top: 22px;
    margin-bottom: 22px;
}

/*
    A stacked title + subtitle needs its two line boxes pinned. Unity gives a
    Label a generous intrinsic height, so an unconstrained pair measures taller
    than the header that contains it — the subtitle then overflows into
    whatever sits below the header, which is exactly what it did.
*/
.faction-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.faction-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}
