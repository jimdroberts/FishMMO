/*
    UIFactions.uss
    Layout for the factions / reputation panel. Colours come from FishMMO-Theme.uss.
    Standing colours are applied inline from C#.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. The values restore
    where the panel sat in the uGUI scene, expressed as percentages so they hold at any
    aspect ratio. Dragging overwrites left/top, which is why position is absolute here.
*/
.faction-panel {
    position: absolute;
    left: 50%; top: 50%; translate: -50% -50%;
    width: 360px;
    height: 420px;
}

.faction-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 10px;
    padding-right: 8px;
    flex-shrink: 0;
}

.faction-scroll {
    flex-grow: 1;
    padding: 6px;
}

.faction-list {
    flex-direction: column;
}

.faction-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: var(--abyss-800);
}

.faction-row__icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.faction-row__column {
    flex-grow: 1;
    flex-direction: column;
}

.faction-row__name {
    font-size: 13px;
    -unity-font-style: bold;
}

.faction-row__desc {
    white-space: normal;
    font-size: 10px;
    color: var(--abyss-200);
    margin-bottom: 4px;
}

/*
    Centres the value label as a normal flex child so it sizes to its text. The fill stays
    absolute underneath it, so the bar still fills left-to-right behind the number.
*/
.faction-row__bar {
    height: 14px;
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.faction-row__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-radius: 3px;
}

/*
    Outlined rather than tinted, because this label has no single background to contrast
    against. It spans the whole bar (left:0 right:0) while the fill behind it covers only the
    standing's share, so at any standing part of the text sits on the coloured fill and part on
    the dark empty track. White measured against each: 1.37:1 on the positive green, 1.72:1 on
    the neutral sky blue, 4.00:1 on the negative red — all under the 4.5:1 needed — and 18.8:1
    on the track. Darkening the text would simply invert which half is unreadable, and tinting
    it per standing cannot fix a label that crosses two backgrounds at once.

    Two attempts at fixing this by styling the text itself — recolouring, then outlining — both
    failed, because no treatment of a glyph survives 1.37:1. The label now carries its own dark
    background instead, sized to the number rather than stretched across the bar, so the fill
    colour behind it stops mattering entirely: white on this scrim measures 4.6:1 over the
    brightest bar and better over every other. The bar keeps its full colour either side of it.
*/
.faction-row__value {
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--white);
    background-color: rgba(0, 0, 0, 0.75);
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 2px;
}


/* ═══════════════════════════════════════════════════════════
   HEADER AND EMPTY STATE
   ═══════════════════════════════════════════════════════════ */

.faction-header__icon {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    flex-shrink: 0;
}

.faction-header__titles {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    overflow: hidden;
}

.faction-count {
    min-width: 24px;
    height: 16px;
    padding-left: 6px;
    padding-right: 6px;
    flex-shrink: 0;
}

/* Sizing only — .fish-close-btn carries the colours, border and hover. */
.faction-close-btn {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    padding: 0;
    margin-left: 8px;
}


/*
    Shown when the list behind it has nothing in it. A blank scroll area reads
    as a panel that failed to load; a sentence reads as a panel that loaded and
    found nothing.
*/
.faction-empty {
    margin-top: 22px;
    margin-bottom: 22px;
}

/*
    A stacked title + subtitle needs its two line boxes pinned. Unity gives a
    Label a generous intrinsic height, so an unconstrained pair measures taller
    than the header that contains it — the subtitle then overflows into
    whatever sits below the header, which is exactly what it did.
*/
.faction-header__titles > .fish-panel__title {
    height: 15px;
    flex-shrink: 0;
}

.faction-header__titles > .fish-panel__subtitle {
    height: 12px;
    flex-shrink: 0;
}
