/*
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    UIEquipment.uss
    Equipment Panel  —  Structure & Layout only
    Unity UIToolkit  (Unity 6.x LTS)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    PURPOSE
    ───────
    All sizing, spacing, flex directions, and positioning
    for the equipment panel. NO colors or fonts here —
    those are in FishMMO-Theme.uss.

    LOAD ORDER in UXML (required):
        <ui:Style src="FishMMO-Theme.uss" />
        <ui:Style src="UIEquipment.uss" />

    Unity UIToolkit layout rules used throughout:
    ─────────────────────────────────────────────
    • flex-direction defaults to column — set row explicitly
      on every horizontal container.
    • flex-shrink: 0 on every fixed-size element so Unity's
      Yoga solver never compresses it.
    • Absolute-positioned children need all four inset
      values (left/top/right/bottom) to fill their parent.
    • Give every flex parent a concrete size on at least
      one axis so children can resolve their own sizes.
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
*/

/* ═══════════════════════════════════════════════════════════
   PANEL ROOT
   ═══════════════════════════════════════════════════════════ */

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    root with a size but no position resolves to the top-left corner — with the uGUI layer
    gone, every one of these panels stacked there on top of each other. Dragging overwrites
    left/top, which is why position is absolute here.

    The character sheet, the bank and the bag can be open at the same time — the bank opens the
    bag itself — and they are siblings in ONE UI Toolkit panel, ordered by UIDocument.sortingOrder.
    A click on a socket that another window covers is delivered to that window instead, so the
    three are tiled across the panel's width rather than stacked in the corners they used to
    share. Issue #268: with the sheet against the right edge, the bag and the bank covered eight
    of its ten equipment sockets, so a bank item dragged onto a socket landed in the bag, moved
    there, and locked the slot it landed in.

        character sheet     12 ..  532      left: 1%,  520 wide
        bank               552 ..  882      left: 46%, 330 wide
        bag                908 .. 1188      right: 1%, 280 wide

    Panel space is always exactly 1200 units wide (PanelSettings matches width), so these
    percentages are a fixed horizontal arrangement at every aspect ratio. Any move here has to
    be matched in the other two stylesheets; WindowOverlapTests fails if the three stop being
    disjoint, or if any of them leaves the panel.
*/
.eq-panel {
    position: absolute;
    left: 1%; top: 12%;
    width: 520px;
    flex-direction: column;
    flex-shrink: 0;

    /*
        The slot grid and the attribute list used to take turns on one tab, so the panel was
        only ever as tall as the taller of the two. Both are drawn together now, which is
        enough to run off the bottom of a short screen, so the panel is capped and .eq-footer
        below is the half that shrinks to fit.
    */
    max-height: 84%;
}

/* ═══════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════ */

.eq-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.eq-header__left {
    flex-direction: row;
    align-items: center;
    flex: 1;
}

.eq-header__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
}

.eq-header__title {
    flex-shrink: 0;
    margin-right: 4px;
}

/* ═══════════════════════════════════════════════════════════
   BODY  (three-column row)
   ═══════════════════════════════════════════════════════════ */

.eq-body {
    flex-direction: row;
    align-items: stretch;
    height: 320px;
    padding: 12px;
    flex-shrink: 0;
}

/* ── Side columns ──────────────────────────────────────── */

.eq-col {
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    width: 68px;
    flex-shrink: 0;
}

/* ── Center column ─────────────────────────────────────── */

.eq-center {
    flex-direction: column;
    align-items: center;
    flex: 1;
    margin-left: 6px;
    margin-right: 6px;
}

/* ── Character preview ─────────────────────────────────── */

.eq-preview {
    width: 100%;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    position: relative;
}

.eq-preview__rt {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.eq-preview__label {
    margin-bottom: 6px;
}

/* ── Center sub-slots row (Neck / Back / Ring) ─────────── */

.eq-center-slots {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 64px;
    margin-top: 8px;
    flex-shrink: 0;
}

.eq-center-slots .eq-slot {
    margin-left: 4px;
    margin-right: 4px;
}

/* ═══════════════════════════════════════════════════════════
   EQUIPMENT SLOT
   ═══════════════════════════════════════════════════════════ */

.eq-slot {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    position: relative;
    align-items: center;
    justify-content: center;
}

/* Icon: fills slot, leaves room at bottom for the label */
.eq-slot__icon {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 14px;
}

/* Slot name label pinned to bottom */
.eq-slot__label {
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
}

/* Stack count badge — bottom-right corner */
.eq-slot__amount {
    position: absolute;
    bottom: 14px;
    right: 3px;
    padding-left: 2px;
    padding-right: 2px;
}

/* Cooldown: full-slot overlay */
.eq-slot__cooldown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Lock: full-slot overlay */
.eq-slot__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/*
    Waiting on the server, as opposed to locked by the container.
    Both mean "this slot is busy", so they share one overlay element and differ only in
    colour: a container lock is a refusal (danger tint, inherited from .fish-slot__lock),
    an in-flight request is just a wait. The override is a neutral scrim rather than a
    second danger tint so the player can tell a pending click from a rejected one.
*/
.eq-slot__lock--pending {
    background-color: var(--scrim-60);
    border-color: var(--brand-border);
    border-width: 1px;
}

/* ═══════════════════════════════════════════════════════════
   FOOTER  (attribute scroll list)
   ═══════════════════════════════════════════════════════════ */

.eq-footer {
    flex-direction: column;
    max-height: 200px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 8px;

    /*
        The one part of the panel allowed to lose height when .eq-panel hits its cap. Yoga will
        not shrink a flex child below its content unless min-height is cleared, so both are
        needed; the ScrollView inside absorbs the loss.
    */
    flex-shrink: 1;
    min-height: 0;
}

/* Sits directly under .eq-divider, which already carries the gap. */
.eq-attr-heading {
    margin-top: 0;
    flex-shrink: 0;
}

.eq-divider {
    margin-bottom: 6px;
    flex-shrink: 0;
}

.eq-attr-scroll {
    flex: 1;
}

/* ── Attribute rows (layout for runtime-generated elements) */

.fish-attr-category {
    margin-top: 8px;
    margin-bottom: 2px;
    padding-bottom: 3px;
}

.fish-attr-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 2px;
    padding-right: 2px;
}

.fish-attr-row__name {
    flex: 1;
}

/* ═══════════════════════════════════════════════════════════
   STATUS BAR
   ═══════════════════════════════════════════════════════════ */

.eq-status-bar {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 12px;
    padding-right: 12px;
    flex-shrink: 0;
}

.eq-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.eq-chip__dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-right: 4px;
}

.eq-chip__label {
    margin-right: 3px;
}

/* ═══════════════════════════════════════════════════════════
   UTILITY
   ═══════════════════════════════════════════════════════════ */

.eq-hidden { display: none; }
