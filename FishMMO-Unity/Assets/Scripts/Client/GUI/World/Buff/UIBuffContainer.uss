/*
    UIBuffContainer.uss
    Layout for the buff / debuff icon strips. Shared by UIBuff.uxml and UIDebuff.uxml.
    Colours that are not buff/debuff specific come from FishMMO-Theme.uss.
*/

/*
    Anchored explicitly. Each panel is its own UIDocument whose root fills the screen, so a
    container with no position resolves to the top-left corner — which is right for buffs and
    wrong for debuffs, and put both strips on top of each other. The modifiers below place each
    one where its uGUI anchor had it: buffs top-left, debuffs top-right.
*/
.buff-container {
    position: absolute;
    top: 12px;
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--clear);
}

.buff-container--buff {
    left: 12px;
}

.buff-container--debuff {
    right: 12px;
    justify-content: flex-end;
}

/* Horizontal strip that holds the generated buff groups. */
.buff-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

/* A single buff/debuff entry. */
.buff-group {
    width: 40px;
    height: 40px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--abyss-500);
    border-radius: 6px;
    background-color: var(--abyss-800);
    overflow: hidden;
}

/* Depleting duration fill (drawn behind the icon, height driven from C#). */
.buff-group__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: var(--brand-press);
}

/* Buff icon sprite. */
.buff-group__icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Small name/stack label drawn at the bottom of the icon. */
.buff-group__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: lower-center;
    color: var(--abyss-100);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.9);
}

/* Positive buffs glow ember-orange; debuffs glow danger-red. */
.buff-container--buff .buff-group__fill {
    background-color: var(--brand-press);
}

.buff-container--debuff .buff-group {
    border-color: var(--danger-border);
}

.buff-container--debuff .buff-group__fill {
    background-color: var(--danger-fill);
}

/* Standalone debuff modifier (used where groups are mixed in one list, e.g. target frame). */
.buff-group--debuff {
    border-color: var(--danger-border);
}

.buff-group--debuff .buff-group__fill {
    background-color: var(--danger-fill);
}
