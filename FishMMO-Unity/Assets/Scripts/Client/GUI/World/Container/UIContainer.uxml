<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:fish="FishMMO.Client">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  UIContainer.uxml  —  FishMMO World Container Panel          ║
    ║                                                              ║
    ║  Chests, crates and wardrobes placed in the world. Distinct  ║
    ║  from UIItemContainers, which is the player's OWN bags.      ║
    ║                                                              ║
    ║  Stylesheet load order (MUST be first-to-last):              ║
    ║    1. FishMMO-Theme.uss  — colors, fonts, transitions        ║
    ║    2. UIContainer.uss    — sizes, flex, spacing              ║
    ║                                                              ║
    ║  Class naming convention:                                    ║
    ║    fish-*       Visual theme class  (FishMMO-Theme.uss)      ║
    ║    container-*  Layout class        (UIContainer.uss)        ║
    ║                                                              ║
    ║  Item rows are created at runtime by UITKContainer.cs and    ║
    ║  appended to #container-list.                                ║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <Style src="../../FishMMO-Theme.uss" />
    <Style src="UIContainer.uss" />

    <ui:VisualElement name="panel-root" class="fish-panel container-panel">

        <!-- ── HEADER ──────────────────────────────────────── -->
        <ui:VisualElement name="panel-header" class="fish-panel__header container-header">

            <ui:VisualElement name="header-left" class="container-header__left">
                <ui:VisualElement name="header-icon" class="fish-panel__icon container-header__icon" />
                <ui:VisualElement name="header-titles" class="container-header__titles">
                    <ui:Label name="header-title"
                              class="fish-panel__title container-header__title"
                              text="CONTAINER" />
                    <ui:Label name="header-subtitle"
                              class="fish-panel__subtitle container-header__subtitle"
                              text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="close-button" class="fish-close-btn container-close-btn" text="✕" />

        </ui:VisualElement>

        <!-- ── BODY : scrollable item list ──────────────────── -->
        <ui:ScrollView name="container-scroll"
                       class="fish-scroll container-scroll"
                       vertical-scroller-visibility="Auto"
                       horizontal-scroller-visibility="Hidden"
                       mode="Vertical">

            <!-- Rows injected at runtime by UITKContainer.CreateRow():
                     Row root    →  fish-slot container-row
                     Icon        →  fish-slot__icon container-row__icon
                     Name        →  fish-label container-row__name
                     Amount      →  fish-slot__amount container-row__amount
                     Pending     →  fish-slot__lock container-row__pending
            -->
            <ui:VisualElement name="container-list" class="container-list" />
            <ui:Label name="container-empty" text="Empty." class="fish-empty container-empty" />

        </ui:ScrollView>

        <!-- ── FOOTER ───────────────────────────────────────── -->
        <ui:VisualElement name="panel-footer" class="fish-panel__footer container-footer">
            <ui:Label name="container-status" text="" class="fish-label fish-label--caption container-footer__status" />
            <ui:Button name="container-take-all" text="Take All" class="fish-button container-take-all" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
