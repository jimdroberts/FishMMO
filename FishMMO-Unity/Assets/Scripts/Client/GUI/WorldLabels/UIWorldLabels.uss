/*
    UIWorldLabels.uss
    Layout for the world-anchored label layer. Colour is written per-label from C# — every label
    carries its own tint (faction standing, damage type, guild colour), so there is no single
    themed colour to inherit here.
*/

/*
    The layer must never intercept a click: it covers the whole viewport and sits above the world,
    so a pickable root would swallow every click meant for the scene. picking-mode is set in the
    UXML as well because it is an attribute rather than a USS property, and an element whose
    parent ignores picking is still picked itself.
*/
.world-label-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.world-label-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/*
    Each projected label is two elements, and the split is a performance decision rather than a
    stylistic one.

    The anchor is pinned to the container's origin and moved every frame by writing `translate`
    from C#. `translate` is a transform: it changes where the element is painted and never marks
    layout dirty. Writing `left`/`top` instead — which is what this did originally — dirties the
    element's layout, and Yoga then re-solves the entire container once per frame per label.

    The centring offset still has to be a percentage of the label's own size, because the text
    width is not known until it has been laid out, and one element only gets one `translate`.
    So the offset lives on the text child, where it is written once from USS and never touched
    again, leaving the anchor's translate free for the position.
*/
.world-label-anchor {
    position: absolute;
    left: 0;
    top: 0;
}

/*
    white-space: nowrap keeps a two-line nameplate breaking only where the generator put a
    newline, never on width.
*/
.world-label {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: nowrap;
    translate: -50% -100%;
    text-shadow: 0 1px 2px var(--shadow-text-hard);
}

/*
    Screen-anchored captions (region names). Declared after the world container in the UXML so a
    caption always draws over the projected labels rather than fighting them for order.
*/
.screen-label-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen-label {
    position: absolute;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 2px 4px var(--shadow-text-soft);
}
