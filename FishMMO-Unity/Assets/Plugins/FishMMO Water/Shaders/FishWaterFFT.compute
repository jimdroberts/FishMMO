// Tessendorf ocean spectrum, inverse-FFT'd to a displacement field each frame.
//
// WHY THIS AND NOT A SUM OF WAVES
// A sum of Gerstner waves is limited by how many sines can be afforded per vertex — six or eight —
// and a real sea surface is a continuous spectrum with tens of thousands of components. That gap
// is not a tuning problem: with eight components the periodicity is always visible and the
// surface reads as corrugated metal however carefully the amplitudes are set.
//
// An inverse FFT evaluates EVERY component of an N x N spectrum at once, in O(N² log N) rather
// than O(N² · components). At 256² that is about 200,000 waves per cascade for a fraction of a
// millisecond, and the per-pixel cost in the water shader DROPS, because the shader stops
// re-evaluating a wave sum and simply samples a texture.

#pragma kernel InitialSpectrum
#pragma kernel TimeSpectrum
#pragma kernel HorizontalFFT
#pragma kernel VerticalFFT
#pragma kernel Assemble

// The spectrum, its time evolution and the assembly are shared with the render-pass version for
// machines with no compute (FishWaterFFT.shader), so the two cannot drift apart.
#include "FishWaterSpectrum.hlsl"

uint _Step;              // FFT stage, 1 … LOG_SIZE
uint _Seed;

RWTexture2D<float4> _H0;            // xy h0(k), zw conj(h0(-k))
RWTexture2D<float4> _SpectrumA;     // xy height, zw Dx
RWTexture2D<float4> _SpectrumB;     // xy Dz, zw unused
RWTexture2D<float4> _Displacement;  // xyz displacement, w folding
RWTexture2D<float4> _Derivatives;   // xy slope, z folding, w unused

// ── Stage 1: the static spectrum ──────────────────────────────────────

[numthreads(8, 8, 1)]
void InitialSpectrum(uint3 id : SV_DispatchThreadID)
{
	_H0[id.xy] = FishInitialSpectrum(id.xy, _Seed);
}

// ── Stage 2: evolve it to this instant ────────────────────────────────

[numthreads(8, 8, 1)]
void TimeSpectrum(uint3 id : SV_DispatchThreadID)
{
	float4 a, b;
	FishTimeSpectrum(id.xy, _H0[id.xy], a, b);
	_SpectrumA[id.xy] = a;
	_SpectrumB[id.xy] = b;
}

// ── Stage 3: the inverse FFT, one row or column per thread group ──────
//
// Every stage of a 256-point transform lives in group shared memory, so the whole 1D transform is
// ONE dispatch per axis instead of eight. Each thread owns one element and reads its butterfly
// partner, which needs no atomics and no bit-reversal write conflicts.

groupshared float4 SharedA[2][SIZE];
groupshared float4 SharedB[2][SIZE];

void Butterfly(uint x, inout uint src)
{
	[unroll]
	for (uint s = 1; s <= LOG_SIZE; s++)
	{
		uint m = 1u << s;
		uint halfSpan = m >> 1;
		uint j = x & (halfSpan - 1u);
		uint lower = x & ~halfSpan;
		uint upper = lower + halfSpan;
		bool isUpper = (x & halfSpan) != 0u;
		float2 w = Twiddle(j, m);

		float4 a = SharedA[src][lower];
		float4 b = ComplexMulPair(SharedA[src][upper], w);
		float4 c = SharedB[src][lower];
		float4 d = ComplexMulPair(SharedB[src][upper], w);

		uint dst = 1u - src;
		SharedA[dst][x] = isUpper ? (a - b) : (a + b);
		SharedB[dst][x] = isUpper ? (c - d) : (c + d);

		GroupMemoryBarrierWithGroupSync();
		src = dst;
	}
}

[numthreads(SIZE, 1, 1)]
void HorizontalFFT(uint3 gid : SV_GroupThreadID, uint3 grp : SV_GroupID)
{
	uint x = gid.x;
	uint y = grp.x;
	uint reversed = BitReverse(x);

	SharedA[0][x] = _SpectrumA[uint2(reversed, y)];
	SharedB[0][x] = _SpectrumB[uint2(reversed, y)];
	GroupMemoryBarrierWithGroupSync();

	uint src = 0;
	Butterfly(x, src);

	_SpectrumA[uint2(x, y)] = SharedA[src][x];
	_SpectrumB[uint2(x, y)] = SharedB[src][x];
}

[numthreads(SIZE, 1, 1)]
void VerticalFFT(uint3 gid : SV_GroupThreadID, uint3 grp : SV_GroupID)
{
	uint y = gid.x;
	uint x = grp.x;
	uint reversed = BitReverse(y);

	SharedA[0][y] = _SpectrumA[uint2(x, reversed)];
	SharedB[0][y] = _SpectrumB[uint2(x, reversed)];
	GroupMemoryBarrierWithGroupSync();

	uint src = 0;
	Butterfly(y, src);

	/* NO 1/N² here, and that is deliberate.
	 *
	 * The textbook inverse DFT carries 1/N², but Tessendorf's spectrum amplitudes are defined
	 * against the UNNORMALISED transform — the energy is already in h0. Dividing again scales the
	 * surface by 1/65536: measured, the field arrived intact at the end of the horizontal pass
	 * (sum 62.9) and left the vertical pass with a peak below 5e-5, which reads as a dead flat
	 * sea and gives no hint that the transform itself was perfectly correct. The overall scale is
	 * set once, by calibrating _Amplitude against significant wave height. */
	_SpectrumA[uint2(x, y)] = SharedA[src][y];
	_SpectrumB[uint2(x, y)] = SharedB[src][y];
}

// ── Stage 4: displacement, slope and folding ──────────────────────────

[numthreads(8, 8, 1)]
void Assemble(uint3 id : SV_DispatchThreadID)
{
	uint2 east = uint2((id.x + 1) & (SIZE - 1), id.y);
	uint2 west = uint2((id.x + SIZE - 1) & (SIZE - 1), id.y);
	uint2 north = uint2(id.x, (id.y + 1) & (SIZE - 1));
	uint2 south = uint2(id.x, (id.y + SIZE - 1) & (SIZE - 1));

	float4 displacement, derivatives;
	FishAssemble(id.xy,
		_SpectrumA[id.xy], _SpectrumA[east], _SpectrumA[west], _SpectrumA[north], _SpectrumA[south],
		_SpectrumB[id.xy], _SpectrumB[east], _SpectrumB[west], _SpectrumB[north], _SpectrumB[south],
		displacement, derivatives);
	_Displacement[id.xy] = displacement;
	_Derivatives[id.xy] = derivatives;
}
