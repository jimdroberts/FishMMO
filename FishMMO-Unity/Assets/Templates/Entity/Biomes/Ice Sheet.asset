  m_Script: {fileID: 11500000, guid: b10de7e3a4c14e1f8a9d5c2b6f7e8a01, type: 3}
  m_Name: Ice Sheet
  m_EditorClassIdentifier: FishMMO.Shared::FishMMO.Shared.Biomes.BiomeTemplate
  DisplayName: Ice Sheet
  Description: 'The heart of a continental ice cap: a white dome to every horizon
    combed into sastrugi by the falling wind, mirror-glazed slopes and fields of
    old blue ice strewn with black star-stones, dark charnockite nunataks with wind-scooped
    moats and petrel ledges black with stone-oil. Ice-road carriers cross it from
    serge post to serge post; the Winter Bull grazes upwind.'
