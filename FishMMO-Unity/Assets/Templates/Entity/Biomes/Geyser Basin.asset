  m_Script: {fileID: 11500000, guid: b10de7e3a4c14e1f8a9d5c2b6f7e8a01, type: 3}
  m_Name: Geyser Basin
  m_EditorClassIdentifier: FishMMO.Shared::FishMMO.Shared.Biomes.BiomeTemplate
  DisplayName: Geyser Basin
  Description: 'A cold highland of hot ground: white sinter, sapphire pools and spouts
    that keep their own hours, mud pots and painted clay hills. Turf farms bake their
    bread in the steaming earth, travellers keep to the cairned bridle-ways, the
    whole country meets at the Law Rock in summer, and the hidden folk keep their
    glowing doors in the great boulders.'
