<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
        <!-- CS4014: FishMMO-Logger methods are intentionally fire-and-forget in this daemon. -->
    <NoWarn>$(NoWarn);CS4014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Required for loading configuration from appsettings.json -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration (no rename needed). -->
    <None Include="..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!-- Copy-and-rename config files from FishMMO-Setup/Development/ to output. -->
  <Target Name="CopyFishMMOConfig" AfterTargets="Build">
    <Copy SourceFiles="..\..\FishMMO-Setup\Development\appsettings.AppHealthMonitor.json"
          DestinationFiles="$(OutDir)appsettings.json"
          SkipUnchangedFiles="true" />
  </Target>
</Project>