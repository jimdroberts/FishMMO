<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
        <!-- CS4014: FishMMO-Logger methods are intentionally fire-and-forget in this daemon. -->
    <NoWarn>$(NoWarn);CS4014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Required for loading configuration from appsettings.json. Pinned to 9.0.4 to match
         FishMMO-DB, which the control plane references; a lower version is a package downgrade. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <!-- The database-backed control plane. Optional at runtime: with no credentials the daemon
         supervises exactly as it did before. -->
    <ProjectReference Include="..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration (no rename needed). -->
    <None Include="..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!-- Copy-and-rename shared configuration for both build and publish output. -->
  <ItemGroup>
    <Content Include="..\..\FishMMO-Setup\Development\appsettings.AppHealthMonitor.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\FishMMO-Setup\Production\appsettings.AppHealthMonitor.json"
             Link="appsettings.Production.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\..\FishMMO-Setup\Production\appsettings.AppHealthMonitor.json')" />
  </ItemGroup>
</Project>