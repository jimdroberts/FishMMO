# FishMMO Secrets — copy to fishmmo-secrets.env and fill in values.
# This file documents all required environment variables for production.
#
# Usage:
#   cp .env.example fishmmo-secrets.env
#   source fishmmo-secrets.env
#   systemctl start fishmmo services
#
# WARNING: Keep fishmmo-secrets.env out of version control and
# restrict file permissions (chmod 600).

# All values marked with !!! MUST be replaced before deployment.
# The application will refuse to start if any placeholder value is detected.

# Shared secret between LoginServer gate and game clients for connection tokens.
# Minimum 32 characters. Generate with: openssl rand -base64 32
#
# !!! WARNING: This MUST be set to a real value before deploying to production. !!!
# An empty or placeholder value will cause connection token verification to fail (or silently use a weak empty key).
# Generate a strong key with: openssl rand -base64 32
FISHMMO_CLIENT_GATE_SECRET=!!!CHANGE_ME_DEPLOY_WILL_FAIL_WITH_THIS_VALUE!!!

# Base64-encoded Key Encryption Key (KEK) for signing key material.
# Generate with: openssl rand -base64 32
#
# !!! WARNING: This MUST be set to a real value before deploying to production. !!!
# An empty or placeholder value will cause key derivation to fail (or silently use a weak empty key).
# Generate a strong key with: openssl rand -base64 32
FISHMMO_SIGNING_KEY_KEK_BASE64=!!!CHANGE_ME_DEPLOY_WILL_FAIL_WITH_THIS_VALUE!!!

# Base64-encoded HMAC key for connection token signing (32+ bytes).
# MUST match between IpFetchServer and all game servers.
# Generate with: openssl rand -base64 32
#
# !!! WARNING: This MUST be set to a real value before deploying to production. !!!
# An empty value will cause connection token verification to fail (or silently use a weak empty key).
# Generate a strong key with: openssl rand -base64 32
FISHMMO_CONNECTION_TOKEN_HMAC_KEY_BASE64=!!!CHANGE_ME_DEPLOY_WILL_FAIL_WITH_THIS_VALUE!!!

# SMTP password for the account verification email relay.
# Used by LoginServer to send verification emails via the configured Smtp:Host.
#
# !!! WARNING: This MUST be set to a real SMTP password before deploying to production. !!!
# An empty or placeholder value will cause email verification to fail.
FISHMMO_SMTP_PASSWORD=!!!CHANGE_ME_DEPLOY_WILL_FAIL_WITH_THIS_VALUE!!!

# PostgreSQL connection string for the FishMMO database.
# Format: Host=host;Port=5432;Database=fishmmo;Username=user;Password=pass
#
# !!! WARNING: The placeholder password below MUST be changed before deploying to production. !!!
# If you deploy with the default value, an attacker can gain full access to your database.
# Set this to a strong, unique password (minimum 32 characters, mix of letters/numbers/symbols).
# Generate a strong password with: openssl rand -base64 32
ConnectionStrings__NpgsqlConnection=Host=localhost;Port=5432;Database=fishmmo;Username=fishmmo;Password=!!!CHANGE_ME_DEPLOY_WILL_FAIL_WITH_THIS_VALUE!!!
