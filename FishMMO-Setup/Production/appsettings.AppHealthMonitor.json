{
  "_comment": "Production configuration for FishMMO AppHealthMonitor. Overrides Development defaults. Update Application paths and paths for your production deployment. All secrets MUST be set via environment variables.",
  "Headless": true,
  "Applications": [
    {
      "Name": "LoginServer",
      "ApplicationExePath": "/opt/fishmmo/GameServer",
      "MonitoredPort": 7770,
      "PortTypes": [ "TCP", "UDP" ],
      "LaunchArguments": "LOGIN",
      "CheckIntervalSeconds": 30,
      "LaunchDelaySeconds": 2,
      "CpuThresholdPercent": 80,
      "MemoryThresholdMB": 1024,
      "GracefulShutdownTimeoutSeconds": 10,
      "InitialRestartDelaySeconds": 5,
      "MaxRestartDelaySeconds": 60,
      "MaxRestartAttempts": 5,
      "CircuitBreakerFailureThreshold": 3,
      "InitialHealthCheckDelaySeconds": 30,
      "PostLaunchSettleDelaySeconds": 5,
      "PortCheckTimeoutMs": 2000,
      "WebSocketCheckTimeoutMs": 5000,
      "ForceKillTimeoutSeconds": 5,
      "HealthCheckHost": "127.0.0.1",
      "ResourceCheckFailureThreshold": 2
    },
