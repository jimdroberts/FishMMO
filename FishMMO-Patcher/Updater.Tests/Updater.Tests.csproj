<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone assertion harness for FishMMO.Patcher.PathContainment (the zip-slip fix).

    Deliberately a console app rather than an NUnit project, and deliberately NOT a member of
    Updater.sln:
      * The repo's NUnit runner lives inside the Unity project and needs the editor to execute,
        which makes it the wrong home for a plain .NET security helper.
      * Keeping it out of the solution means `dotnet build Updater/Updater.sln` and any publish
        step that targets the solution still see exactly the one shipping project they saw
        before.

    Run it with:  dotnet run   (from this directory)
    Exit code 0 = every assertion passed. Non-zero = at least one containment case regressed.

    The helper is compiled in by source link rather than by project reference so the harness
    exercises the shipping file itself, not a copy that can drift from it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Updater.Tests</AssemblyName>
    <RootNamespace>FishMMO.Patcher.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Updater/Patch/PathContainment.cs" Link="PathContainment.cs" />
  </ItemGroup>

</Project>
