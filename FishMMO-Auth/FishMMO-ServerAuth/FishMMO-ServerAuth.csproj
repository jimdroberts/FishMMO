<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FishMMO.Auth</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="srp" Version="1.0.7" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FishMMO-AuthShared\FishMMO-AuthShared.csproj" />
  </ItemGroup>

  <!-- Copy the built DLL to the Unity project Dependencies folder. -->
  <Target Name="CopyToUnityDependencies" AfterTargets="Build">
    <PropertyGroup>
      <UnityDepsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../FishMMO-Unity/Assets/Dependencies'))</UnityDepsDir>
    </PropertyGroup>
    <Copy SourceFiles="$(OutputPath)FishMMO-ServerAuth.dll" DestinationFolder="$(UnityDepsDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
