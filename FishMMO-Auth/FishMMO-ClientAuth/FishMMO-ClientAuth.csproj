<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FishMMO.Auth</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FishMMO-AuthShared\FishMMO-AuthShared.csproj" />
  </ItemGroup>

  <!-- Copy the built DLL to the Unity project Dependencies folder. -->
  <Target Name="CopyToUnityDependencies" AfterTargets="Build">
    <PropertyGroup>
      <UnityDepsDir>..\..\FishMMO-Unity\Assets\Dependencies</UnityDepsDir>
    </PropertyGroup>
    <ItemGroup>
      <AuthDll Include="bin\$(Configuration)\**\FishMMO-ClientAuth.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AuthDll)" DestinationFolder="$(UnityDepsDir)" />
  </Target>

</Project>
