<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FishMMO.Installer</RootNamespace>
    <AssemblyName>FishMMO-Installer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!-- Source Paths (evaluated in static phase; MSBuildProjectDirectory is always available). -->
    <FishMMODatabaseSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../FishMMO-Database'))</FishMMODatabaseSource>
    <FishMMOSharedUtilitySource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../FishMMO-SharedUtility'))</FishMMOSharedUtilitySource>

    <!-- Stale-copy sentinel paths (project-dir subdirs written by old broken builds). -->
    <FishMMODatabaseStale>$(MSBuildProjectDirectory)/FishMMO-Database</FishMMODatabaseStale>
    <FishMMOSharedUtilityStale>$(MSBuildProjectDirectory)/FishMMO-SharedUtility</FishMMOSharedUtilityStale>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
    <ProjectReference Include="..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <ProjectReference Include="..\..\FishMMO-Auth\FishMMO-AuthShared\FishMMO-AuthShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/InstallDevelopmentCertificates.sh" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="checksums.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Shared logging configuration from FishMMO-Setup -->
    <None Include="..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>

  <!-- Clean previously copied trees (from previous builds) -->
  <Target Name="CleanCopiedSourceTrees" BeforeTargets="PrepareForBuild">
    <!-- Dest is defined here so $(OutDir) is fully resolved at execution time. -->
    <PropertyGroup>
      <FishMMODatabaseDest>$(OutDir)FishMMO-Database</FishMMODatabaseDest>
      <FishMMOSharedUtilityDest>$(OutDir)FishMMO-SharedUtility</FishMMOSharedUtilityDest>
    </PropertyGroup>
    <!-- Remove output-dir copies (incremental clean). -->
    <RemoveDir Directories="$(FishMMODatabaseDest)" Condition="Exists('$(FishMMODatabaseDest)')" />
    <RemoveDir Directories="$(FishMMOSharedUtilityDest)" Condition="Exists('$(FishMMOSharedUtilityDest)')" />
    <!-- Remove any stale copies left in the project directory by old broken builds. -->
    <RemoveDir Directories="$(FishMMODatabaseStale)" Condition="Exists('$(FishMMODatabaseStale)')" />
    <RemoveDir Directories="$(FishMMOSharedUtilityStale)" Condition="Exists('$(FishMMOSharedUtilityStale)')" />
  </Target>

  <!-- Runtime source snapshots retain the relative layout used by EF commands. -->
  <ItemGroup>
    <Content Include="$(FishMMODatabaseSource)\**\*.*"
             Link="FishMMO-Database/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Exclude="$(FishMMODatabaseSource)\**\bin\**;$(FishMMODatabaseSource)\**\obj\**;$(FishMMODatabaseSource)\**\Migrations\**;$(FishMMODatabaseSource)\.vs\**" />
    <Content Include="$(FishMMOSharedUtilitySource)\**\*.*"
             Link="FishMMO-SharedUtility/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Exclude="$(FishMMOSharedUtilitySource)\**\bin\**;$(FishMMOSharedUtilitySource)\**\obj\**;$(FishMMOSharedUtilitySource)\.vs\**" />
  </ItemGroup>

  <!-- Installer settings and templates are included in build and publish output. -->
  <ItemGroup>
    <Content Include="..\..\FishMMO-Setup\Development\appsettings.Database.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\FishMMO-Setup\Development\install-config.quickstart.json"
             Link="templates/install-config.quickstart.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\FishMMO-Setup\Development\install-config.full.json"
             Link="templates/install-config.full.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\FishMMO-Setup\Development\install-config.web.json"
             Link="templates/install-config.web.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>