<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FishMMO.Installer</RootNamespace>
    <AssemblyName>FishMMO-Installer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!-- Source Paths -->
    <FishMMODatabaseSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\FishMMO-Database'))</FishMMODatabaseSource>
    <FishMMOSharedUtilitySource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\FishMMO-SharedUtility'))</FishMMOSharedUtilitySource>

    <!-- Output Paths -->
    <FishMMODatabaseDest>$(OutputPath)FishMMO-Database</FishMMODatabaseDest>
    <FishMMOSharedUtilityDest>$(OutputPath)FishMMO-SharedUtility</FishMMOSharedUtilityDest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
    <ProjectReference Include="..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
  </ItemGroup>

  <!-- Clean previously copied trees -->
  <Target Name="CleanCopiedSourceTrees" BeforeTargets="Build">
    <RemoveDir Directories="$(FishMMODatabaseDest)" Condition="Exists('$(FishMMODatabaseDest)')" />
    <RemoveDir Directories="$(FishMMOSharedUtilityDest)" Condition="Exists('$(FishMMOSharedUtilityDest)')" />
  </Target>

  <!-- Copy FishMMO-Database -->
  <Target Name="CopyFishMMODatabase" AfterTargets="CleanCopiedSourceTrees">
    <ItemGroup>
      <FishMMODatabaseFiles Include="$(FishMMODatabaseSource)\**\*.*"
        Exclude="
          $(FishMMODatabaseSource)\**\bin\**;
          $(FishMMODatabaseSource)\**\obj\**;
          $(FishMMODatabaseSource)\.vs\**" />
    </ItemGroup>

    <Copy
      SourceFiles="@(FishMMODatabaseFiles)"
      DestinationFiles="@(FishMMODatabaseFiles->'$(FishMMODatabaseDest)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Message Text="Copied FishMMO-Database to $(FishMMODatabaseDest)" Importance="high" />
  </Target>

  <!-- Copy FishMMO-SharedUtility -->
  <Target Name="CopyFishMMOSharedUtility" AfterTargets="CopyFishMMODatabase">
    <ItemGroup>
      <FishMMOSharedUtilityFiles Include="$(FishMMOSharedUtilitySource)\**\*.*"
        Exclude="
          $(FishMMOSharedUtilitySource)\**\bin\**;
          $(FishMMOSharedUtilitySource)\**\obj\**;
          $(FishMMOSharedUtilitySource)\.vs\**" />
    </ItemGroup>

    <Copy
      SourceFiles="@(FishMMOSharedUtilityFiles)"
      DestinationFiles="@(FishMMOSharedUtilityFiles->'$(FishMMOSharedUtilityDest)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Message Text="Copied FishMMO-SharedUtility to $(FishMMOSharedUtilityDest)" Importance="high" />
  </Target>

</Project>