{
  "Npgsql": {
    "Database": "fish_mmo_postgresql",
    "Schema": "public",
    "Username": "postgres",
    "Password": "your_password_here",
    "Host": "127.0.0.1",
    "Port": "5432",
    "CommandTimeout": 10,
    "ConnectionTimeout": 15,
    "MinPoolSize": 5,
    "MaxPoolSize": 100
  },
  "Redis": {
    "Host": "127.0.0.1",
    "Port": "6379",
    "Password": ""
  },
  "RetryPolicy": {
    "MaxRetries": 3,
    "BaseDelayMs": 20,
    "MaxJitterMs": 10
  },
  "QueryPerformanceTracking": {
    "Enabled": false,
    "Level": "None",
    "SlowQueryThresholdMs": 1000,
    "SampleRate": 0.1,
    "MaxTrackedOperations": 1000
  },
  "ConnectionPoolHealth": {
    "WarningThresholdPercent": 70,
    "CriticalThresholdPercent": 85,
    "MonitoringIntervalSeconds": 60
  }
}