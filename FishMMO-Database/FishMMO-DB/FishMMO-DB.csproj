<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Intentionally targeting netstandard2.1 for Unity compatibility.
      The Microsoft.Extensions.* 9.0.4 packages are compatible with
      netstandard2.1; the version gap between netstandard2.1 and
      the 9.0.x NuGet packages is intentional and supported.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FishMMO.Database</RootNamespace>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- TODO: EF Core upgrade path (requires .NET 6+ target framework first)
       EF Core 5.0 reached end-of-life on 2022-03-09 and is no longer receiving
       security patches. This version is pinned because the project targets netstandard2.1
       (required for Unity compatibility), and EF Core 6.0+ dropped netstandard2.1 support.
       Upgrading beyond 5.0 would require retargeting to .NET 6+ and verifying Unity interop.

       Recommended upgrade path: 5.x -> 6.x (LTS) -> 8.x (LTS).
       Key breaking changes to address on each step:
         - 5.x -> 6.x: DateTime/DateTimeOffset default SQL translation changed (old behavior:
           DateTime translated as 'timestamp without time zone'; new default translates as
           'timestamp with time zone'). A ValueConverter or column type override may be needed.
           Null semantics in LINQ queries changed (C# 8 nullable reference types interact
           differently with SQL generation). Several obsolete APIs removed (e.g.
           UseRowNumberForPaging, UseTranslationFailed).
         - 6.x -> 8.x: Further null-semantics refinements. ComplexType / OwnedEntity changes.
         See: https://learn.microsoft.com/ef/core/what-is-new/ef-core-6.0/breaking-changes
              https://learn.microsoft.com/ef/core/what-is-new/ef-core-8.0/breaking-changes -->
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="5.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="5.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="5.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="5.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="5.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="5.0.10" />  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FishMMO-SharedUtility\FishMMO-SharedUtility\FishMMO-SharedUtility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="..\..\Migrations\" />
    <Compile Include="..\..\Migrations\*.cs" />
  </ItemGroup>
  <!-- Define a custom property based on the existence of the marker file -->
  <PropertyGroup>
    <IsEFBuild>false</IsEFBuild>
  </PropertyGroup>
  <PropertyGroup>
    <IsEFBuild Condition="Exists('..\..\FishMMO-Installer.exe')">true</IsEFBuild>
  </PropertyGroup>
  <!-- Move the DLL to the Unity project. -->
  <Target Name="FishMMODependencies" AfterTargets="Build" Condition="'$(IsEFBuild)' == 'false'">
    <PropertyGroup>
      <TargetDir>..\..\FishMMO-Unity\Assets\Dependencies</TargetDir>
      <BuildConfiguration>Debug</BuildConfiguration>
    </PropertyGroup>
    <!-- Conditionally set the property based on the build configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <BuildConfiguration>Release</BuildConfiguration>
    </PropertyGroup>
    <ItemGroup>
      <SourceDirWithExclusion Include="bin\$(BuildConfiguration)\**\FishMMO-DB.dll">
        <Exclude>bin\$(BuildConfiguration)\**\appsettings.json</Exclude>
      </SourceDirWithExclusion>
    </ItemGroup>
    <Copy SourceFiles="@(SourceDirWithExclusion)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>