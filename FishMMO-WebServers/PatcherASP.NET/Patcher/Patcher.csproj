<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <ProjectReference Include="..\..\FishMMO-WebShared\FishMMO-WebShared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration from FishMMO-Setup (no rename needed). -->
    <None Include="..\..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!--
    NOTE: PRODUCTION CONFIGURATION
    Only the Development config (appsettings.Patcher.json) is copied to the
    output directory by this target.  In production, configuration must be
    provided through one of these mechanisms (in order of precedence):

      1. Environment variables (e.g., ConnectionStrings__DefaultConnection,
         FISHMMO_CLIENT_GATE_SECRET, etc.) overridden via systemd unit
         Environment= directives or the container orchestrator.

      2. A mounted appsettings.json file at the expected runtime location
         (e.g., /etc/fishmmo/patcher/appsettings.json) via a volume mount
         or secret store.

    Bundling production secrets into the build output is NOT recommended.
    To add production-specific appsettings.*.json files, update this target
    or deploy a separate configuration file as described above.
  -->
  <!-- Copy-and-rename config from FishMMO-Setup/Development/ to output. -->
  <Target Name="CopyFishMMOConfig" AfterTargets="Build">
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Development\appsettings.Patcher.json"
          DestinationFiles="$(OutDir)appsettings.json"
          SkipUnchangedFiles="true" />
  </Target>
</Project>