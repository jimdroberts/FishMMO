<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- CS8618 not suppressed: all non-nullable fields are initialized in constructors or with defaults. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Ed25519 for signing the version manifest. Already a first-class dependency of this
      solution (FishMMO-AuthShared and FishMMO-Dependencies both reference it, and the Unity
      client verifies the signature with the same library), so this adds no new supply-chain
      surface. .NET 8 has no built-in Ed25519.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
    <ProjectReference Include="..\..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <ProjectReference Include="..\..\FishMMO-WebShared\FishMMO-WebShared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration from FishMMO-Setup (no rename needed). -->
    <None Include="..\..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!--
    NOTE: PRODUCTION CONFIGURATION
    Development and optional Production templates are copied to build and publish
    output by the content items below. Deployment-specific configuration can be
    provided through these mechanisms:

      1. Environment variables (e.g., ConnectionStrings__DefaultConnection,
         FISHMMO_CLIENT_GATE_SECRET, etc.) overridden via systemd unit
         Environment= directives or the container orchestrator.

      2. A mounted appsettings.json file at the expected runtime location
         (e.g., /etc/fishmmo/patcher/appsettings.json) via a volume mount
         or secret store.

    Bundling production secrets into the build output is NOT recommended.
    Keep production secrets outside the templates and provide them through the
    deployment configuration mechanisms described above.
  -->
  <!-- Copy-and-rename shared configuration for both build and publish output. -->
  <ItemGroup>
    <Content Include="..\..\..\FishMMO-Setup\Development\appsettings.Patcher.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\FishMMO-Setup\Production\appsettings.Patcher.json"
             Link="appsettings.Production.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\..\..\FishMMO-Setup\Production\appsettings.Patcher.json')" />
  </ItemGroup>
</Project>