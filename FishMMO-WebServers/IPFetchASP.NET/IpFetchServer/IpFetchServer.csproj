<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8601</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      WARNING: EF Core 5.0.17 is END-OF-LIFE (no security patches).
      Pinned because Unity's .NET Standard 2.1 runtime does not support
      EF Core 6.0+ (which requires .NET 6+).

      Mitigation options:
      1. Run IpFetchServer behind a WAF/API gateway that filters SQL attacks.
      2. Keep Npgsql updated (5.0.18 patch releases are still published).
      3. Monitor CVE databases for EF Core 5.x vulnerabilities.
      4. Long-term: migrate Unity to .NET 8+ when Unity supports it.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="5.0.17" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <ProjectReference Include="..\..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
    <ProjectReference Include="..\..\FishMMO-WebShared\FishMMO-WebShared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration from FishMMO-Setup (no rename needed). -->
    <None Include="..\..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!-- Copy-and-rename config files from FishMMO-Setup/ to output (Build + Publish). -->
  <Target Name="CopyFishMMOConfig" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_FishMMOConfigOut>$([System.String]::Copy('$(PublishDir)').TrimEnd('\').TrimEnd('/'))</_FishMMOConfigOut>
      <_FishMMOConfigOut Condition="'$(_FishMMOConfigOut)' == ''">$(OutDir)</_FishMMOConfigOut>
      <_FishMMOConfigOut Condition="'$(PublishDir)' == ''">$(OutDir)</_FishMMOConfigOut>
    </PropertyGroup>
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Development\appsettings.IpFetchServer.json"
          DestinationFiles="$(OutDir)appsettings.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Development\appsettings.IpFetchServer.Development.json"
          DestinationFiles="$(OutDir)appsettings.Development.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Production\appsettings.IpFetchServer.Production.json"
          DestinationFiles="$(OutDir)appsettings.Production.json"
          SkipUnchangedFiles="true" />
    <!-- Also land Production appsettings next to published binaries when PublishDir is set. -->
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Production\appsettings.IpFetchServer.Production.json"
          DestinationFiles="$(PublishDir)appsettings.Production.json"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>