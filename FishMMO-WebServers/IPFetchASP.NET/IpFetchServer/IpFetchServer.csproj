<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8601</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      EF Core 5.0.17 is end-of-life and should be upgraded to 8.x when the
      netstandard2.1 dependency is dropped. Pinned here for compatibility
      with FishMMO-DB (netstandard2.1).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="5.0.17" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <ProjectReference Include="..\..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
    <ProjectReference Include="..\..\FishMMO-WebShared\FishMMO-WebShared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration from FishMMO-Setup (no rename needed). -->
    <None Include="..\..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!-- Copy-and-rename config files from FishMMO-Setup/ to output. -->
  <Target Name="CopyFishMMOConfig" AfterTargets="Build">
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Development\appsettings.IpFetchServer.json"
          DestinationFiles="$(OutDir)appsettings.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Development\appsettings.IpFetchServer.Development.json"
          DestinationFiles="$(OutDir)appsettings.Development.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Production\appsettings.IpFetchServer.Production.json"
          DestinationFiles="$(OutDir)appsettings.Production.json"
          SkipUnchangedFiles="true" />
  </Target>
</Project>