<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared logging configuration from FishMMO-Setup (no rename needed). -->
    <None Include="..\..\..\FishMMO-Setup\logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>logging.json</Link>
    </None>
  </ItemGroup>
  <!-- Copy-and-rename config from FishMMO-Setup/Development/ to output. -->
  <Target Name="CopyFishMMOConfig" AfterTargets="Build">
    <Copy SourceFiles="..\..\..\FishMMO-Setup\Development\appsettings.WebGLServer.json"
          DestinationFiles="$(OutDir)appsettings.json"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
