<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FishMMO-ControlPanel</AssemblyName>
    <RootNamespace>FishMMO.ControlPanel</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\FishMMO-Auth\FishMMO-ServerAuth\FishMMO-ServerAuth.csproj" />
    <ProjectReference Include="..\..\..\FishMMO-Database\FishMMO-DB\FishMMO-DB.csproj" />
    <ProjectReference Include="..\..\..\FishMMO-Logger\FishMMO-Logger\FishMMO-Logger.csproj" />
    <ProjectReference Include="..\..\FishMMO-WebShared\FishMMO-WebShared.csproj" />
  </ItemGroup>

  <!-- Serve static files from the build output as well as published deployments. -->
  <ItemGroup>
    <Content Update="wwwroot\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy-and-rename shared configuration for both build and publish output. -->
  <ItemGroup>
    <Content Include="..\..\..\FishMMO-Setup\Development\appsettings.ControlPanel.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\FishMMO-Setup\Production\appsettings.ControlPanel.json"
             Link="appsettings.Production.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\..\..\FishMMO-Setup\Production\appsettings.ControlPanel.json')" />
  </ItemGroup>

</Project>
