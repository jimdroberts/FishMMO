# Repository-root ignores.
#
# The Unity project has its own rules in FishMMO-Unity/.gitignore; this file
# covers the solution root, the .NET projects, and the native library.

# --- OS Metadata ---
.DS_Store
Thumbs.db
*~
*.swp

# --- IDEs & Editors ---
.vscode/
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vsconfig

# --- Certificates & Secrets ---
*.pem
*.pfx
*.cert
*.key
*.secret
.env
.env.*

# Local environment overrides (may contain secrets)
appsettings.Development.json
appsettings.Production.json

# --- Build & Output (General) ---
# Each of these matches a directory of that exact name at any depth.
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]uild/
[Bb]uilds/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
msbuild.log
msbuild.err
msbuild.wrn
*.bak
Configuration.cfg

# UI profiles the Options panel writes. In the editor the client's working directory is
# the repository root, so saving one from the settings screen lands here.
UIProfiles/

# Rendered UI panel previews. Generated build output, kept out of the repo but
# deliberately durable — /tmp does not survive a reboot.
PanelRenders/

# --- .NET / NuGet ---
project.lock.json
*.pyc
nupkg/
packages/

# --- Crash dumps ---
mono_crash.*
core.[0-9]*

# --- Entity Framework ---
# Generated per project and applied locally, not shared through source control.
[Mm]igrations/

# Native WebTransport build directories and cache.
# build/ is already covered by the [Bb]uild/ rule above; the other trees are not,
# because that rule matches the exact directory name only.
# build_win_nuget/  - build_windows_nuget.ps1 (NuGet msquic, OpenSSL or Schannel)
# build_win/        - build_windows_cross.sh (Zig cross-compile)
# build_win_schannel/ - the pre-2026-09-09 name of build_win_nuget/; safe to delete
FishMMO-WebTransport/build_win_nuget/
FishMMO-WebTransport/build_win/
FishMMO-WebTransport/build_win_schannel/
FishMMO-WebTransport/openssl_cache.cmake

# Per-deployment server config, copied to the working directory to run a server.
# In the Editor, Constants.GetWorkingDirectory() resolves to this repo root, so these
# land here. The tracked source templates live under FishMMO-Setup/Development|Production/.
/LoginServer.cfg
/WorldServer.cfg
/SceneServer.cfg

# Runtime appsettings.json copied into each web server's output directory from the
# FishMMO-Setup/ templates. These hold real database credentials at runtime and must never
# be committed. Scoped to this tree on purpose: the tracked templates live at
# FishMMO-Setup/Development|Production/appsettings.json and are deliberately not matched.
FishMMO-WebServers/**/appsettings.json

# Client/server build output produced by the FishMMO Dashboard build panel.
/Builds/

# --- API Documentation (docfx) ---
# The entire docfx toolchain is intentionally local-only: the sources
# (docfx.json, toc.yml, docs/, templates/, tools/, publish.sh) are NOT tracked
# here, and neither is the generated metadata/site output. publish.sh builds the
# site and syncs it into the separate FishMMO-Website repo, which is what the
# published docs are served from.
/Documentation/

# Local clone of the gh-pages doc-hosting repo (jimdroberts/FishMMO-Website).
# Not part of this repo; publish.sh syncs built docs into it.
/FishMMO-Website/