# Repository-root ignores.
#
# The Unity project has its own rules in FishMMO-Unity/.gitignore; this file
# covers the solution root, the .NET projects, and the native library.

# --- OS Metadata ---
.DS_Store
Thumbs.db
*~
*.swp

# --- IDEs & Editors ---
.vscode/
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vsconfig

# --- Certificates & Secrets ---
*.pem
*.pfx
*.cert
*.key
*.secret
.env
.env.*

# Local environment overrides (may contain secrets)
appsettings.Development.json
appsettings.Production.json

# --- Build & Output (General) ---
# Each of these matches a directory of that exact name at any depth.
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]uild/
[Bb]uilds/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
msbuild.log
msbuild.err
msbuild.wrn
*.bak

# --- .NET / NuGet ---
project.lock.json
*.pyc
nupkg/
packages/

# --- Crash dumps ---
mono_crash.*
core.[0-9]*

# --- Entity Framework ---
# Generated per project and applied locally, not shared through source control.
[Mm]igrations/

# --- Unity ---
# Note: FishMMO-Unity/.gitignore (standard github/gitignore Unity template) already
# covers Library/, Temp/, Logs/, UserSettings/, MemoryCaptures/, etc. within the
# Unity project itself. These entries are for things that template doesn't cover.
# Build-generated: copied in by "Build all C# Projects" (see README), not source.
FishMMO-Unity/Assets/Dependencies/
FishMMO-Unity/Assets/Dependencies.meta
# Platform-specific native WebTransport binaries built locally. Per README, only the
# Linux binary is committed — Windows/macOS binaries must be built on their own platform.
FishMMO-Unity/Assets/Plugins/FishNet/Plugins/WebTransport/Plugins/windows_x86_64/
FishMMO-Unity/Assets/Plugins/FishNet/Plugins/WebTransport/Plugins/windows_x86_64.meta
FishMMO-Unity/Assets/Plugins/FishNet/Plugins/WebTransport/Plugins/mac_x86_64/
FishMMO-Unity/Assets/Plugins/FishNet/Plugins/WebTransport/Plugins/mac_x86_64.meta

# --- FishMMO build/deploy output ---
# Client/server build output produced by the FishMMO Dashboard build panel.
/Builds/
# Native WebTransport CMake build directories and cache.
FishMMO-WebTransport/build/
FishMMO-WebTransport/build_win_schannel/
FishMMO-WebTransport/openssl_cache.cmake
# Per-deployment server config copied to the deploy root at build/install time —
# the tracked source templates live under FishMMO-Setup/Development|Production/.
/LoginServer.cfg
/WorldServer.cfg
/SceneServer.cfg
# Runtime appsettings.json copied into each web server's output directory from the
# FishMMO-Setup/ templates — may contain local DB credentials.
FishMMO-WebServers/**/appsettings.json
FishMMO-CMS/**/appsettings.json

# --- API Documentation (docfx) ---
# docfx.json, toc.yml, docs/, publish.sh, etc. are tracked; only the
# generated metadata/site output is not.
/Documentation/

# Local clone of the gh-pages doc-hosting repo (jimdroberts/FishMMO-Website).
# Not part of this repo; publish.sh syncs built docs into it.
/FishMMO-Website/
